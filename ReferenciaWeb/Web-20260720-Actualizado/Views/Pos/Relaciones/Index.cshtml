@model ControlTaxiWeb.Models.PosTriton.PosRelacionesViewModel
@{
    ViewData["Title"] = "Relacion ticket-taxista";
    var ticketPagadoJson = TempData["PosDejadaTicketJson"] as string;
    ControlTaxiWeb.Models.PosTriton.PosDejadaTicketViewModel? ticketPagado = null;
    if (!string.IsNullOrWhiteSpace(ticketPagadoJson))
    {
        try
        {
            ticketPagado = System.Text.Json.JsonSerializer.Deserialize<ControlTaxiWeb.Models.PosTriton.PosDejadaTicketViewModel>(ticketPagadoJson);
        }
        catch
        {
            ticketPagado = null;
        }
    }
}

<link rel="stylesheet" href="~/css/PosTriton.css" asp-append-version="true" />
<style>
/* ===== PÁGINA PRINCIPAL ===== */
.rtt-page {
    font-family: "Segoe UI", Arial, sans-serif;
    color: #0f3057;
    background: #f0f4f8;
    min-height: 100vh;
    padding: 0;
}

/* ===== HEADER AZUL DEGRADADO ===== */
.rtt-header {
    background: linear-gradient(135deg, #1a4fc4 0%, #0d2d85 100%);
    border-radius: 14px;
    padding: 1rem 1.25rem;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    box-shadow: 0 4px 20px rgba(13, 45, 133, 0.35);
}
.rtt-header-brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
}
.rtt-header-icon {
    width: 52px;
    height: 52px;
    background: rgba(255,255,255,0.15);
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.rtt-header-icon svg {
    width: 28px; height: 28px;
    stroke: #fff; fill: none; stroke-width: 1.8;
}
.rtt-header-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.15;
}
.rtt-header-sub {
    font-size: 0.8rem;
    color: rgba(255,255,255,0.82);
    margin-top: 0.15rem;
}
</style>

<style>
/* ===== BOTONES DEL HEADER ===== */
.rtt-header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
}
.rtt-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.48rem 0.95rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.15s, filter 0.15s;
    min-height: 38px;
}
.rtt-btn:hover { transform: translateY(-1px); filter: brightness(1.07); }
.rtt-btn svg { width: 15px; height: 15px; stroke: currentColor; fill: none; stroke-width: 2; flex-shrink: 0; }
.rtt-btn-search  { background: #dce9ff; color: #0d3ea8; }
.rtt-btn-green   { background: #16a05a; color: #fff; }
.rtt-btn-outline { background: rgba(255,255,255,0.13); color: #fff; border: 1px solid rgba(255,255,255,0.35); }
.rtt-btn-nuevo   { background: #2662be; color: #fff; }
.rtt-btn-gold    { background: #f5b30e; color: #3b2200; }
.rtt-btn-menu    { background: rgba(255,255,255,0.18); color: #fff; border: 1px solid rgba(255,255,255,0.3); }
.rtt-btn-red     { background: #d93f3f; color: #fff; }

/* ===== TARJETA GENÉRICA ===== */
.rtt-card {
    background: #fff;
    border: 1px solid #dde5f0;
    border-radius: 16px;
    padding: 1.1rem 1.25rem 1.25rem;
    box-shadow: 0 2px 12px rgba(15,23,42,0.06);
    margin-bottom: 0.85rem;
}
.rtt-card-header {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1.5px solid #eef2f8;
}
.rtt-card-icon {
    width: 34px; height: 34px;
    border-radius: 10px;
    background: #eef4ff;
    color: #1a4fc4;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}
.rtt-card-icon svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 2; }
.rtt-card-header h2 {
    margin: 0;
    font-size: 0.82rem;
    font-weight: 800;
    color: #0d2d65;
    text-transform: uppercase;
    letter-spacing: 0.08em;
}
</style>

<style>
/* ===== GRID DE CAMPOS ===== */
.rtt-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.85rem;
}
.rtt-grid-2 {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.85rem;
}
.rtt-field { display: flex; flex-direction: column; gap: 0.3rem; }
.rtt-field label {
    font-size: 0.7rem;
    font-weight: 700;
    color: #2a3f5e;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}
.rtt-input-wrap {
    display: flex;
    align-items: center;
    background: #fff;
    border: 1.5px solid #cdd6e8;
    border-radius: 10px;
    padding: 0 0.75rem;
    gap: 0.5rem;
    transition: border-color 0.15s;
}
.rtt-input-wrap:focus-within { border-color: #1a4fc4; }
.rtt-input-wrap .rtt-ico {
    color: #4a7ad4;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
}
.rtt-input-wrap .rtt-ico svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.9; }
.rtt-input-wrap input,
.rtt-input-wrap select {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 0.9rem;
    color: #102940;
    padding: 0.6rem 0;
    min-width: 0;
}
.rtt-input-wrap select { cursor: pointer; }
.rtt-input-wrap input[readonly] { color: #5a6e82; }

/* Flecha decorativa para inputs que visualmente parecen dropdown */
.rtt-ico-arrow { color: #8ca3c8; margin-left: auto; }

/* Campo de búsqueda principal (ancho completo) */
.rtt-search-wrap {
    display: flex;
    align-items: center;
    background: #fff;
    border: 1.5px solid #cdd6e8;
    border-radius: 10px;
    padding: 0 1rem;
    gap: 0.6rem;
    transition: border-color 0.15s;
}
.rtt-search-wrap:focus-within { border-color: #1a4fc4; }
.rtt-search-wrap input {
    flex: 1; border: none; outline: none; background: transparent;
    font-size: 0.92rem; color: #102940; padding: 0.7rem 0;
}
.rtt-search-wrap .rtt-ico { color: #8ca3c8; }
.rtt-search-wrap .rtt-ico svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 2; }

/* Grid filtros: búsqueda ocupa toda la fila, luego fechas */
.rtt-filter-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 0.85rem;
    align-items: end;
}
.rtt-filter-grid .rtt-field-full {
    grid-column: auto;
}
</style>

<style>
/* ===== TARJETAS PASAJEROS / COBRO ===== */
.rtt-pax-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
}
.rtt-pax-card {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    background: #fff;
    border: 1.5px solid #dde5f0;
    border-radius: 14px;
    padding: 0.75rem 1.1rem;
    min-width: 100px;
    flex: 1;
}
.rtt-pax-card .pax-icon {
    width: 38px; height: 38px;
    border-radius: 10px;
    display: inline-flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}
.rtt-pax-card .pax-icon svg { width: 20px; height: 20px; stroke: currentColor; fill: none; stroke-width: 2; }
.rtt-pax-card .pax-info { display: flex; flex-direction: column; }
.rtt-pax-card .pax-label { font-size: 0.72rem; font-weight: 600; color: #5a6e82; }
.rtt-pax-card .pax-value { font-size: 1.35rem; font-weight: 800; color: #0d2d65; line-height: 1.1; }

/* Colores por tipo */
.pax-adulto  .pax-icon { background: #dbeafe; color: #1d4ed8; }
.pax-joven   .pax-icon { background: #dcfce7; color: #15803d; }
.pax-menores .pax-icon { background: #ffedd5; color: #c2410c; }
.pax-pax     .pax-icon { background: #ede9fe; color: #7c3aed; }
.pax-dejada  {
    background: #fffbeb;
    border-color: #fcd34d;
}
.pax-dejada  .pax-icon { background: #fef3c7; color: #d97706; font-size: 1.1rem; font-weight: 800; }
.pax-dejada  .pax-value { color: #92400e; font-size: 1.45rem; }

/* ===== TABLA DE VIAJES ===== */
.rtt-table-title {
    font-size: 0.8rem;
    font-weight: 800;
    color: #0d2d65;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 0.65rem;
}
.rtt-table { width: 100%; font-size: 0.82rem; border-collapse: collapse; }
.rtt-table thead th {
    background: #f0f5ff;
    color: #0d2d65;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.55rem 0.7rem;
    border-bottom: 2px solid #dde5f0;
    white-space: nowrap;
}
.rtt-table tbody tr { border-bottom: 1px solid #eef2f8; }
.rtt-table tbody tr:hover { background: #f7faff; }
.rtt-table tbody td { padding: 0.5rem 0.7rem; vertical-align: top; }
.rtt-table tbody tr.is-selected { background: #eef5ff; }

/* Pills de estado */
.status-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
}
.status-pill.paid    { background: #dcfce7; color: #166534; }
.status-pill.pending { background: #fef9c3; color: #854d0e; }
.source-pill {
    display: inline-block;
    padding: 1px 7px;
    border-radius: 999px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-bottom: 2px;
}
.app-source { background: #dbeafe; color: #1e40af; }
.pos-source { background: #f3f4f6; color: #374151; }

/* Mini botones en tabla */
.mini-action-btn {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 4px 10px; border-radius: 999px;
    font-size: 0.68rem; font-weight: 700; text-transform: uppercase;
    background: #eef4ff; color: #1d4ed8;
    border: 1px solid #bfdbfe; text-decoration: none; cursor: pointer;
    white-space: nowrap; margin: 2px 1px;
}
.mini-action-btn:hover { background: #dbeafe; }
.mini-pay-commission { background: #dcfce7; color: #166534; border-color: #bbf7d0; }
.mini-print-btn { background: #eff6ff; color: #1e40af; border-color: #bfdbfe; }
.mini-print-btn svg, .mini-action-btn svg { width: 11px; height: 11px; stroke: currentColor; fill: none; stroke-width: 2; }
.relation-edit-link {
    display: inline-flex; align-items: center; gap: 4px;
    color: #1a4fc4; font-size: 0.7rem; font-weight: 700;
    text-decoration: none; margin-top: 4px;
}
.relation-edit-link svg { width: 12px; height: 12px; stroke: currentColor; fill: none; stroke-width: 2; }
.mini-reprint-form { display: inline-flex; align-items: center; margin: 2px 0; }

/* Celdas con múltiples líneas */
.rtt-table td span { display: block; line-height: 1.4; }
.rtt-table td strong { display: block; font-weight: 700; }

/* Aviso */
.pos-notice {
    background: #fef9c3; border-left: 4px solid #facc15;
    color: #713f12; padding: 0.65rem 1rem;
    border-radius: 8px; font-size: 0.85rem;
    margin-bottom: 0.85rem;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1100px) {
    .rtt-grid-3 { grid-template-columns: repeat(2, 1fr); }
    .rtt-filter-grid { grid-template-columns: 1fr 1fr; }
    .rtt-filter-grid .rtt-field-full { grid-column: 1 / -1; }
}
@media (max-width: 700px) {
    .rtt-header { flex-direction: column; align-items: stretch; }
    .rtt-grid-3, .rtt-grid-2, .rtt-filter-grid { grid-template-columns: 1fr; }
    .rtt-filter-grid .rtt-field-full { grid-column: auto; }
    .rtt-header-actions { justify-content: center; }
    .rtt-pax-card { min-width: 80px; }
}
</style>

<div class="rtt-page">

    @* HEADER *@
    <div class="rtt-header">
        <div class="rtt-header-brand">
            <span class="rtt-header-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M3 10.5V8.5A2.5 2.5 0 0 1 5.5 6H18.5A2.5 2.5 0 0 1 21 8.5V10.5" /><path d="M21 10.5v4a2.5 2.5 0 0 1-2.5 2.5H5.5A2.5 2.5 0 0 1 3 14.5v-4" /><path d="M6.5 17.5v1.5" /><path d="M17.5 17.5v1.5" /><path d="M10 11h4" /></svg>
            </span>
            <div>
                <div class="rtt-header-title">RELACION TICKET - TAXISTA v2</div>
                <div class="rtt-header-sub">Control y asignación de tickets a taxistas</div>
            </div>
        </div>
        <div class="rtt-header-actions">
            <button form="relacion-filter-form" type="submit" class="rtt-btn rtt-btn-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M17 17l3.5 3.5" /></svg>
                BUSCAR
            </button>
            <button form="relacion-save-form" type="submit" class="rtt-btn rtt-btn-green">
                <svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8" /><path d="M3 3v5h5" /></svg>
                ACTUALIZAR
            </button>
            <button type="button" class="rtt-btn rtt-btn-outline" data-clear-relacion>
                <svg viewBox="0 0 24 24"><path d="M3 6h18" /><path d="M8 6V4h8v2" /><path d="M19 6l-1 14H6L5 6" /></svg>
                LIMPIAR
            </button>
            <a class="rtt-btn rtt-btn-nuevo" asp-action="Relaciones">
                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                NUEVO
            </a>
            <a class="rtt-btn rtt-btn-gold" asp-action="Comisiones" asp-route-folioOperacion="@Model.FolioOperacion">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v10M9 10h4.5a2.5 2.5 0 0 1 0 5H9" /></svg>
                COMISION
            </a>
            <a class="rtt-btn rtt-btn-menu" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M3 11l9-8 9 8" /><path d="M5 10v10h14V10" /><path d="M9 20v-6h6v6" /></svg>
                MENU
            </a>
            <a class="rtt-btn rtt-btn-red" asp-action="Index">
                <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
                SALIR
            </a>
        </div>
    </div>

    @if (ViewBag.PosNotice != null)
    {
        <div class="pos-notice">@ViewBag.PosNotice</div>
    }

    @* SECCIÓN: BÚSQUEDA / FILTROS *@
    <div class="rtt-card">
        <div class="rtt-card-header">
            <span class="rtt-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z" /></svg>
            </span>
            <h2>Búsqueda / Filtros</h2>
        </div>
        <form id="relacion-filter-form" method="get" asp-action="Relaciones">
            <div class="rtt-filter-grid">
                <div class="rtt-field rtt-field-full">
                    <label>Buscar App / Ticket / Taxista / Hotel / Gafete</label>
                    <div class="rtt-search-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M17 17l3.5 3.5" /></svg>
                        </span>
                        <input name="busqueda" value="@Model.Busqueda" placeholder="Buscar por nombre, ticket, taxista, hotel o gafete..." />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Fecha Inicio</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M6 2v4M18 2v4M4 8h16M5 22h14a2 2 0 0 0 2-2V8H3v12a2 2 0 0 0 2 2Z" /></svg>
                        </span>
                        <input type="date" name="fechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Fecha Fin</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M6 2v4M18 2v4M4 8h16M5 22h14a2 2 0 0 0 2-2V8H3v12a2 2 0 0 0 2 2Z" /></svg>
                        </span>
                        <input type="date" name="fechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>
            </div>
        </form>
    </div>

    @* SECCIÓN: DATOS DEL TAXISTA (fila 1: Ticket App, Folio App, Folio Operacion) *@
    <div class="rtt-card">
        <div class="rtt-card-header">
            <span class="rtt-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" /><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" /></svg>
            </span>
            <h2>Datos del Taxista</h2>
        </div>
        <form id="relacion-save-form" method="post" asp-action="GuardarRelacion">
            <input type="hidden" name="Busqueda" value="@Model.Busqueda" />
            <input type="hidden" name="FechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="Fecha" value="@Model.Fecha" />

            @* Fila 1: Ticket App, Folio App, Folio Operacion *@
            <div class="rtt-grid-3" style="margin-bottom:0.85rem">
                <div class="rtt-field">
                    <label>Ticket App otorgado</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><line x1="12" y1="12" x2="12" y2="16"/><line x1="10" y1="14" x2="14" y2="14"/></svg>
                        </span>
                        <input name="FolioControl" value="@Model.FolioControl" />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Folio App movil</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
                        </span>
                        <input name="FolioApp" value="@Model.FolioApp" readonly />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Folio operacion asignado</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><polyline points="14 2 14 8 20 8"/></svg>
                        </span>
                        <input name="FolioOperacion" value="@Model.FolioOperacion" />
                    </div>
                </div>
            </div>

            @* Fila 2: Ticket POS, Gafete, Taxista ID *@
            <div class="rtt-grid-3" style="margin-bottom:0.85rem">
                <div class="rtt-field">
                    <label>Ticket venta POS asignado</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
                        </span>
                        <input name="FolioPos" value="@Model.FolioPos" />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Gafete</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M9 7h6M9 11h6M9 15h4"/></svg>
                        </span>
                        <input name="Gafete" value="@Model.Gafete" />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Taxista ID</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <input name="TaxistaId" value="@Model.TaxistaId" />
                    </div>
                </div>
            </div>

            @* Fila 3: Nombre Taxista, Vendedores *@
            <div class="rtt-grid-2" style="margin-bottom:0.85rem">
                <div class="rtt-field">
                    <label>Nombre taxista</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <input name="TaxistaNombre" value="@Model.TaxistaNombre" />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Vendedores</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                        </span>
                        <input name="Vendedor" value="@Model.Vendedor" list="relacion-vendedores-list" placeholder="Escribe o selecciona vendedor" autocomplete="off" />
                    </div>
                </div>
            </div>

            @* Fila 4: Nacionalidad, Tipo Transporte *@
            <div class="rtt-grid-2" style="margin-bottom:0.85rem">
                <div class="rtt-field">
                    <label>Nacionalidad</label>
                    <div class="rtt-input-wrap rtt-input-wrap-arrow">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a9 9 0 0 0 0 18"/></svg>
                        </span>
                        <input name="Nacionalidad" value="@Model.Nacionalidad" />
                        <span class="rtt-ico rtt-ico-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                        </span>
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Tipo Transporte</label>
                    <div class="rtt-input-wrap rtt-input-wrap-arrow">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v9a2 2 0 0 1-2 2h-2"/><circle cx="7.5" cy="17.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
                        </span>
                        <input name="TransporteTipo" value="@Model.TransporteTipo" />
                        <span class="rtt-ico rtt-ico-arrow" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></svg>
                        </span>
                    </div>
                </div>
            </div>

            @* Fila 5: Dejada, Comisión Calculada *@
            <div class="rtt-grid-2" style="margin-bottom:0.85rem">
                <div class="rtt-field">
                    <label>Dejada</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </span>
                        <input name="Dejada" type="number" step="0.01" min="0" value="@Model.Dejada?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    </div>
                </div>
                <div class="rtt-field">
                    <label>Comision calculada</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                        </span>
                        <input value="@Model.Comision.ToString("C2")" readonly />
                    </div>
                </div>
            </div>

            @* CORRECCIÓN #1: Campo Observaciones — name/value idénticos al original *@
            <div class="rtt-grid-2">
                <div class="rtt-field" style="grid-column: 1 / -1">
                    <label>Observaciones</label>
                    <div class="rtt-input-wrap">
                        <span class="rtt-ico" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 5h16M4 9h16M7 17h10" /><path d="M4 15h1M4 19h1" /><path d="M8 11h8" /></svg>
                        </span>
                        <input name="Observaciones" value="@Model.Observaciones" />
                    </div>
                </div>
            </div>
        </form>
    </div>

    <datalist id="relacion-vendedores-list">
        @foreach (var vendedor in Model.Vendedores)
        {
            <option value="@vendedor"></option>
        }
    </datalist>

    @* SECCIÓN: PASAJEROS / COBRO *@
    <div class="rtt-card">
        <div class="rtt-card-header">
            <span class="rtt-card-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <h2>Pasajeros / Cobro</h2>
        </div>
        <div class="rtt-pax-grid">
            <div class="rtt-pax-card pax-adulto">
                <span class="pax-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <div class="pax-info">
                    <span class="pax-label">Adulto</span>
                    <span class="pax-value">@(Model.Pax > 0 ? Model.Pax.ToString() : "0")</span>
                </div>
            </div>
            <div class="rtt-pax-card pax-joven">
                <span class="pax-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </span>
                <div class="pax-info">
                    <span class="pax-label">Joven</span>
                    <span class="pax-value">0</span>
                </div>
            </div>
            <div class="rtt-pax-card pax-menores">
                <span class="pax-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                </span>
                <div class="pax-info">
                    <span class="pax-label">Menores</span>
                    <span class="pax-value">0</span>
                </div>
            </div>
            <div class="rtt-pax-card pax-pax">
                <span class="pax-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </span>
                <div class="pax-info">
                    <span class="pax-label">PAX</span>
                    <span class="pax-value">@(Model.Pax > 0 ? Model.Pax.ToString() : "0")</span>
                </div>
            </div>
            <div class="rtt-pax-card pax-dejada">
                <span class="pax-icon" aria-hidden="true">$</span>
                <div class="pax-info">
                    <span class="pax-label">Dejada</span>
                    <span class="pax-value">@((Model.Dejada ?? 0).ToString("C2"))</span>
                </div>
            </div>
        </div>
    </div>

    @* SECCIÓN: TABLA DE VIAJES *@
    <div class="rtt-card">
        <div class="rtt-table-title">VIAJES RECIBIDOS DESDE LA APP MOVIL</div>
        <div style="overflow-x:auto">
        <table class="rtt-table table table-sm table-bordered classic-grid relation-grid">
            <thead>
                <tr>
                    <th>App / asignado</th>
                    <th>Fecha</th>
                    <th>Viaje</th>
                    <th>Taxista</th>
                    <th>Nacionalidad</th>
                    <th>Unidad</th>
                    <th>Importes</th>
                    <th>Forma de pago</th>
                    <th>Pago dejada</th>
                    <th>Comision</th>
                    <th>Accion</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Relaciones)
                {
                    var folioControl = (row.FolioControl ?? string.Empty).Trim();
                    var folioApp = (row.FolioApp ?? string.Empty).Trim();
                    var mostrarDosFoliosApp = !string.IsNullOrWhiteSpace(folioApp)
                        && !string.Equals(folioControl, folioApp, StringComparison.OrdinalIgnoreCase);
                    var folioOperacionVisible = new[] { row.FolioOperacion, row.FolioOperacionSugerido, row.FolioControl, row.FolioApp }
                        .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;
                    var ticketPosVisible = new[] { row.FolioPos, row.FolioPosSugerido }
                        .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;
                    var folioComision = new[] { row.FolioOperacion, row.FolioOperacionSugerido, row.FolioApp, row.FolioControl, row.FolioPos, row.FolioPosSugerido }
                        .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;
                    var primerTicketPos = ticketPosVisible
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .FirstOrDefault() ?? string.Empty;
                    var primerTicketPago = (row.TicketPagoDejada ?? string.Empty)
                        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .FirstOrDefault() ?? string.Empty;
                    var ticketsPosVisibles = ticketPosVisible
                        .Split(new[] { ',', ';', '/', '|' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    var gafetesVisibles = (row.Gafete ?? string.Empty)
                        .Split(new[] { ',', ';', '/', '|' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    var folioVenta = new[] {
                            primerTicketPos,
                            primerTicketPago
                        }
                        .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;
                    var puedePagarComision = !string.IsNullOrWhiteSpace(folioComision)
                        && row.Comision > 0m
                        && row.Pago < row.Comision;
                    var dejadaEstaPagada = string.Equals(row.EstatusDejada, "pagado", StringComparison.OrdinalIgnoreCase)
                        || row.DejadaPagada > 0m;
                    var importeDejadaPagada = row.DejadaPagada > 0m ? row.DejadaPagada : row.Dejada;
                    <tr class="relation-row-selectable"
                        data-folio-control="@row.FolioControl"
                        data-folio-app="@row.FolioApp"
                        data-folio-operacion="@folioOperacionVisible"
                        data-folio-pos="@ticketPosVisible"
                        data-fecha="@row.Fecha"
                        data-gafete="@row.Gafete"
                        data-nacionalidad="@row.Nacionalidad"
                        data-taxista-id="@row.TaxistaId"
                        data-taxista-nombre="@row.TaxistaNombre"
                        data-vendedor="@row.VendedorAsignado"
                        data-transporte="@row.TransporteTipo"
                        data-dejada="@row.Dejada.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                        data-observaciones="@row.Observaciones">
                        <td class="relation-id-cell">
                            <span class="source-pill @(row.Fuente.Contains("APP", StringComparison.OrdinalIgnoreCase) ? "app-source" : "pos-source")">@(!string.IsNullOrWhiteSpace(row.Fuente) ? row.Fuente : "SISTEMA/POS")</span>
                            <span>Usuario origen: @(!string.IsNullOrWhiteSpace(row.UsuarioOrigen) ? row.UsuarioOrigen : "SIN USUARIO")</span>
                             @if (mostrarDosFoliosApp)
                             {
                                 <span>Movil <a asp-action="Relaciones" asp-route-busqueda="@row.FolioApp" asp-route-fechaInicio="@Model.FechaInicio?.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin?.ToString("yyyy-MM-dd")">@row.FolioApp</a></span>
                             }
                             <strong>
                                 @if (!string.IsNullOrWhiteSpace(folioOperacionVisible))
                                 {
                                     <a asp-action="Relaciones" asp-route-busqueda="@folioOperacionVisible" asp-route-fechaInicio="@Model.FechaInicio?.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin?.ToString("yyyy-MM-dd")">@folioOperacionVisible</a>
                                 }
                                 else
                                 {
                                     @:SIN OPERACION
                                 }
                             </strong>
                             <span>
                                 @if (ticketsPosVisibles.Count > 0)
                                 {
                                     @for (var ticketIndex = 0; ticketIndex < ticketsPosVisibles.Count; ticketIndex++)
                                     {
                                         var ticketPos = ticketsPosVisibles[ticketIndex];
                                         <a asp-action="RemisionDetalle" asp-route-folio="@ticketPos" asp-route-productoBusqueda="@ticketPos">@ticketPos</a>
                                         if (ticketIndex < ticketsPosVisibles.Count - 1)
                                         {
                                             @:,
                                         }
                                     }
                                 }
                                 else
                                 {
                                     @:SIN TICKET POS
                                 }
                             </span>
                             <a href="#relacion-save-form" class="relation-edit-link" data-relacion-edit>
                                 <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                                 <span>EDITAR</span>
                             </a>
                         </td>
                        <td class="relation-date-cell">@row.Fecha</td>
                        <td class="relation-actions-cell">
                            <strong>
                                @if (!string.IsNullOrWhiteSpace(row.Hotel))
                                {
                                    <a asp-action="Relaciones" asp-route-busqueda="@row.Hotel" asp-route-fechaInicio="@Model.FechaInicio?.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin?.ToString("yyyy-MM-dd")">@row.Hotel</a>
                                }
                                else
                                {
                                    @:SIN HOTEL
                                }
                            </strong>
                            @if (!string.IsNullOrWhiteSpace(row.Origen) || !string.IsNullOrWhiteSpace(row.Sitio) || !string.IsNullOrWhiteSpace(row.Destino))
                            {
                                <span>@string.Join(" / ", new[] { row.Origen, row.Sitio, row.Destino }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.Unidad) || !string.IsNullOrWhiteSpace(row.Placas) || !string.IsNullOrWhiteSpace(row.Telefono))
                            {
                                <span>@string.Join(" / ", new[] { row.Unidad, row.Placas, row.Telefono }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                            }
                        </td>
                        <td class="relation-person-cell">
                             <strong>
                                 @if (!string.IsNullOrWhiteSpace(row.TaxistaNombre))
                                 {
                                     <a asp-action="Relaciones" asp-route-busqueda="@row.TaxistaNombre" asp-route-fechaInicio="@Model.FechaInicio?.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin?.ToString("yyyy-MM-dd")">@row.TaxistaNombre</a>
                                 }
                                 else
                                 {
                                     @(row.TaxistaId == 0 ? "SIN ID" : row.TaxistaId.ToString())
                                 }
                             </strong>
                             @if (row.TaxistaId != 0)
                             {
                                 <span>ID: @row.TaxistaId</span>
                             }
                             <span>
                                 Gafete:
                                 @if (gafetesVisibles.Count == 0)
                                 {
                                     @: SIN GAFETE
                                 }
                                 else
                                 {
                                     @for (var gafeteIndex = 0; gafeteIndex < gafetesVisibles.Count; gafeteIndex++)
                                     {
                                         var gafete = gafetesVisibles[gafeteIndex];
                                         <a asp-action="Relaciones" asp-route-busqueda="@gafete" asp-route-fechaInicio="@Model.FechaInicio?.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin?.ToString("yyyy-MM-dd")">@gafete</a>
                                         if (gafeteIndex < gafetesVisibles.Count - 1)
                                         {
                                             @:,
                                         }
                                     }
                                 }
                             </span>
                         </td>
                        <td class="relation-nationality-cell">@(string.IsNullOrWhiteSpace(row.Nacionalidad) ? "NO CAPTURADA" : row.Nacionalidad)</td>
                        <td>
                            <strong>@(string.IsNullOrWhiteSpace(row.TransporteTipo) ? "SIN TRANSPORTE" : row.TransporteTipo)</strong>
                            @if (!string.IsNullOrWhiteSpace(row.Unidad) || !string.IsNullOrWhiteSpace(row.Placas))
                            {
                                <span>@string.Join(" / ", new[] { row.Unidad, row.Placas }.Where(x => !string.IsNullOrWhiteSpace(x)))</span>
                            }
                        </td>
                        <td class="relation-money-cell">
                            <span>Venta: <strong>@row.Venta.ToString("C2")</strong></span>
                            <span>Dejada: <strong>@row.Dejada.ToString("C2")</strong></span>
                            <span>Comision: <strong>@row.Comision.ToString("C2")</strong></span>
                            <span>Pago: <strong>@row.Pago.ToString("C2")</strong></span>
                        </td>
                        <td class="relation-payment-method-cell">
                            @(string.IsNullOrWhiteSpace(row.FormaPago) ? "SIN PAGO POS" : row.FormaPago)
                        </td>
                        <td class="relation-payment-cell">
                            @if (dejadaEstaPagada)
                            {
                                <strong class="status-pill paid">PAGADO</strong>
                            }
                            else if (row.Dejada <= 0 && row.DejadaPagada <= 0)
                            {
                                <strong class="status-pill pending">SIN IMPORTE</strong>
                            }
                            else
                            {
                                <strong class="status-pill pending">PENDIENTE</strong>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.TicketPagoDejada))
                            {
                                <span>Ticket: @row.TicketPagoDejada</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.UsuarioPagoDejada))
                            {
                                <span>Usuario: @row.UsuarioPagoDejada</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(row.FechaPagoDejada))
                            {
                                <span>Fecha: @row.FechaPagoDejada</span>
                            }
                            @if (dejadaEstaPagada && importeDejadaPagada > 0)
                            {
                                <span>Pagado: @importeDejadaPagada.ToString("C2")</span>
                            }
                        </td>
                        <td class="relation-commission-cell">
                            @if (row.Comision > 0m && row.Pago >= row.Comision)
                            {
                                <strong class="status-pill paid">PAGADA</strong>
                                <span>@row.Pago.ToString("C2")</span>
                            }
                            else if (puedePagarComision)
                            {
                                <strong class="status-pill pending">PENDIENTE</strong>
                                <span>@row.Comision.ToString("C2")</span>
                                <form method="post" asp-action="PagarComision">
                                    <input type="hidden" name="folioOperacion" value="@folioComision" />
                                    <input type="hidden" name="fechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="fechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="regreso" value="Relaciones" />
                                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                    <button type="submit" class="mini-action-btn mini-pay-commission">PAGAR COMISION</button>
                                </form>
                            }
                            else if (!string.IsNullOrWhiteSpace(folioComision))
                            {
                                <strong class="status-pill pending">SIN CALCULAR</strong>
                                <form method="post" asp-action="CalcularComisiones">
                                    <input type="hidden" name="folioOperacion" value="@folioComision" />
                                    <input type="hidden" name="fechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="fechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="regreso" value="Relaciones" />
                                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                    <button type="submit" class="mini-action-btn">CALCULAR</button>
                                </form>
                            }
                            else
                            {
                                <strong class="status-pill pending">SIN FOLIO</strong>
                            }
                        </td>
                        <td class="relation-actions-cell">
                            @if (!string.IsNullOrWhiteSpace(folioVenta))
                            {
                                <a class="mini-action-btn" asp-action="RemisionDetalle" asp-route-folio="@folioVenta" asp-route-productoBusqueda="@folioVenta">VENTA</a>
                            }
                            @if (dejadaEstaPagada)
                            {
                                <form method="post" asp-action="ReimprimirTicketDejada" class="mini-reprint-form" target="_blank">
                                    <input type="hidden" name="Ticket" value="@row.TicketPagoDejada" />
                                    <input type="hidden" name="FolioApp" value="@row.FolioApp" />
                                    <input type="hidden" name="FolioControl" value="@row.FolioControl" />
                                    <input type="hidden" name="FolioOperacion" value="@folioOperacionVisible" />
                                    <input type="hidden" name="FolioPos" value="@ticketPosVisible" />
                                    <input type="hidden" name="FechaViaje" value="@row.Fecha" />
                                    <input type="hidden" name="FechaPago" value="@row.FechaPagoDejada" />
                                    <input type="hidden" name="Taxista" value="@row.TaxistaNombre" />
                                    <input type="hidden" name="Gafete" value="@row.Gafete" />
                                    <input type="hidden" name="Unidad" value="@row.Unidad" />
                                    <input type="hidden" name="Placas" value="@row.Placas" />
                                    <input type="hidden" name="Destino" value="@row.Destino" />
                                    <input type="hidden" name="Telefono" value="@row.Telefono" />
                                    <input type="hidden" name="Nacionalidad" value="@row.Nacionalidad" />
                                    <input type="hidden" name="Transporte" value="@row.TransporteTipo" />
                                    <input type="hidden" name="Vendedor" value="@row.VendedorAsignado" />
                                    <input type="hidden" name="Hotel" value="@row.Hotel" />
                                    <input type="hidden" name="Pax" value="@row.Pax" />
                                    <input type="hidden" name="Importe" value="@importeDejadaPagada.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="Usuario" value="@row.UsuarioPagoDejada" />
                                    <input type="hidden" name="Estatus" value="@row.EstatusDejada" />
                                    <input type="hidden" name="Busqueda" value="@Model.Busqueda" />
                                    <input type="hidden" name="FechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="FechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="mini-action-btn mini-print-btn" title="Reimprimir ticket" aria-label="Reimprimir ticket">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 8V3h10v5" /><path d="M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2" /><path d="M7 13h10v8H7z" /><path d="M9 17h6" /></svg>
                                        <span>IMPRIMIR</span>
                                    </button>
                                </form>
                            }
                            else if (row.PuedePagarDejada)
                            {
                                <form method="post" asp-action="PagarDejada" target="_blank">
                                    <input type="hidden" name="folioControl" value="@row.FolioControl" />
                                    <input type="hidden" name="folioApp" value="@row.FolioApp" />
                                    <input type="hidden" name="folioOperacion" value="@folioOperacionVisible" />
                                    <input type="hidden" name="folioPos" value="@ticketPosVisible" />
                                    <input type="hidden" name="taxista" value="@row.TaxistaNombre" />
                                    <input type="hidden" name="gafete" value="@row.Gafete" />
                                    <input type="hidden" name="nacionalidad" value="@row.Nacionalidad" />
                                    <input type="hidden" name="transporte" value="@row.TransporteTipo" />
                                    <input type="hidden" name="hotel" value="@row.Hotel" />
                                    <input type="hidden" name="unidad" value="@row.Unidad" />
                                    <input type="hidden" name="placas" value="@row.Placas" />
                                    <input type="hidden" name="destino" value="@row.Destino" />
                                    <input type="hidden" name="telefono" value="@row.Telefono" />
                                    <input type="hidden" name="pax" value="@row.Pax" />
                                    <input type="hidden" name="importe" value="@row.Dejada.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                                    <input type="hidden" name="vendedor" value="@row.VendedorAsignado" />
                                    <input type="hidden" name="fechaViaje" value="@row.Fecha" />
                                    <input type="hidden" name="busqueda" value="@Model.Busqueda" />
                                    <input type="hidden" name="fechaInicio" value="@Model.FechaInicio?.ToString("yyyy-MM-dd")" />
                                    <input type="hidden" name="fechaFin" value="@Model.FechaFin?.ToString("yyyy-MM-dd")" />
                                    <button type="submit" class="mini-action-btn">PAGAR</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (Model.Relaciones.Count == 0)
                {
                    var tieneFiltro = !string.IsNullOrWhiteSpace(Model.Busqueda) || Model.FechaInicio.HasValue || Model.FechaFin.HasValue;
                    <tr><td colspan="10">@(tieneFiltro ? "NO HAY VIAJES PARA ESE FILTRO" : "NO HAY VIAJES DEL DIA")</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>

</div>@* /rtt-page *@

@if (ticketPagado != null)
{
    <form id="dejada-ticket-auto-open-form" method="post" asp-action="ReimprimirTicketDejada" target="_blank" style="display:none">
        <input type="hidden" name="Ticket" value="@ticketPagado.Ticket" />
        <input type="hidden" name="FolioApp" value="@ticketPagado.FolioApp" />
        <input type="hidden" name="FolioControl" value="@ticketPagado.FolioControl" />
        <input type="hidden" name="FolioOperacion" value="@ticketPagado.FolioOperacion" />
        <input type="hidden" name="FolioPos" value="@ticketPagado.FolioPos" />
        <input type="hidden" name="FechaViaje" value="@ticketPagado.FechaViaje" />
        <input type="hidden" name="FechaPago" value="@ticketPagado.FechaPago" />
        <input type="hidden" name="Taxista" value="@ticketPagado.Taxista" />
        <input type="hidden" name="Gafete" value="@ticketPagado.Gafete" />
        <input type="hidden" name="Unidad" value="@ticketPagado.Unidad" />
        <input type="hidden" name="Placas" value="@ticketPagado.Placas" />
        <input type="hidden" name="Destino" value="@ticketPagado.Destino" />
        <input type="hidden" name="Telefono" value="@ticketPagado.Telefono" />
        <input type="hidden" name="Nacionalidad" value="@ticketPagado.Nacionalidad" />
        <input type="hidden" name="Transporte" value="@ticketPagado.Transporte" />
        <input type="hidden" name="Vendedor" value="@ticketPagado.Vendedor" />
        <input type="hidden" name="Hotel" value="@ticketPagado.Hotel" />
        <input type="hidden" name="Pax" value="@ticketPagado.Pax" />
        <input type="hidden" name="Importe" value="@ticketPagado.Importe.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <input type="hidden" name="Usuario" value="@ticketPagado.Usuario" />
        <input type="hidden" name="Estatus" value="@ticketPagado.Estatus" />
        <input type="hidden" name="Busqueda" value="@ticketPagado.Busqueda" />
        <input type="hidden" name="FechaInicio" value="@ticketPagado.FechaInicio?.ToString("yyyy-MM-dd")" />
        <input type="hidden" name="FechaFin" value="@ticketPagado.FechaFin?.ToString("yyyy-MM-dd")" />
    </form>
}

<script>
    (() => {
        window.addEventListener('storage', (event) => {
            if (event.key !== 'control-taxi-dejada-pagada' || !event.newValue) {
                return;
            }

            try {
                const payment = JSON.parse(event.newValue);
                if (payment.refreshUrl) {
                    window.location.href = payment.refreshUrl;
                }
            } catch (error) {
                window.location.reload();
            }
        });

        const rows = document.querySelectorAll('.relation-row-selectable');
        const form = document.getElementById('relacion-save-form');
        const filterForm = document.getElementById('relacion-filter-form');
        const clearButton = document.querySelector('[data-clear-relacion]');
        if (!form) {
            return;
        }

        const inputs = {
            FolioControl: form.querySelector('[name="FolioControl"]'),
            FolioApp: form.querySelector('[name="FolioApp"]'),
            FolioOperacion: form.querySelector('[name="FolioOperacion"]'),
            FolioPos: form.querySelector('[name="FolioPos"]'),
            Fecha: form.querySelector('[name="Fecha"]'),
            Gafete: form.querySelector('[name="Gafete"]'),
            Nacionalidad: form.querySelector('[name="Nacionalidad"]'),
            TaxistaId: form.querySelector('[name="TaxistaId"]'),
            TaxistaNombre: form.querySelector('[name="TaxistaNombre"]'),
            Vendedor: form.querySelector('[name="Vendedor"]'),
            TransporteTipo: form.querySelector('[name="TransporteTipo"]'),
            Dejada: form.querySelector('[name="Dejada"]'),
            Observaciones: form.querySelector('[name="Observaciones"]')
        };

        const clearForms = () => {
            rows.forEach((item) => item.classList.remove('is-selected'));
            Object.values(inputs).forEach((input) => {
                if (!input) return;
                input.value = input.name === 'TaxistaId' ? '0' : '';
            });
            form.querySelectorAll('input').forEach((input) => {
                if (input.readOnly) input.value = '';
            });
            filterForm?.querySelectorAll('input').forEach((input) => {
                input.value = '';
            });
        };

        clearButton?.addEventListener('click', () => {
            clearForms();
            window.location.href = '@Url.Action("Relaciones")';
        });

        if (rows.length === 0) {
            return;
        }

        const fillForm = (row) => {
            rows.forEach((item) => item.classList.remove('is-selected'));
            row.classList.add('is-selected');
            if (inputs.FolioControl) inputs.FolioControl.value = row.dataset.folioControl || '';
            if (inputs.FolioApp) inputs.FolioApp.value = row.dataset.folioApp || '';
            if (inputs.FolioOperacion) inputs.FolioOperacion.value = row.dataset.folioOperacion || '';
            if (inputs.FolioPos) inputs.FolioPos.value = row.dataset.folioPos || '';
            if (inputs.Fecha) inputs.Fecha.value = row.dataset.fecha || '';
            if (inputs.Gafete) inputs.Gafete.value = row.dataset.gafete || '';
            if (inputs.Nacionalidad) inputs.Nacionalidad.value = row.dataset.nacionalidad || '';
            if (inputs.TaxistaId) inputs.TaxistaId.value = row.dataset.taxistaId || '';
            if (inputs.TaxistaNombre) inputs.TaxistaNombre.value = row.dataset.taxistaNombre || '';
            if (inputs.Vendedor) inputs.Vendedor.value = row.dataset.vendedor || '';
            if (inputs.TransporteTipo) inputs.TransporteTipo.value = row.dataset.transporte || '';
            if (inputs.Dejada) inputs.Dejada.value = row.dataset.dejada || '';
            if (inputs.Observaciones) inputs.Observaciones.value = row.dataset.observaciones || '';
        };

        const focusGafete = () => {
            if (!inputs.Gafete) {
                return;
            }

            inputs.Gafete.focus();
            inputs.Gafete.select();
        };

        rows.forEach((row) => {
            row.addEventListener('click', (event) => {
                if (event.target.closest('a, button, form')) {
                    return;
                }

                fillForm(row);
                focusGafete();
            });
        });

        document.querySelectorAll('[data-relacion-edit]').forEach((link) => {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const row = link.closest('.relation-row-selectable');
                if (row) {
                    fillForm(row);
                    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    focusGafete();
                }
            });
        });
    })();
</script>

@if (ticketPagado != null)
{
    <script>
        (() => {
            const form = document.getElementById('dejada-ticket-auto-open-form');
            const ok = document.getElementById('sweet-alert-ok');
            let opened = false;
            const openTicket = () => {
                if (opened || !form) {
                    return;
                }

                opened = true;
                form.submit();
            };

            if (ok) {
                ok.addEventListener('click', () => window.setTimeout(openTicket, 150));
            } else {
                window.setTimeout(openTicket, 800);
            }
        })();
    </script>
}
