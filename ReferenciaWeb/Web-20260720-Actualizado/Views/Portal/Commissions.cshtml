@model ControlTaxiWeb.Models.CommissionsPageViewModel
@{
    ViewData["Title"] = "Comisiones";
}

<div class="page-shell">
    <div class="hero-card">
        <div>
            <p class="eyebrow">@Model.Database</p>
            <h1>Comisiones</h1>
            <p>Seguimiento de ventas base y monto de comision segun la informacion historica.</p>
        </div>
    </div>

    <div class="section-card">
        <form method="get" class="filters-grid">
            <input type="hidden" name="database" value="@Model.Database" />
            <div>
                <label class="input-label">Buscar</label>
                <input type="text" name="query" value="@Model.Query" class="text-input" placeholder="Folio, beneficiario o vendedor" />
            </div>
            <div class="button-stack">
                <button type="submit" class="primary-button">Filtrar</button>
            </div>
        </form>
    </div>

    <div class="section-card">
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Fecha</th>
                        <th>Beneficiario</th>
                        <th>Vendedor</th>
                        <th>Base</th>
                        <th>Comision</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.Commissions)
                {
                    <tr>
                        <td>@item.Folio</td>
                        <td>@(item.SaleDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                        <td>@item.BeneficiaryName</td>
                        <td>@item.SellerName</td>
                        <td>@item.BaseAmount.ToString("C")</td>
                        <td>@item.CommissionAmount.ToString("C")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
