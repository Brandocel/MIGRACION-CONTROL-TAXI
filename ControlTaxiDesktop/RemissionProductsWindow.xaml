<Window x:Class="ControlTaxiDesktop.RemissionProductsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PRODUCTOS DE REMISION"
        Width="860"
        Height="520"
        WindowStartupLocation="CenterOwner"
        Background="#DDECF7">
  <Border Margin="18" Background="#E6F3FC" BorderBrush="#9DB8D3" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Border Background="#FAF8F8" BorderBrush="#B6C8DA" BorderThickness="0,0,0,1">
        <TextBlock Text="PRODUCTOS DE REMISION" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#304A65"/>
      </Border>
      <Border Grid.Row="1" Margin="12" Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1">
        <DataGrid x:Name="LinesGrid" IsReadOnly="True" AutoGenerateColumns="False">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Cantidad" Binding="{Binding Quantity}" Width="90"/>
            <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="*"/>
            <DataGridTextColumn Header="Departamento" Binding="{Binding ProductCode}" Width="160"/>
            <DataGridTextColumn Header="Precio" Binding="{Binding UnitPrice, StringFormat=C2}" Width="120"/>
            <DataGridTextColumn Header="Importe" Binding="{Binding Total, StringFormat=C2}" Width="120"/>
          </DataGrid.Columns>
        </DataGrid>
      </Border>
      <Button Grid.Row="2" Content="VOLVER" Style="{StaticResource WebActionButton}" Width="130" Height="38" HorizontalAlignment="Left" Margin="12,0,0,12" Click="Close_Click"/>
    </Grid>
  </Border>
</Window>
