<Window x:Class="ControlTaxiDesktop.WebDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Taxi"
        Width="430"
        Height="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">
  <Border Background="#AA132238" Padding="18">
    <Border Background="#FFFDF9" CornerRadius="22" BorderBrush="#E8DCC8" BorderThickness="1" Padding="24">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Width="54" Height="54" CornerRadius="27" Background="#EEF4FB" HorizontalAlignment="Center" Margin="0,0,0,12">
          <TextBlock x:Name="IconText" Text="!" FontSize="30" FontWeight="Black" Foreground="#B48329" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Row="1">
          <TextBlock x:Name="TitleText" Text="Control Taxi" FontSize="18" FontWeight="Black" TextAlignment="Center" Foreground="#132238" Margin="0,0,0,8"/>
          <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" Foreground="#526A83" FontSize="13"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button x:Name="CancelButtonElement" Content="CANCELAR" Width="130" Height="36" Margin="0,0,12,0" Style="{StaticResource WebActionButton}" Click="Cancel_Click" Visibility="Collapsed"/>
          <Button x:Name="OkButtonElement" Content="ACEPTAR" Width="130" Height="36" HorizontalAlignment="Center" Style="{StaticResource WebActionSaveButton}" Click="Ok_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Border>
</Window>
