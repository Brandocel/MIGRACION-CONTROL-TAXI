<Window x:Class="ControlTaxiDesktop.CommissionSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ControlTaxiDesktop.Behaviors"
        Title="Control Taxi · Configuración de comisiones"
        Width="1360"
        Height="780"
        MinWidth="1024"
        MinHeight="620"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#DDECF7"
        PreviewKeyDown="Window_PreviewKeyDown">
  <!--
    Esta pantalla usa el mismo diccionario de estilos que la pantalla de Comisiones
    (Styles/SharedFilterStyles.xaml): encabezado cuadrado con iconos de linea, tira de
    totales, tarjeta de filtros, tabla azul y chips de accion. Antes tenia su propio juego
    de estilos redondeados, botones de ventana falsos y controles con el cromo gris de
    Windows, por eso las dos pantallas no se parecian.
  -->
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SharedFilterStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Encabezado: icono + titulo a la izquierda, acciones a la derecha, igual que
         Comisiones. Los botones de ventana falsos (_ □ X) se quitaron: la ventana ya trae
         los de Windows y estaban duplicados. -->
    <Border Grid.Row="0" Style="{StaticResource SquareHeaderCard}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <Border Style="{StaticResource SquareHeaderIconTile}">
            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconDollar}" Stroke="White" Width="21" Height="21"/>
          </Border>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="CONFIGURACIÓN DE COMISIONES" FontSize="16" FontWeight="Black" Foreground="White"/>
            <TextBlock Text="Porcentajes, retenciones, vigencias y reglas sin recompilar el sistema" FontSize="11" Foreground="#BBD3F8" Margin="0,3,0,0"/>
          </StackPanel>
        </StackPanel>
        <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="QuickCommissionButton" Content="CAMBIAR COMISIÓN" ToolTip="Cambio rapido: nueva comision, vigencia y motivo. Nada tecnico." Style="{StaticResource SquareToolbarGoldButton}" Click="QuickCommission_Click"/>
          <Button x:Name="NewRuleButton" Content="NUEVA REGLA" ToolTip="Crea una nueva regla de comision o una nueva vigencia." Style="{StaticResource SquareToolbarButton}" Click="NewRule_Click"/>
          <Button x:Name="EditRuleButton" Content="EDITAR" ToolTip="Carga la regla seleccionada en el formulario de edicion." Style="{StaticResource SquareToolbarGhostButton}" Click="EditSelectedRule_Click"/>
          <Button Content="PROBAR" ToolTip="Calcula una comision de prueba sin guardar una venta." Style="{StaticResource SquareToolbarGhostButton}" Click="SimulateSelectedRule_Click"/>
          <Button Content="HISTORIAL" ToolTip="Abre la pestaña de historial y auditoria." Style="{StaticResource SquareToolbarGhostButton}" Click="ViewHistory_Click"/>
          <Button Content="EXCEL" ToolTip="Exporta el catalogo de reglas para revision." Style="{StaticResource SquareToolbarGhostButton}" Click="ExportExcel_Click"/>
          <Button Content="CSV" ToolTip="Exportacion tecnica para administracion o soporte." Style="{StaticResource SquareToolbarGhostButton}" Click="Export_Click"/>
          <Button x:Name="RetireTestRuleButton" Content="RETIRAR PRUEBA" ToolTip="Desactiva solo la regla aislada PRUEBA PREPUBLICACION y deja auditoria." Style="{StaticResource SquareToolbarGhostButton}" Click="RetireTestRule_Click"/>
          <Button Content="SALIR" ToolTip="Cerrar la configuracion." Style="{StaticResource SquareToolbarDangerButton}" Click="Close_Click"/>
        </WrapPanel>
      </Grid>
    </Border>

    <!-- Tira de totales: una sola tarjeta con separadores y franja de color, en vez de cinco
         tarjetas redondeadas sueltas. Cada celda sigue siendo un filtro con un clic. -->
    <Border Grid.Row="1" Style="{StaticResource SquareStatCard}">
      <UniformGrid Columns="5">
        <Border Style="{StaticResource SquareStatCell}" BorderThickness="0" Background="#FFFFFF" Tag="ACTIVOS" Cursor="Hand" MouseLeftButtonUp="SummaryCard_Click" ToolTip="Mostrar solo reglas activas.">
          <StackPanel>
            <Border Style="{StaticResource SquareStatAccent}" Background="#1E5FD0"/>
            <TextBlock Text="REGLAS ACTIVAS" Style="{StaticResource SquareStatLabel}"/>
            <TextBlock x:Name="ActiveRulesCard" Text="0" Style="{StaticResource SquareStatValue}"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SquareStatCell}" Background="#FFFFFF" Tag="TRANSPORTE" Cursor="Hand" MouseLeftButtonUp="SummaryCard_Click" ToolTip="Filtrar reglas de transportes.">
          <StackPanel>
            <Border Style="{StaticResource SquareStatAccent}" Background="#0F8F83"/>
            <TextBlock Text="TRANSPORTES" Style="{StaticResource SquareStatLabel}"/>
            <TextBlock x:Name="TransportRulesCard" Text="0" Style="{StaticResource SquareStatValue}" Foreground="#0F8F83"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SquareStatCell}" Background="#FFFFFF" Tag="FALLBACK" Cursor="Hand" MouseLeftButtonUp="SummaryCard_Click" ToolTip="Ver reglas o diagnosticos que usan valores de respaldo.">
          <StackPanel>
            <Border Style="{StaticResource SquareStatAccent}" Background="#E0A106"/>
            <TextBlock Text="USANDO FALLBACK" Style="{StaticResource SquareStatLabel}"/>
            <TextBlock x:Name="FallbackRulesCard" Text="0" Style="{StaticResource SquareStatValue}" Foreground="#9A6F13"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SquareStatCell}" Background="#FFFFFF" Tag="POR_VENCER" Cursor="Hand" MouseLeftButtonUp="SummaryCard_Click" ToolTip="Mostrar reglas proximas a vencer.">
          <StackPanel>
            <Border Style="{StaticResource SquareStatAccent}" Background="#D64545"/>
            <TextBlock Text="POR VENCER" Style="{StaticResource SquareStatLabel}"/>
            <TextBlock x:Name="ExpiringRulesCard" Text="0" Style="{StaticResource SquareStatValue}" Foreground="#B42318"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource SquareStatCell}" Background="#FFFFFF" Tag="CAMBIOS" Cursor="Hand" MouseLeftButtonUp="SummaryCard_Click" ToolTip="Abrir historial de cambios recientes.">
          <StackPanel>
            <Border Style="{StaticResource SquareStatAccent}" Background="#6B7FA6"/>
            <TextBlock Text="CAMBIOS RECIENTES" Style="{StaticResource SquareStatLabel}"/>
            <TextBlock x:Name="RecentChangesCard" Text="0" Style="{StaticResource SquareStatValue}"/>
          </StackPanel>
        </Border>
      </UniformGrid>
    </Border>

    <TabControl Grid.Row="2" x:Name="SettingsTabs" Style="{StaticResource SquareTabControl}" SelectionChanged="SettingsTabs_SelectionChanged">
      <TabItem Header="CATÁLOGO">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Filtros: mismos campos de antes, pero con etiqueta arriba y una sola altura de
               caja. Los botones de accion se subieron al encabezado, asi que aqui solo queda
               lo que controla la busqueda. -->
          <Border Grid.Row="0" Style="{StaticResource SquareFilterCard}">
            <StackPanel>
              <DockPanel Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                  <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconFilter}" Stroke="#0F3E95" Margin="0,0,9,0"/>
                  <TextBlock Text="FILTROS DE BÚSQUEDA" FontSize="12" FontWeight="Black" Foreground="#16326B" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="RulesCountText" DockPanel.Dock="Right" HorizontalAlignment="Right" Text="0 REGLAS" Style="{StaticResource SquarePagerSummary}"/>
              </DockPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="14"/>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="18"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock Text="BUSCAR COMISIÓN" Style="{StaticResource SquareFieldLabel}"/>
                  <Border Style="{StaticResource SquareFieldBorder}">
                    <TextBox x:Name="SearchBox" ToolTip="Escribe MAJESTIC, TURIBUS, SALMORAN, MERCADO, AMEX, etc. Filtra inmediatamente." Style="{StaticResource DashboardTextInput}" TextChanged="SearchBox_TextChanged"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="ESTADO" Style="{StaticResource SquareFieldLabel}"/>
                  <ComboBox x:Name="StatusFilter" Style="{StaticResource SquareComboInput}" MinHeight="40" ToolTip="Filtra por estado de vigencia." SelectionChanged="StatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Activos" IsSelected="True"/>
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Inactivos"/>
                    <ComboBoxItem Content="Vigentes"/>
                    <ComboBoxItem Content="Por vencer"/>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <TextBlock Text="VIGENTES AL DÍA" Style="{StaticResource SquareFieldLabel}"/>
                  <Border Style="{StaticResource SquareFieldBorder}">
                    <DatePicker x:Name="VigencyFilter" Style="{StaticResource DashboardDateInput}" ToolTip="Fecha que se usa para revisar si una regla esta vigente." SelectedDateChanged="VigencyFilter_SelectedDateChanged"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                  <Button Content="LIMPIAR" Style="{StaticResource SquareSecondaryButton}" ToolTip="Regresa los filtros a Activos y borra la busqueda." Click="ClearRuleFilters_Click"/>
                </StackPanel>
              </Grid>
              <!-- Filtro de categoria: sigue existiendo porque las tarjetas de arriba y el
                   codigo lo usan para filtrar, pero no se muestra para no duplicar controles. -->
              <ComboBox x:Name="CategoryFilter" Visibility="Collapsed" SelectionChanged="CategoryFilter_SelectionChanged">
                <ComboBoxItem Content="Todos"/>
                <ComboBoxItem Content="Transportes" IsSelected="True"/>
                <ComboBoxItem Content="Formas de pago"/>
                <ComboBoxItem Content="Joyería"/>
                <ComboBoxItem Content="Tequila"/>
                <ComboBoxItem Content="Guías"/>
                <ComboBoxItem Content="Dejadas"/>
                <ComboBoxItem Content="Gastos"/>
              </ComboBox>
              <!-- Avisos de la pantalla (regla no seleccionada, error al guardar, permiso
                   insuficiente): el mensaje del editor vive dentro del panel emergente, aqui
                   se ve tambien con el panel cerrado. -->
              <TextBlock x:Name="CatalogStatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" FontWeight="Bold" Foreground="#41567C" Margin="0,14,0,0"/>
              <Border x:Name="FallbackAlert" Visibility="Collapsed" Background="#FBF3E4" BorderBrush="#ECD8A7" BorderThickness="1" CornerRadius="2" Padding="12,9" Margin="0,14,0,0">
                <TextBlock Text="Esta regla esta usando un valor de respaldo. Conviene configurarla antes de liquidar." Foreground="#9A6F13" FontSize="12" FontWeight="Bold" TextWrapping="Wrap"/>
              </Border>
            </StackPanel>
          </Border>


          <Border Grid.Row="1" Style="{StaticResource SquareStatCard}" Padding="0" Margin="0">
            <DataGrid x:Name="RulesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      SelectionChanged="RulesGrid_SelectionChanged" MouseDoubleClick="RulesGrid_MouseDoubleClick"
                      behaviors:DataGridDragScroll.Enabled="True"
                      RowHeight="44" ColumnHeaderHeight="44"
                      BorderThickness="0" Background="Transparent" Margin="0"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      EnableColumnVirtualization="True" EnableRowVirtualization="True"
                      AlternationCount="2"
                      ColumnHeaderStyle="{StaticResource DashboardGridHeader}"
                      CellStyle="{StaticResource DashboardGridCell}"
                      RowStyle="{StaticResource DashboardGridRow}">
              <DataGrid.Columns>
                <!-- Anchos proporcionales con MinWidth de respaldo, como en Comisiones: la
                     tabla ocupa todo el ancho y no deja hueco muerto a la derecha. -->
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="200*" MinWidth="130"/>
                <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="115*" MinWidth="86"/>
                <DataGridTextColumn Header="Comisión" Binding="{Binding CommissionDisplay}" Width="85*" MinWidth="66"/>
                <DataGridTextColumn Header="Efectivo" Binding="{Binding CashRetentionPercent, StringFormat={}{0:0.##}%}" Width="80*" MinWidth="62"/>
                <DataGridTextColumn Header="Tarjeta" Binding="{Binding CardRetentionPercent, StringFormat={}{0:0.##}%}" Width="80*" MinWidth="60"/>
                <DataGridTextColumn Header="AMEX" Binding="{Binding AmexRetentionPercent, StringFormat={}{0:0.##}%}" Width="75*" MinWidth="58"/>
                <DataGridTextColumn Header="Dejada" Binding="{Binding PayoutDisplay}" Width="85*" MinWidth="64"/>
                <DataGridTextColumn Header="Tipo de pax" Binding="{Binding PaxKindDisplay}" Width="100*" MinWidth="76"/>
                <DataGridTextColumn Header="N° moneda" Binding="{Binding MonedaDisplay}" Width="90*" MinWidth="70"/>
                <DataGridTextColumn Header="Vigencia" Binding="{Binding EffectiveRange}" Width="135*" MinWidth="105"/>
                <!-- Estado como chip, con el mismo lenguaje de color que los estatus de
                     Comisiones: verde = vigente, gris = fuera de operacion. -->
                <DataGridTemplateColumn Header="Estado" Width="95*" MinWidth="80">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Border HorizontalAlignment="Center">
                        <Border.Style>
                          <Style TargetType="Border" BasedOn="{StaticResource SquareStatusBadge}">
                            <Setter Property="Background" Value="#F1F4F9"/>
                            <Setter Property="BorderBrush" Value="#DCE5F2"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding Active}" Value="True">
                                <Setter Property="Background" Value="#EAF8F2"/>
                                <Setter Property="BorderBrush" Value="#BFE7D2"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusText}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource SquareStatusBadgeText}">
                              <Setter Property="Foreground" Value="#6B7FA6"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Active}" Value="True">
                                  <Setter Property="Foreground" Value="#0F6F58"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </Border>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Acciones en un solo renglon de chips: tres botones del mismo alto que
                     caben en la altura de la fila. Antes eran botones sueltos de anchos
                     distintos en una columna de 330px que se cortaban al angostar. -->
                <DataGridTemplateColumn Header="Acciones" Width="244" MinWidth="244">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="1" Content="CAMBIAR" ToolTip="Cambio rapido con confirmacion, motivo y auditoria." Style="{StaticResource SquareChipButton}" Margin="2,0" Padding="4,0" HorizontalAlignment="Stretch" Click="QuickCommission_Click"/>
                        <Button Grid.Column="1" Content="PROBAR" ToolTip="Prueba esta regla en el simulador." Style="{StaticResource SquareChipButton}" Margin="2,0" Padding="4,0" HorizontalAlignment="Stretch" Click="RowSimulate_Click"/>
                        <Button Grid.Column="2" Content="HISTORIAL" ToolTip="Ver historial de cambios." Style="{StaticResource SquareChipButton}" Margin="2,0" Padding="4,0" HorizontalAlignment="Stretch" Click="ViewHistory_Click"/>
                      </Grid>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="PROBAR COMISIÓN">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="300" MaxWidth="440"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource SquareFilterCard}" Margin="0">
            <StackPanel>
              <TextBlock Text="PROBAR COMISIÓN" FontSize="12" FontWeight="Black" Foreground="#16326B"/>
              <TextBlock Text="Calcula una comision de prueba sin guardar ninguna venta." FontSize="11" Foreground="#6B7FA6" TextWrapping="Wrap" Margin="0,6,0,0"/>

              <TextBlock Text="1. TRANSPORTE / REGLA" Style="{StaticResource SquareFieldLabel}" Margin="0,16,0,8"/>
              <ComboBox x:Name="SimTransport" Style="{StaticResource SquareComboInput}" MinHeight="40" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" DisplayMemberPath="Name" TextSearch.TextPath="Name" ToolTip="Elige la unidad del catalogo o escribe para buscar."/>
              <TextBlock Text="2. VENTA" Style="{StaticResource SquareFieldLabel}" Margin="0,14,0,8"/>
              <TextBox x:Name="SimSale" Style="{StaticResource SquareInputBox}" MinHeight="40" ToolTip="Importe total de venta. Ejemplo: 1335." Text="0"/>
              <TextBlock Text="3. FORMA DE PAGO" Style="{StaticResource SquareFieldLabel}" Margin="0,14,0,8"/>
              <ComboBox x:Name="SimPayment" Style="{StaticResource SquareComboInput}" MinHeight="40" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" DisplayMemberPath="Name" TextSearch.TextPath="Name" ToolTip="Elige la forma de pago del catalogo o escribe para buscar."/>
              <TextBlock Text="DEJADA (OPCIONAL)" Style="{StaticResource SquareFieldLabel}" Margin="0,14,0,8"/>
              <TextBox x:Name="SimPayout" Style="{StaticResource SquareInputBox}" MinHeight="40" Text="0"/>
              <TextBlock Text="GASTO (OPCIONAL)" Style="{StaticResource SquareFieldLabel}" Margin="0,14,0,8"/>
              <TextBox x:Name="SimExpense" Style="{StaticResource SquareInputBox}" MinHeight="40" Text="0"/>
              <TextBlock Text="SUBTOTAL (SOLO SI ES DISTINTO A LA VENTA)" Style="{StaticResource SquareFieldLabel}" Margin="0,14,0,8" TextWrapping="Wrap"/>
              <TextBox x:Name="SimSubtotal" Style="{StaticResource SquareInputBox}" MinHeight="40" Text="0"/>
              <DatePicker x:Name="SimDate" Visibility="Collapsed"/>
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Style="{StaticResource SquarePrimaryButton}" ToolTip="Calcula una comision de prueba sin guardar venta." Click="Simulate_Click">
                  <StackPanel Orientation="Horizontal">
                    <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconDollar}" Stroke="White" Margin="0,0,9,0"/>
                    <TextBlock Text="CALCULAR" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Button Content="LIMPIAR" Style="{StaticResource SquareSecondaryButton}" Margin="8,0,0,0" ToolTip="Restablece el simulador para iniciar otra prueba." Click="ClearSimulator_Click"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
          <Border Grid.Column="2" Style="{StaticResource SquareFilterCard}" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <TextBlock Text="¿CÓMO SE CALCULÓ?" FontSize="12" FontWeight="Black" Foreground="#16326B" Margin="0,0,0,12"/>
                <TextBlock x:Name="SimulationResult" TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#16326B"/>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="HISTORIAL">
        <Border Style="{StaticResource SquareStatCard}" Padding="0" Margin="0">
          <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="None"
                    behaviors:DataGridDragScroll.Enabled="True"
                    RowHeight="42" ColumnHeaderHeight="44"
                    BorderThickness="0" Background="Transparent"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    EnableColumnVirtualization="True" EnableRowVirtualization="True"
                    AlternationCount="2"
                    ColumnHeaderStyle="{StaticResource DashboardGridHeader}"
                    CellStyle="{StaticResource DashboardGridCell}"
                    RowStyle="{StaticResource DashboardGridRow}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="150*" MinWidth="120"/>
              <DataGridTextColumn Header="Usuario" Binding="{Binding User}" Width="120*" MinWidth="90"/>
              <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120*" MinWidth="90"/>
              <DataGridTextColumn Header="Clave" Binding="{Binding Code}" Width="150*" MinWidth="110"/>
              <DataGridTextColumn Header="Campo" Binding="{Binding FieldName}" Width="110*" MinWidth="85"/>
              <DataGridTextColumn Header="Anterior" Binding="{Binding PreviousValue}" Width="120*" MinWidth="85"/>
              <DataGridTextColumn Header="Nuevo" Binding="{Binding NewValue}" Width="120*" MinWidth="85"/>
              <DataGridTextColumn Header="Motivo" Binding="{Binding Reason}" Width="220*" MinWidth="140"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </TabItem>

      <!-- Reglas que aplican a TODOS los transportes por igual, a diferencia del Catalogo,
           donde cada transporte tiene su propio porcentaje. -->
      <TabItem Header="REGLAS GLOBALES">
        <Border Style="{StaticResource SquareFilterCard}" Margin="0">
          <StackPanel>
            <TextBlock Text="DESCUENTO DE LA DEJADA" FontSize="12" FontWeight="Black" Foreground="#16326B"/>
            <TextBlock TextWrapping="Wrap" Foreground="#6B7FA6" FontSize="12" Margin="0,8,0,0" MaxWidth="900" HorizontalAlignment="Left"
                       Text="La dejada que se le adelanta al taxista normalmente se resta de la venta antes de calcular su comisión. En ventas muy chicas ese descuento lo dejaría casi sin comisión, así que por debajo del monto que definas aquí la dejada NO se descuenta."/>

            <StackPanel Orientation="Horizontal" Margin="0,18,0,0" VerticalAlignment="Center">
              <TextBlock Text="No descontar la dejada en ventas de hasta:" VerticalAlignment="Center" Foreground="#16326B" FontSize="12" FontWeight="Bold"/>
              <TextBlock Text="$" VerticalAlignment="Center" Margin="12,0,4,0" FontWeight="Black" Foreground="#0F3E95" FontSize="15"/>
              <TextBox x:Name="PayoutThresholdBox" Style="{StaticResource SquareInputBox}" Width="130" MinHeight="40" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
              <Button Content="GUARDAR" Style="{StaticResource SquarePrimaryButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="SavePayoutThreshold_Click"/>
            </StackPanel>
            <TextBlock x:Name="PayoutThresholdStatus" Foreground="#0F8F83" FontSize="11" FontWeight="Bold" Margin="0,12,0,0" TextWrapping="Wrap"/>

            <Border Background="#F1F5FC" BorderBrush="#DCE6F5" BorderThickness="1" Padding="16" Margin="0,18,0,0" HorizontalAlignment="Left">
              <StackPanel>
                <TextBlock Text="EJEMPLO CON EL VALOR ACTUAL" FontSize="10" FontWeight="Black" Foreground="#5A7096" Margin="0,0,0,10"/>
                <TextBlock x:Name="PayoutThresholdExample" TextWrapping="Wrap" Foreground="#16326B" FontSize="12" LineHeight="20"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </TabItem>

      <TabItem Header="OPCIONES AVANZADAS">
        <Border Style="{StaticResource SquareStatCard}" Padding="0" Margin="0">
          <DataGrid x:Name="DiagnosticsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                    HeadersVisibility="Column" GridLinesVisibility="None"
                    behaviors:DataGridDragScroll.Enabled="True"
                    RowHeight="42" ColumnHeaderHeight="44"
                    BorderThickness="0" Background="Transparent"
                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                    EnableColumnVirtualization="True" EnableRowVirtualization="True"
                    AlternationCount="2"
                    ColumnHeaderStyle="{StaticResource DashboardGridHeader}"
                    CellStyle="{StaticResource DashboardGridCell}"
                    RowStyle="{StaticResource DashboardGridRow}">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Fecha" Binding="{Binding Date}" Width="150*" MinWidth="120"/>
              <DataGridTextColumn Header="Severidad" Binding="{Binding Severity}" Width="95*" MinWidth="78"/>
              <DataGridTextColumn Header="Categoría" Binding="{Binding Category}" Width="120*" MinWidth="90"/>
              <DataGridTextColumn Header="Concepto" Binding="{Binding Concept}" Width="160*" MinWidth="110"/>
              <DataGridTextColumn Header="Detalle" Binding="{Binding Detail}" Width="220*" MinWidth="140"/>
              <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="220*" MinWidth="140"/>
              <DataGridTextColumn Header="Fuente" Binding="{Binding Source}" Width="140*" MinWidth="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </Border>
      </TabItem>
    </TabControl>
    <!-- Panel de edicion: se abre encima de la pantalla al presionar EDITAR (o al elegir
         "corregir" en una fila). Antes el formulario vivia pegado a la derecha, le quitaba
         ancho a la tabla y se veia siempre, incluso sin regla seleccionada. -->
    <Grid x:Name="EditorOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#B3102A4C">
      <Border Width="780" MaxHeight="720" Background="#FFFFFF" BorderBrush="#D7E2F2" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <DockPanel>
          <Border DockPanel.Dock="Top" Style="{StaticResource SquareHeaderCard}" Margin="0">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="CERRAR" ToolTip="Cerrar sin guardar." Style="{StaticResource SquareToolbarGhostButton}" VerticalAlignment="Top" Click="CloseEditor_Click"/>
              <StackPanel>
                <TextBlock x:Name="EditorTitle" Text="EDITAR COMISIÓN" FontSize="14" FontWeight="Black" Foreground="White"/>
                <TextBlock x:Name="EditorHint" Text="Selecciona una fila o crea una regla nueva. Los cambios siempre piden motivo y quedan auditados." Foreground="#BBD3F8" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Background="#F7FAFF" BorderBrush="#D7E2F2" BorderThickness="0,1,0,0" Padding="18,14">
            <DockPanel LastChildFill="True">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="CANCELAR" Style="{StaticResource SquareSecondaryButton}" Margin="0,0,8,0" Click="CloseEditor_Click"/>
                <Button x:Name="SaveRuleButton" Content="GUARDAR CAMBIO" ToolTip="Muestra resumen, pide confirmacion y guarda con auditoria." Style="{StaticResource SquarePrimaryButton}" Click="SaveRule_Click"/>
              </StackPanel>
              <TextBlock x:Name="EditorMessage" TextWrapping="Wrap" FontSize="11" FontWeight="Bold" Foreground="#41567C" VerticalAlignment="Center" Margin="0,0,14,0"/>
            </DockPanel>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,14">
            <StackPanel>

              <TextBlock Text="INFORMACIÓN" Style="{StaticResource SquareSectionHeading}"/>
              <TextBlock Text="Categoría" Style="{StaticResource SquareInputLabel}"/>
              <ComboBox x:Name="EditCategory" Style="{StaticResource SquareComboInput}" ToolTip="Tipo de regla: transporte, forma de pago, guia, joyeria, tequila, dejada o gasto." Margin="0,0,0,10">
                <ComboBoxItem Content="TRANSPORTE"/><ComboBoxItem Content="FORMA_PAGO"/><ComboBoxItem Content="GENERAL"/><ComboBoxItem Content="GUIA"/><ComboBoxItem Content="JOYERIA"/><ComboBoxItem Content="TEQUILA"/><ComboBoxItem Content="DEJADA"/><ComboBoxItem Content="GASTO"/>
              </ComboBox>
              <TextBlock Text="Clave" Style="{StaticResource SquareInputLabel}"/>
              <TextBox x:Name="EditCode" Style="{StaticResource SquareInputBox}" ToolTip="Identificador unico de la regla, por ejemplo TAXI VERDE NACIONAL o MERCADO PAGO." Margin="0,0,0,10"/>
              <TextBlock Text="Nombre" Style="{StaticResource SquareInputLabel}"/>
              <TextBox x:Name="EditName" Style="{StaticResource SquareInputBox}" ToolTip="Nombre claro que vera el usuario." Margin="0,0,0,10"/>

              <TextBlock Text="PORCENTAJES" Style="{StaticResource SquareSectionHeading}"/>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,6,10">
                  <TextBlock Text="Comisión %" Style="{StaticResource SquareInputLabel}"/>
                  <TextBox x:Name="EditCommission" Style="{StaticResource SquareInputBox}" ToolTip="Porcentaje que recibe la unidad o guia segun esta regla. Escribe 10 para 10%."/>
                </StackPanel>
                <StackPanel Margin="6,0,0,10">
                  <TextBlock Text="Efectivo %" Style="{StaticResource SquareInputLabel}"/>
                  <TextBox x:Name="EditCash" Style="{StaticResource SquareInputBox}" ToolTip="Retencion para pago en efectivo. Normalmente 0."/>
                </StackPanel>
                <StackPanel Margin="0,0,6,10">
                  <TextBlock Text="Tarjeta %" Style="{StaticResource SquareInputLabel}"/>
                  <TextBox x:Name="EditCard" Style="{StaticResource SquareInputBox}" ToolTip="Porcentaje que se descuenta al pago con tarjeta normal."/>
                </StackPanel>
                <StackPanel Margin="6,0,0,10">
                  <TextBlock Text="AMEX %" Style="{StaticResource SquareInputLabel}"/>
                  <TextBox x:Name="EditAmex" Style="{StaticResource SquareInputBox}" ToolTip="Porcentaje que se descuenta en pagos AMEX."/>
                </StackPanel>
              </UniformGrid>

              <TextBlock Text="TABULADOR" Style="{StaticResource SquareSectionHeading}"/>
              <TextBlock Text="Dejada $" Style="{StaticResource SquareInputLabel}"/>
              <TextBox x:Name="EditPayoutAmount" Style="{StaticResource SquareInputBox}" ToolTip="Importe de dejada del tabulador para esta unidad. Deja 0 si no aplica." Margin="0,0,0,10"/>
              <!-- Antes la etiqueta "Tipo de pax" quedaba pegada arriba del campo de
                   N° de moneda y el combo de pax aparecia despues, sin etiqueta. -->
              <TextBlock Text="Tipo de pax" Style="{StaticResource SquareInputLabel}"/>
              <ComboBox x:Name="EditPaxKind" Style="{StaticResource SquareComboInput}" Margin="0,0,0,10"
                        ToolTip="Para quien aplica esta tarifa de dejada. El tabulador cobra distinto por la misma unidad segun quien llegue.">
                <ComboBoxItem Content=""/><ComboBoxItem Content="EXTRANJEROS"/><ComboBoxItem Content="NACIONALES"/>
              </ComboBox>
              <TextBlock Text="N° de moneda (forma de pago del punto de venta)" Style="{StaticResource SquareInputLabel}" TextWrapping="Wrap"/>
              <TextBox x:Name="EditMonedaId" Style="{StaticResource SquareInputBox}" Margin="0,0,0,10"
                       ToolTip="Numero de la forma de pago en el punto de venta (tabla Monedas). Deja -1 si la regla no corresponde a una forma de pago."/>
              <TextBlock Text="Tipo de pago" Style="{StaticResource SquareInputLabel}"/>
              <ComboBox x:Name="EditPaymentKind" Style="{StaticResource SquareComboInput}" ToolTip="Clasifica la forma de pago para aplicar la retencion correcta." Margin="0,0,0,10">
                <ComboBoxItem Content=""/><ComboBoxItem Content="EFECTIVO"/><ComboBoxItem Content="TARJETA_NORMAL"/><ComboBoxItem Content="AMEX"/><ComboBoxItem Content="DIVISA"/><ComboBoxItem Content="OTRO"/>
              </ComboBox>

              <TextBlock Text="CONTROL" Style="{StaticResource SquareSectionHeading}"/>
              <UniformGrid Columns="2">
                <CheckBox x:Name="EditPayout" Content="Aplica dejada" FontSize="12" Foreground="#16326B" ToolTip="Indica si la regla participa en calculo de dejadas." IsChecked="True" Margin="0,0,6,10"/>
                <CheckBox x:Name="EditExpense" Content="Aplica gasto" FontSize="12" Foreground="#16326B" ToolTip="Indica si se descuentan gastos asociados cuando existan." IsChecked="True" Margin="6,0,0,10"/>
              </UniformGrid>

              <TextBlock Text="VIGENCIA" Style="{StaticResource SquareSectionHeading}"/>
              <UniformGrid Columns="2">
                <StackPanel Margin="0,0,6,10">
                  <TextBlock Text="Desde" Style="{StaticResource SquareInputLabel}"/>
                  <Border Style="{StaticResource SquareFieldBorder}">
                    <DatePicker x:Name="EditFrom" Style="{StaticResource DashboardDateInput}" MinWidth="0" Padding="8,6" ToolTip="Fecha desde la que debe utilizarse esta regla."/>
                  </Border>
                </StackPanel>
                <StackPanel Margin="6,0,0,10">
                  <TextBlock Text="Hasta (opcional)" Style="{StaticResource SquareInputLabel}"/>
                  <Border Style="{StaticResource SquareFieldBorder}">
                    <DatePicker x:Name="EditTo" Style="{StaticResource DashboardDateInput}" MinWidth="0" Padding="8,6" ToolTip="Dejalo vacio si la regla queda vigente hasta nuevo aviso."/>
                  </Border>
                </StackPanel>
              </UniformGrid>
              <CheckBox x:Name="EditActive" Content="ACTIVO" FontSize="12" FontWeight="Bold" Foreground="#16326B" ToolTip="Desmarca para desactivar sin borrar historial." IsChecked="True" Margin="0,0,0,10"/>

              <TextBlock Text="Notas" Style="{StaticResource SquareInputLabel}"/>
              <TextBox x:Name="EditNotes" Style="{StaticResource SquareInputBox}" ToolTip="Notas internas para explicar la regla." Height="58" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,10"/>
              <TextBlock Text="Motivo del cambio (obligatorio)" Style="{StaticResource SquareInputLabel}"/>
              <TextBox x:Name="EditReason" Style="{StaticResource SquareInputBox}" ToolTip="Explica por que se hace el cambio. Se guarda en auditoria." Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,14"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
