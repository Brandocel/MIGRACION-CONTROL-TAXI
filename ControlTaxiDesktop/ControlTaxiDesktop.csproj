<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.11" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.11" />
    <!-- Fija la version corregida de System.Formats.Asn1; sin esto llega la 5.0.0
         vulnerable como dependencia transitiva de Microsoft.Data.SqlClient 5.1.6. -->
    <PackageReference Include="System.Formats.Asn1" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Sin versión corregida publicada aún por el mantenedor de SQLitePCLRaw; revisar periódicamente. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />

    <!-- System.Private.Uri 4.3.0: llega como dependencia TRANSITIVA de
         Microsoft.Data.SqlClient 5.1.6; no se referencia directamente. En .NET 9 el
         ensamblado real lo aporta el runtime, no este paquete heredado.
         PENDIENTE: la solucion de fondo es subir Microsoft.Data.SqlClient. No se hizo
         junto al despliegue del 2026-08-21 para no cambiar el driver de base de datos
         sin una ronda de pruebas; queda como tarea a atender despues. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5f2m-466j-3848" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-x5qj-9vmx-7g6g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xhfc-gr8f-ffwc" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="..\assets\*.png">
      <Link>Assets\%(Filename)%(Extension)</Link>
    </Resource>
  </ItemGroup>
  <ItemGroup>
    <!-- Sincronizador SyncTaxi: se copia junto al ejecutable para que el
         Desktop lo lance al arrancar y traiga los datos de Hostinger a la base configurada. -->
    <Content Include="SyncTaxi\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Sincronizador Plaza 28: solo se publican los archivos operativos.
         Se excluyen respaldos, llaves y scripts manuales de mantenimiento. -->
    <Content Include="SyncTaxi_Plaza28\sync-sqlserver-hostinger-bidirectional.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\sync.plaza28.config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\sync-plaza28-loop.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\iniciar-sincronizador-plaza28-oculto.vbs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\instalar-sincronizador-plaza28.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\configurar-credencial-plaza28.ps1">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\INSTALAR-SINCRONIZADOR-PLAZA28.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\DESINSTALAR-SINCRONIZADOR-PLAZA28.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\ESTADO-SINCRONIZADOR-PLAZA28.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="SyncTaxi_Plaza28\CONFIGURAR-CREDENCIAL-PLAZA28.cmd">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
