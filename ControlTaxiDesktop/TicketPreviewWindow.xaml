<Window x:Class="ControlTaxiDesktop.TicketPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ticket dejada"
        Width="420"
        Height="640"
        WindowStartupLocation="CenterOwner"
        Background="#DDECF7">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#FFFDF9" BorderBrush="#D8C7A6" BorderThickness="1" Padding="18">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="TicketText" FontFamily="Consolas" FontSize="13" Foreground="#111827" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
      <Button Content="GUARDAR TXT" Style="{StaticResource WebActionButton}" Click="Save_Click"/>
      <Button Content="IMPRIMIR" Style="{StaticResource WebActionSaveButton}" Click="Print_Click"/>
      <Button Content="CERRAR" Style="{StaticResource WebActionRedButton}" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
