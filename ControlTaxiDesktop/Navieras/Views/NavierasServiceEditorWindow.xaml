<Window x:Class="ControlTaxiDesktop.Navieras.Views.NavierasServiceEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Servicio Navieras"
        Height="520"
        Width="760"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="3" x:Name="HeaderTextBlock" FontSize="20" FontWeight="Bold" Foreground="#12324A"/>

            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                <TextBlock Text="Folio servicio" FontWeight="Bold"/>
                <TextBox x:Name="FolioTextBox" Height="34" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                <TextBlock Text="Fecha operacion" FontWeight="Bold"/>
                <DatePicker x:Name="OperationDatePicker" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
                <TextBlock Text="Compania" FontWeight="Bold"/>
                <ComboBox x:Name="CompanyComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="CompanyId"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                <TextBlock Text="Barco" FontWeight="Bold"/>
                <ComboBox x:Name="BoatComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="BoatId"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
                <TextBlock Text="Guia programado" FontWeight="Bold"/>
                <ComboBox x:Name="GuideComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="PersonId"/>
            </StackPanel>
            <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
                <TextBlock Text="Capitan programado" FontWeight="Bold"/>
                <ComboBox x:Name="CaptainComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="PersonId"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,12,0,0">
                <TextBlock Text="Muelle programado" FontWeight="Bold"/>
                <ComboBox x:Name="DockComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="DockId"/>
            </StackPanel>
            <StackPanel Grid.Row="4" Grid.Column="2" Margin="0,12,0,0">
                <TextBlock Text="Folio brazalete" FontWeight="Bold"/>
                <TextBox x:Name="BraceletTextBox" Height="34" Margin="0,6,0,0"/>
            </StackPanel>

            <Grid Grid.Row="5" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Llegada programada" FontWeight="Bold"/>
                    <TextBox x:Name="ArrivalTextBox" Height="34" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Salida programada" FontWeight="Bold"/>
                    <TextBox x:Name="DepartureTextBox" Height="34" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="PAX programados" FontWeight="Bold"/>
                    <TextBox x:Name="PaxTextBox" Height="34" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,12,0,0">
                <TextBlock Text="Observaciones" FontWeight="Bold"/>
                <TextBox x:Name="NotesTextBox" AcceptsReturn="True" Height="90" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto"/>
                <TextBlock x:Name="ErrorTextBlock" Margin="0,8,0,0" Foreground="#B42318" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Width="110" Margin="0,0,10,0" Content="Cancelar" Click="CancelButton_Click"/>
                    <Button Width="130" Background="#0E5E9C" Foreground="White" Content="Guardar" Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
