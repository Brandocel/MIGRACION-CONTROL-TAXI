<Window x:Class="ControlTaxiDesktop.Navieras.Views.NavierasLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso Navieras"
        Height="380"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#EAF3FA">
    <Grid>
        <Border Background="White" CornerRadius="20" Padding="24" Margin="16" BorderBrush="#D7E3EC" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Acceso Navieras" FontSize="24" FontWeight="Black" Foreground="#12324A"/>
                    <TextBlock Margin="0,8,0,0" Text="Conéctate a la API real de Navieras para trabajar servicios, folios y catalogación desde el escritorio." TextWrapping="Wrap" Foreground="#4E6478"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,18,0,0">
                    <TextBlock Text="URL base de la API" FontWeight="Bold" Foreground="#12324A"/>
                    <TextBox x:Name="BaseUrlTextBox" Height="36" Margin="0,8,0,0" ToolTip="Escribe la URL base de la API de Navieras" Background="#F9FCFE" BorderBrush="#B9D4E5" BorderThickness="1"/>
                </StackPanel>

                <Grid Grid.Row="3" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Usuario" FontWeight="Bold" Foreground="#12324A"/>
                        <TextBox x:Name="UserNameTextBox" Height="36" Margin="0,8,0,0" Background="#F9FCFE" BorderBrush="#B9D4E5" BorderThickness="1"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Contraseña" FontWeight="Bold" Foreground="#12324A"/>
                        <PasswordBox x:Name="PasswordTextBox" Height="36" Margin="0,8,0,0" Background="#F9FCFE" BorderBrush="#B9D4E5" BorderThickness="1"/>
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ErrorTextBlock" Grid.Row="5" Margin="0,18,0,0" Foreground="#B42318" TextWrapping="Wrap"/>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                    <Button Width="112" Content="Cancelar" Click="CancelButton_Click"/>
                    <Button Width="132" Margin="12,0,0,0" Background="#0E5E9C" Foreground="White" Content="Ingresar" Click="LoginButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
