<Window x:Class="ControlTaxiDesktop.Navieras.Views.NavierasArrivalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar llegada"
        Height="420"
        Width="640"
        WindowStartupLocation="CenterOwner"
        Background="White">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="3" Text="Registrar llegada real" FontSize="18" FontWeight="Bold" Foreground="#12324A"/>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
            <TextBlock Text="Hora llegada real" FontWeight="Bold"/>
            <TextBox x:Name="ArrivalTextBox" Height="34" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
            <TextBlock Text="PAX reales" FontWeight="Bold"/>
            <TextBox x:Name="PaxTextBox" Height="34" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,12,0,0">
            <TextBlock Text="Muelle real" FontWeight="Bold"/>
            <ComboBox x:Name="DockComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="DockId"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
            <TextBlock Text="Guia real" FontWeight="Bold"/>
            <ComboBox x:Name="GuideComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="PersonId"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,12,0,0">
            <TextBlock Text="Capitan real" FontWeight="Bold"/>
            <ComboBox x:Name="CaptainComboBox" Height="34" Margin="0,6,0,0" DisplayMemberPath="Name" SelectedValuePath="PersonId"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,12,0,0">
            <TextBlock Text="Observaciones" FontWeight="Bold"/>
            <TextBox x:Name="NotesTextBox" Height="34" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="100" Margin="0,0,10,0" Content="Cancelar" Click="CancelButton_Click"/>
            <Button Width="120" Background="#0E5E9C" Foreground="White" Content="Registrar" Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
