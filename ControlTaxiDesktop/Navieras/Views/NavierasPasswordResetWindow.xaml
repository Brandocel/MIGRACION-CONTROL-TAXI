<Window x:Class="ControlTaxiDesktop.Navieras.Views.NavierasPasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restablecer contrasena"
        Height="240"
        Width="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="White">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Restablecer contrasena" FontSize="18" FontWeight="Bold" Foreground="#12324A"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,14" Text="La API exige confirmar la nueva contrasena." TextWrapping="Wrap" Foreground="#4E6478"/>
        <PasswordBox x:Name="NewPasswordTextBox" Grid.Row="2" Height="34" Margin="0,0,0,10"/>
        <PasswordBox x:Name="ConfirmPasswordTextBox" Grid.Row="3" Height="34"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Width="100" Margin="0,0,10,0" Content="Cancelar" Click="CancelButton_Click"/>
            <Button Width="100" Background="#0E5E9C" Foreground="White" Content="Guardar" Click="AcceptButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
