                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Width="268" Background="#F4FEF6" BorderBrush="#C6E9D2" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,20,16">
