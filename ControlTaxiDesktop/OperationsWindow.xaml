                      <Border Width="56" Height="56" CornerRadius="12" Background="#FFEAF0" BorderBrush="#F3C9D6" BorderThickness="1" Margin="0,0,14,0">
                        <Viewbox Margin="12"><TextBlock Text="⊘" Foreground="#C23E63"/></Viewbox>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="No entraron" FontSize="11" FontWeight="Bold" Foreground="#A72F59"/>
