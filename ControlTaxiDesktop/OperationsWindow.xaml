                        <TextBox x:Name="RelationPassengers" Style="{StaticResource RelationStatValueText}" IsReadOnly="True" Text="0" Foreground="#8B49D6"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border x:Name="RelationNoShowCard" Width="268" Background="#FFF7FA" BorderBrush="#F3C9D6" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,20,16" Visibility="Collapsed">
