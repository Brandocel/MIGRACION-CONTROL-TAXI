                          <TextBlock Text="≣" Foreground="#0F4AB6" FontWeight="Bold"/>
                        </Viewbox>
                      </Border>
                      <StackPanel>
                        <TextBlock Text="VIAJES RECIBIDOS DESDE LA APP MOVIL" FontSize="13" FontWeight="ExtraBold" Foreground="#153677"/>
