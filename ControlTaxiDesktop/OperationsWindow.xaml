                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Joven" FontSize="11" FontWeight="Bold" Foreground="#15934C"/>
                        <TextBox x:Name="RelationYouthPassengers" Style="{StaticResource RelationStatValueText}" Text="0" TextChanged="RelationPassengerBreakdown_TextChanged" Foreground="#15934C"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Width="268" Background="#FFF7EF" BorderBrush="#F6D6B3" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,20,16">
                    <StackPanel Orientation="Horizontal">
                      <Border Width="56" Height="56" CornerRadius="12" Background="#FFF0E2" BorderBrush="#F6D6B3" BorderThickness="1" Margin="0,0,14,0">
                        <Viewbox Margin="12"><TextBlock Text="◔" Foreground="#FF8A00"/></Viewbox>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Menores" FontSize="11" FontWeight="Bold" Foreground="#E77D0B"/>
                        <TextBox x:Name="RelationChildPassengers" Style="{StaticResource RelationStatValueText}" Text="0" TextChanged="RelationPassengerBreakdown_TextChanged" Foreground="#E77D0B"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Width="268" Background="#FBF6FF" BorderBrush="#E5D4FB" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,20,16">
