                <Border Grid.Row="0" Background="#F7FAFF" BorderBrush="#D7E2F2" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0" Padding="18,16">
                  <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                      <Border Width="34" Height="34" CornerRadius="10" Background="#E9F1FF" BorderBrush="#CEE0FF" BorderThickness="1" Margin="0,0,10,0">
