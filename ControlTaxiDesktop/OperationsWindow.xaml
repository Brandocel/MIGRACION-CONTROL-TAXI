<Window x:Class="ControlTaxiDesktop.OperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ControlTaxiDesktop.Converters"
        Title="Control Taxi - Operacion local"
        Width="1240"
        Height="720"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#DDECF7">
  <Window.Resources>
    <conv:UpperCaseConverter x:Key="UpperCaseConverter"/>
    <conv:StatusBackgroundConverter x:Key="StatusBackgroundConverter"/>
    <conv:StatusForegroundConverter x:Key="StatusForegroundConverter"/>
    <conv:StatusBorderConverter x:Key="StatusBorderConverter"/>
    <conv:PaidStatusVisibilityConverter x:Key="PaidStatusVisibilityConverter"/>
    <Style x:Key="FormPanel" TargetType="Border">
      <Setter Property="Background" Value="#F8FCFF"/>
      <Setter Property="BorderBrush" Value="#B6C8DA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="#425A73"/>
      <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    <Style x:Key="HiddenWebTabItem" TargetType="{x:Type TabItem}">
      <Setter Property="Height" Value="0"/>
      <Setter Property="Width" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style x:Key="RelationPanelCard" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7E2F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="RelationSectionCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="#0F3E95"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RelationFieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#16326B"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style x:Key="RelationTextInput" TargetType="TextBox">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#132C63"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RelationComboInput" TargetType="ComboBox">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#132C63"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RelationDateInput" TargetType="DatePicker">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Foreground" Value="#132C63"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="12,10"/>
    </Style>
    <Style x:Key="RelationActionButtonBase" TargetType="Button">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0F3E95"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7E2F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="4,4,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="108"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    TextElement.Foreground="{TemplateBinding Foreground}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RelationPrimaryButton" TargetType="Button" BasedOn="{StaticResource RelationActionButtonBase}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#1347B8"/>
      <Setter Property="BorderBrush" Value="#0D368A"/>
    </Style>
    <Style x:Key="RelationSuccessButton" TargetType="Button" BasedOn="{StaticResource RelationActionButtonBase}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#17A65A"/>
      <Setter Property="BorderBrush" Value="#118349"/>
    </Style>
    <Style x:Key="RelationGoldButton" TargetType="Button" BasedOn="{StaticResource RelationActionButtonBase}">
      <Setter Property="Foreground" Value="#C77C00"/>
      <Setter Property="Background" Value="#FFF8E5"/>
      <Setter Property="BorderBrush" Value="#F2C766"/>
    </Style>
    <Style x:Key="RelationDangerButton" TargetType="Button" BasedOn="{StaticResource RelationActionButtonBase}">
      <Setter Property="Foreground" Value="#D62828"/>
      <Setter Property="Background" Value="#FFF6F6"/>
      <Setter Property="BorderBrush" Value="#F0B5B5"/>
    </Style>
    <Style x:Key="RelationStatValueText" TargetType="TextBox">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Black"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="96"/>
    </Style>
    <Style x:Key="RelationDataGridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Background" Value="#0E4DB7"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="12,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#1C63D2"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       Foreground="White"
                       FontSize="12"
                       FontWeight="Bold"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                TextElement.Foreground="White"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="WhiteGridHeaderTemplate">
      <TextBlock Text="{Binding}"
                 Foreground="White"
                 FontSize="13"
                 FontWeight="Bold"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 TextTrimming="CharacterEllipsis"/>
    </DataTemplate>
    <Style x:Key="ModuleHeroCard" TargetType="Border">
      <Setter Property="Margin" Value="0,0,0,18"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="Padding" Value="16"/>
      <Setter Property="BorderBrush" Value="#0B3D9B"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A3D99" Offset="0"/>
            <GradientStop Color="#1855CB" Offset="0.56"/>
            <GradientStop Color="#0B3C99" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModuleGridCard" TargetType="Border" BasedOn="{StaticResource RelationPanelCard}">
      <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="RelationDataGridCell" TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#E3ECF8"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#16326B"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RelationDataGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#16326B"/>
      <Setter Property="BorderBrush" Value="#E3ECF8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridRow">
            <Border x:Name="RowBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <SelectiveScrollingGrid>
                <SelectiveScrollingGrid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </SelectiveScrollingGrid.ColumnDefinitions>
                <SelectiveScrollingGrid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </SelectiveScrollingGrid.RowDefinitions>
                <DataGridCellsPresenter Grid.Column="1"/>
                <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1"
                                          Visibility="{TemplateBinding DetailsVisibility}"/>
                <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"/>
              </SelectiveScrollingGrid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="AlternationIndex" Value="1">
                <Setter TargetName="RowBorder" Property="Background" Value="#F9FBFF"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="#EEF5FF"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="#E6F0FF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RelationGridActionButton" TargetType="Button" BasedOn="{StaticResource RelationActionButtonBase}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinWidth" Value="74"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#0F4AB6"/>
      <Setter Property="BorderBrush" Value="#C9DAF7"/>
    </Style>
    <Style x:Key="BadgeGridActionButton" TargetType="Button" BasedOn="{StaticResource RelationPrimaryButton}">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="MinWidth" Value="74"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Background" Value="#1347B8"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0D368A"/>
    </Style>
  </Window.Resources>

  <Border Margin="18" Background="#E6F3FC" BorderBrush="#9DB8D3" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#FAF8F8" BorderBrush="#B6C8DA" BorderThickness="0,0,0,1">
        <TextBlock x:Name="TitleBarText" Text="REGISTRO" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#304A65"/>
      </Border>

      <TabControl x:Name="Tabs" Grid.Row="1" Margin="10" ItemContainerStyle="{StaticResource HiddenWebTabItem}">
        <TabItem Header="Registros">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Grid Margin="10">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Top">
            <StackPanel Width="1520">
              <Border Style="{StaticResource ModuleHeroCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="62" Height="62" CornerRadius="15" Background="#1747A9" BorderBrush="#81B5FF" BorderThickness="1.2" Margin="0,0,14,0">
                      <Viewbox Margin="12">
                        <TextBlock Text="📋" Foreground="White"/>
                      </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="REGISTRO DIARIO" FontSize="18" FontWeight="Black" Foreground="White"/>
                      <TextBlock Text="Consulta operativa, filtros y detalle del movimiento diario" FontSize="12" Foreground="#D3E2FF" Margin="0,4,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <WrapPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Center" ItemHeight="44">
                    <Button Content="BUSCAR" Style="{StaticResource RelationPrimaryButton}" Click="RefreshRegistro_Click"/>
                    <Button Content="CIERRE" Style="{StaticResource RelationActionButtonBase}" Click="OpenRegistroCierre_Click"/>
                    <Button Content="COMISIONES" Style="{StaticResource RelationGoldButton}" Click="OpenRegistroComisiones_Click"/>
                    <Button Content="FECHA" Style="{StaticResource RelationActionButtonBase}" Click="SetRegistroToday_Click"/>
                    <Button Content="REPORTERIA" Style="{StaticResource RelationActionButtonBase}" Click="OpenRegistroReportes_Click"/>
                    <Button Content="GUARDAR" Style="{StaticResource RelationSuccessButton}" Click="SaveRegistro_Click"/>
                    <Button Content="CSV" Style="{StaticResource RelationActionButtonBase}" Click="ExportRegistroCsv_Click"/>
                    <Button Content="PDF" Style="{StaticResource RelationActionButtonBase}" Click="ExportRegistroPdf_Click"/>
                    <Button Content="MENU" Style="{StaticResource RelationActionButtonBase}" Click="CloseWindow_Click"/>
                    <Button Content="SALIR" Style="{StaticResource RelationDangerButton}" Click="CloseWindow_Click"/>
                  </WrapPanel>
                </Grid>
              </Border>

            <StackPanel Grid.Column="0">
              <Border Style="{StaticResource RelationPanelCard}">
                <WrapPanel>
                  <WrapPanel>
                    <StackPanel Margin="4">
                      <TextBlock Text="BUSCAR FOLIO / TICKET / TAXISTA / HOTEL / GAFETE" FontSize="10" FontWeight="Bold" Foreground="#425A73"/>
                      <TextBox x:Name="RegistroSearch" Width="280"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                      <TextBlock Text="DE FECHA" FontSize="10" FontWeight="Bold" Foreground="#425A73"/>
                      <DatePicker x:Name="RegistroStart" Width="150"/>
                    </StackPanel>
                    <StackPanel Margin="4">
                      <TextBlock Text="A FECHA" FontSize="10" FontWeight="Bold" Foreground="#425A73"/>
                      <DatePicker x:Name="RegistroEnd" Width="150"/>
                    </StackPanel>
                  </WrapPanel>
                </WrapPanel>
              </Border>

              <Border Style="{StaticResource RelationPanelCard}">
                <WrapPanel>
                  <StackPanel Margin="4"><TextBlock Text="NOMBRE TAXISTA" FontSize="10" FontWeight="Bold" Foreground="#425A73"/><TextBox x:Name="RegistroSelectedTaxista" IsReadOnly="True" Width="260"/></StackPanel>
                  <StackPanel Margin="4"><TextBlock Text="NO." FontSize="10" FontWeight="Bold" Foreground="#425A73"/><TextBox x:Name="RegistroSelectedNo" IsReadOnly="True" Width="120"/></StackPanel>
                  <StackPanel Margin="4"><TextBlock Text="FECHA" FontSize="10" FontWeight="Bold" Foreground="#425A73"/><TextBox x:Name="RegistroSelectedFecha" IsReadOnly="True" Width="180"/></StackPanel>
                  <StackPanel Margin="4"><TextBlock Text="PAX" FontSize="10" FontWeight="Bold" Foreground="#425A73"/><TextBox x:Name="RegistroSelectedPax" IsReadOnly="True" Width="120"/></StackPanel>
                </WrapPanel>
              </Border>

              <Border Style="{StaticResource ModuleGridCard}" Margin="0,0,0,10">
                <DataGrid x:Name="RegistroGrid" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="RegistroGrid_SelectionChanged" Height="280"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                          ColumnHeaderStyle="{StaticResource RelationDataGridHeader}" CellStyle="{StaticResource RelationDataGridCell}" RowStyle="{StaticResource RelationDataGridRow}" AlternationCount="2"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Folio Operacion" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding FolioOperacion}" Width="110"/>
                    <DataGridTextColumn Header="Fuente" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Fuente}" Width="95"/>
                    <DataGridTextColumn Header="Ticket" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Ticket}" Width="130"/>
                    <DataGridTextColumn Header="Gafete" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Gafete}" Width="80"/>
                    <DataGridTextColumn Header="Tickets" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding CantidadTickets}" Width="60"/>
                    <DataGridTextColumn Header="Hotel" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Hotel}" Width="150"/>
                    <DataGridTextColumn Header="Llegada/Sucursal" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding LlegadaSucursal}" Width="180"/>
                    <DataGridTextColumn Header="Fecha Vta." HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding FechaTexto}" Width="90"/>
                    <DataGridTextColumn Header="Hora" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding HoraTexto}" Width="70"/>
                    <DataGridTextColumn Header="Pax" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Pax}" Width="55"/>
                    <DataGridTextColumn Header="Taxista" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Taxista}" Width="190"/>
                    <DataGridTextColumn Header="Nacionalidad" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Nacionalidad}" Width="110"/>
                    <DataGridTextColumn Header="Tipo" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding TipoOperacion}" Width="110"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource ModuleGridCard}" Margin="0,0,10,0">
                  <StackPanel>
                    <TextBlock Text="OPERACIONES Y TICKETS" FontSize="11" FontWeight="Black" Foreground="#0F3E95" Margin="0,0,0,8"/>
                    <DataGrid x:Name="RegistroSelectedGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" Height="74" Margin="0,0,0,8"
                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              ColumnHeaderStyle="{StaticResource RelationDataGridHeader}" CellStyle="{StaticResource RelationDataGridCell}" RowStyle="{StaticResource RelationDataGridRow}" AlternationCount="2">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Folio Operacion" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding FolioOperacion}" Width="120"/>
                        <DataGridTextColumn Header="Ticket" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Ticket}" Width="150"/>
                        <DataGridTextColumn Header="Total" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Total, StringFormat=C2}" Width="90"/>
                        <DataGridTextColumn Header="Taxista" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Taxista}" Width="180"/>
                      </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Operacion seleccionada" FontSize="10" FontWeight="Bold" Foreground="#526A83"/>
                    <TextBlock x:Name="RegistroSelectedFolioHeader" FontSize="14" FontWeight="Black" Foreground="#123E6E" Margin="0,0,0,8"/>
                    <WrapPanel>
                      <StackPanel Margin="4"><TextBlock Text="GAFETE" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailGafete" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="FUENTE" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailFuente" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="USUARIO ORIGEN" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailUsuarioOrigen" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="HOTEL" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailHotel" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="LLEGADA/SUCURSAL" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailLlegada" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="ORIGEN" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailOrigen" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="SITIO" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailSitio" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="DESTINO" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailDestino" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="UNIDAD" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailUnidad" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="PLACAS" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailPlacas" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="TELEFONO" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailTelefono" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                      <StackPanel Margin="4"><TextBlock Text="NACIONALIDAD" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="RegistroDetailNacionalidad" FontWeight="Black" TextWrapping="Wrap"/></StackPanel>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ModuleGridCard}">
                  <StackPanel>
                    <TextBlock Text="FORMA DE PAGO" FontSize="11" FontWeight="Black" Foreground="#0F3E95" Margin="0,0,0,8"/>
                    <DataGrid x:Name="RegistroPaymentGrid" IsReadOnly="True" AutoGenerateColumns="False" HeadersVisibility="Column" Height="118"
                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              ColumnHeaderStyle="{StaticResource RelationDataGridHeader}" CellStyle="{StaticResource RelationDataGridCell}" RowStyle="{StaticResource RelationDataGridRow}" AlternationCount="2">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Tipo" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Campo}" Width="110"/>
                        <DataGridTextColumn Header="Total" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Valor}" Width="100"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
            </StackPanel>
            </Viewbox>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Registro App Movil">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <Border Background="#FFFFFF" BorderBrush="#C5D4E3" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                      <TextBlock Text="Sucursal:" FontSize="12" FontWeight="ExtraBold" Foreground="#173652" VerticalAlignment="Center"/>
                      <ComboBox x:Name="BranchSelector" Width="180" Margin="10,0,0,0" SelectionChanged="BranchSelector_SelectionChanged" DisplayMemberPath="Name" SelectedValuePath="Code"/>
                      <TextBlock x:Name="BranchModeIndicator" Text="Modo solo lectura" FontSize="11" FontWeight="Bold" Foreground="#B23A3A" Margin="20,0,0,0" Visibility="Collapsed" VerticalAlignment="Center"/>
                    </StackPanel>
