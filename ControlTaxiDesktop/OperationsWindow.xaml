                            GridLinesVisibility="None"
                            BorderThickness="0"
                            Background="Transparent"
                            ColumnHeaderStyle="{StaticResource RelationDataGridHeader}"
                            CellStyle="{StaticResource RelationDataGridCell}"
                            RowStyle="{StaticResource RelationDataGridRow}"
