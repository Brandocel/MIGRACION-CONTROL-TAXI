                  </UniformGrid>
                  <TextBlock x:Name="ReportResult" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="4,0,4,10"/>
                </StackPanel>
              </Border>
              <Grid Grid.Row="4" MinWidth="1480">
                <Grid.RowDefinitions>
                  <RowDefinition Height="3*"/>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource ModuleGridCard}" Margin="0,0,0,10">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="4,2,4,8">
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Vista previa" FontSize="10" FontWeight="Bold" Foreground="#6A7789"/>
                        <TextBlock x:Name="ReportPreviewHeaderText" Text="Reporte de operaciones total" FontSize="13" FontWeight="Black" Foreground="#1F5784"/>
                      </StackPanel>
                      <TextBlock x:Name="ReportPreviewMetaText" DockPanel.Dock="Right" Text="-" FontSize="12" FontWeight="SemiBold" Foreground="#425A73" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Grid Grid.Row="1">
                      <DataGrid x:Name="ReportOperationsGrid" IsReadOnly="True" AutoGenerateColumns="False" Margin="4" HeadersVisibility="Column" GridLinesVisibility="None"
                                BorderThickness="0" Background="Transparent"
                                ColumnHeaderStyle="{StaticResource RelationDataGridHeader}" CellStyle="{StaticResource RelationDataGridCell}" RowStyle="{StaticResource RelationDataGridRow}" AlternationCount="2"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True"
                                CanUserResizeColumns="True" CanUserReorderColumns="True" FrozenColumnCount="2"
                                MinHeight="300">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Folio original" Binding="{Binding FolioOriginal}" MinWidth="100" Width="100"/>
                          <DataGridTextColumn Header="Folio local" Binding="{Binding FolioLocal}" MinWidth="100" Width="100"/>
                          <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha}" MinWidth="140" Width="140"/>
                          <DataGridTextColumn Header="Taxista" Binding="{Binding Taxista}" MinWidth="180" Width="220"/>
                          <DataGridTextColumn Header="Gafete" Binding="{Binding Gafete}" MinWidth="90" Width="90"/>
                          <DataGridTextColumn Header="PAX" Binding="{Binding Pax, StringFormat={}{0:0}}" MinWidth="70" Width="70"/>
                          <DataGridTextColumn Header="Hotel" Binding="{Binding Hotel}" MinWidth="180" Width="220"/>
                          <DataGridTextColumn Header="Origen" Binding="{Binding Origen}" MinWidth="180" Width="220"/>
                          <DataGridTextColumn Header="Destino" Binding="{Binding Destino}" MinWidth="180" Width="220"/>
                          <DataGridTextColumn Header="Sucursal" Binding="{Binding Sitio}" MinWidth="130" Width="140"/>
                          <DataGridTextColumn Header="Unidad" Binding="{Binding Unidad}" MinWidth="100" Width="100"/>
                          <DataGridTextColumn Header="Placas" Binding="{Binding Placas}" MinWidth="100" Width="110"/>
                          <DataGridTextColumn Header="Tipo servicio" Binding="{Binding TipoServicio}" MinWidth="170" Width="190"/>
                          <DataGridTextColumn Header="Dejada" Binding="{Binding Dejada, StringFormat=C2}" MinWidth="100" Width="100"/>
                          <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" MinWidth="110" Width="110"/>
                          <DataGridTextColumn Header="Comisión" Binding="{Binding Comision, StringFormat=C2}" MinWidth="110" Width="110"/>
                          <DataGridTextColumn Header="Pago" Binding="{Binding Pago, StringFormat=C2}" MinWidth="110" Width="110"/>
                          <DataGridTextColumn Header="Estado pago" Binding="{Binding Estatus}" MinWidth="120" Width="120"/>
                          <DataGridTextColumn Header="Fecha pago" Binding="{Binding FechaPago}" MinWidth="150" Width="150"/>
                          <DataGridTextColumn Header="Usuario pago" Binding="{Binding UsuarioPago}" MinWidth="130" Width="150"/>
                          <DataGridTextColumn Header="Ticket pago" Binding="{Binding TicketPago}" MinWidth="160" Width="180"/>
                          <DataGridTextColumn Header="Notas" Binding="{Binding Notas}" MinWidth="220" Width="260"/>
                        </DataGrid.Columns>
                      </DataGrid>
                      <DataGrid x:Name="ReportCommissionPaymentsGrid" IsReadOnly="True" AutoGenerateColumns="False" Margin="4" Visibility="Collapsed" HeadersVisibility="Column" GridLinesVisibility="None"
                                BorderThickness="0" Background="Transparent"
                                ColumnHeaderStyle="{StaticResource RelationDataGridHeader}" CellStyle="{StaticResource RelationDataGridCell}" RowStyle="{StaticResource RelationDataGridRow}" AlternationCount="2"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                ScrollViewer.CanContentScroll="True" ScrollViewer.IsDeferredScrollingEnabled="True"
                                CanUserResizeColumns="True" CanUserReorderColumns="True" FrozenColumnCount="2"
                                MinHeight="300">
                        <DataGrid.Columns>
                          <DataGridTextColumn Header="Folio original" Binding="{Binding Folio}" MinWidth="100" Width="110"/>
                          <DataGridTextColumn Header="Folio local" Binding="{Binding FolioLocal}" MinWidth="100" Width="110"/>
                          <DataGridTextColumn Header="Fecha pago" Binding="{Binding FechaPago}" MinWidth="150" Width="160"/>
                          <DataGridTextColumn Header="Taxista" Binding="{Binding Taxista}" MinWidth="180" Width="220"/>
                          <DataGridTextColumn Header="Gafete" Binding="{Binding Gafete}" MinWidth="90" Width="90"/>
                          <DataGridTextColumn Header="Transporte" Binding="{Binding Transporte}" MinWidth="170" Width="190"/>
                          <DataGridTextColumn Header="Dejada" Binding="{Binding Dejada, StringFormat=C2}" MinWidth="100" Width="100"/>
                          <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" MinWidth="110" Width="110"/>
                          <DataGridTextColumn Header="Comisión" Binding="{Binding Comision, StringFormat=C2}" MinWidth="110" Width="110"/>
                          <DataGridTextColumn Header="Pago" Binding="{Binding Pago, StringFormat=C2}" MinWidth="110" Width="110"/>
                          <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" MinWidth="120" Width="120"/>
                          <DataGridTextColumn Header="Usuario pago" Binding="{Binding UsuarioPago}" MinWidth="130" Width="140"/>
                          <DataGridTextColumn Header="Ticket pago" Binding="{Binding TicketPago}" MinWidth="160" Width="180"/>
                          <DataGridTextColumn Header="Sitio" Binding="{Binding Sitio}" MinWidth="130" Width="140"/>
                        </DataGrid.Columns>
                      </DataGrid>
                    </Grid>
                  </Grid>
                </Border>
                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
                  <Button Margin="4" Padding="12" BorderBrush="#B6C8DA" BorderThickness="1" Background="White" Click="OpenReportMovementsModule_Click">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="MOVIMIENTOS" FontWeight="Black" Foreground="#1F5784"/>
                        <TextBlock Text="Registro diario" FontSize="10" Foreground="#6A7789"/>
                      </StackPanel>
                      <TextBlock DockPanel.Dock="Right" Text="ABRIR" VerticalAlignment="Center" Foreground="#B56E1E" FontWeight="Black"/>
                    </DockPanel>
                  </Button>
                  <Button Margin="4" Padding="12" BorderBrush="#B6C8DA" BorderThickness="1" Background="White" Click="OpenReportCommissionsModule_Click">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="COMISIONES" FontWeight="Black" Foreground="#1F5784"/>
                        <TextBlock Text="Control de comisiones y pagos" FontSize="10" Foreground="#6A7789"/>
                      </StackPanel>
                      <TextBlock DockPanel.Dock="Right" Text="ABRIR" VerticalAlignment="Center" Foreground="#B56E1E" FontWeight="Black"/>
                    </DockPanel>
                  </Button>
                  <Button Margin="4" Padding="12" BorderBrush="#B6C8DA" BorderThickness="1" Background="White" Click="OpenReportCutsModule_Click">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="CIERRES" FontWeight="Black" Foreground="#1F5784"/>
                        <TextBlock Text="Corte del día" FontSize="10" Foreground="#6A7789"/>
                      </StackPanel>
                      <TextBlock DockPanel.Dock="Right" Text="ABRIR" VerticalAlignment="Center" Foreground="#B56E1E" FontWeight="Black"/>
                    </DockPanel>
                  </Button>
                  <Button Margin="4" Padding="12" BorderBrush="#B6C8DA" BorderThickness="1" Background="White" Click="OpenReportPaymentsModule_Click">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="PAGOS COMISION" FontWeight="Black" Foreground="#1F5784"/>
                        <TextBlock Text="Pagos generados y descargables" FontSize="10" Foreground="#6A7789"/>
                      </StackPanel>
                      <TextBlock DockPanel.Dock="Right" Text="ABRIR" VerticalAlignment="Center" Foreground="#0B8C74" FontWeight="Black"/>
                    </DockPanel>
                  </Button>
                </UniformGrid>
                <Border Grid.Row="2" Style="{StaticResource ModuleGridCard}">
                  <StackPanel>
                    <TextBlock Text="Vista imprimible" FontSize="10" FontWeight="Bold" Foreground="#6A7789" Margin="0,0,0,8"/>
                    <TextBox x:Name="ReportPrintPreviewText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" MinHeight="180"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
              </Viewbox>
            </Grid>
            </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</Window>
