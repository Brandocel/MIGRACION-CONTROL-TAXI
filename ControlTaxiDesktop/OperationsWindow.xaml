                    <Border Background="White" BorderBrush="#D4E0EC" BorderThickness="1" Margin="4" Padding="12"><StackPanel><TextBlock x:Name="ReportPaxLabelText" Text="PAX" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="ReportPaxText" FontSize="22" FontWeight="Black" Text="0" Foreground="#123E6E"/></StackPanel></Border>
                    <Border Background="White" BorderBrush="#D4E0EC" BorderThickness="1" Margin="4" Padding="12"><StackPanel><TextBlock x:Name="ReportAmountLabelText" Text="IMPORTE" FontSize="10" FontWeight="Bold" Foreground="#526A83"/><TextBlock x:Name="ReportAmountText" FontSize="22" FontWeight="Black" Text="$0.00" Foreground="#123E6E"/></StackPanel></Border>
