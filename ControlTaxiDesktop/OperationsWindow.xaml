                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            ScrollViewer.CanContentScroll="True">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="App / asignado" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="190">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Margin="2">
                          <Border Background="#EAF6FE" BorderBrush="#B9D3EF" BorderThickness="1" CornerRadius="8" Padding="6,2" HorizontalAlignment="Left" Margin="0,0,0,5">
                            <TextBlock Text="{Binding Source, Converter={StaticResource UpperCaseConverter}}" FontSize="9" FontWeight="Black" Foreground="#285C88"/>
                          </Border>
                          <TextBlock Text="{Binding SourceUser, StringFormat='Usuario origen: {0}'}" FontSize="9" Foreground="#6A7789"/>
                          <TextBlock Text="{Binding DisplayLocalFolio, StringFormat='Folio local: {0}'}" FontWeight="Black" Foreground="#1F5784" FontSize="13"/>
                          <TextBlock Text="{Binding OperationFolio, StringFormat='Folio original: {0}'}" FontSize="10" Foreground="#6A7789"/>
                          <TextBlock FontSize="9" Foreground="#1F5784" FontWeight="Bold">
                            <TextBlock.Style><Style TargetType="TextBlock">
                              <Setter Property="Text" Value="{Binding PosFolio, StringFormat='Ticket POS: {0}'}"/>
                              <Style.Triggers><DataTrigger Binding="{Binding PosFolio}" Value=""><Setter Property="Text" Value="SIN TICKET POS"/></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                          </TextBlock>
                          <Button Content="EDITAR" Click="LoadRelation_Click" HorizontalAlignment="Left" Padding="0" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Foreground="#1F5784" FontSize="10" FontWeight="Bold" Cursor="Hand"/>
                        </StackPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Fecha" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding DateText}" Width="120"/>
                    <DataGridTemplateColumn Header="Viaje" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="190">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Margin="2">
                          <TextBlock Text="{Binding Hotel}" FontWeight="Bold" TextWrapping="Wrap" Foreground="#16326B"/>
                          <TextBlock FontSize="10" Foreground="#6A7789" TextWrapping="Wrap"><Run Text="{Binding Origin, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Site, Mode=OneWay}"/></TextBlock>
                          <TextBlock FontSize="10" Foreground="#6A7789" TextWrapping="Wrap"><Run Text="{Binding Unit, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding Phone, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Taxista" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="170">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Margin="2">
                          <TextBlock Text="{Binding Driver}" FontWeight="Bold" Foreground="#1F5784" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding TaxistaId, StringFormat='ID: {0}'}" FontSize="10" Foreground="#6A7789"/>
                          <TextBlock FontSize="10" Foreground="#6A7789" TextWrapping="Wrap"><Run Text="Gafete: "/><Run Text="{Binding Badge, Mode=OneWay}"/></TextBlock>
                          <TextBlock FontSize="10" Foreground="#0B5FA5" FontWeight="Bold" TextWrapping="Wrap"><Run Text="Vendedor: "/><Run Text="{Binding Vendor, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Nacionalidad" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Binding="{Binding Nationality}" Width="110"/>
                    <DataGridTemplateColumn Header="Unidad" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="100">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Margin="2">
                          <TextBlock Text="{Binding TransportType}" FontWeight="Bold" TextWrapping="Wrap" Foreground="#16326B"/>
                          <TextBlock Text="{Binding Unit}" FontSize="10" Foreground="#6A7789"/>
                        </StackPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Importes" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="130">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Margin="2">
                          <TextBlock FontSize="10" FontWeight="Bold" Foreground="#16326B"><Run Text="Venta: "/><Run Text="{Binding SaleDisplay, Mode=OneWay}"/></TextBlock>
                          <TextBlock FontSize="11" FontWeight="Bold" Foreground="#7A5600"><Run Text="Dejada: "/><Run Text="{Binding Payout, StringFormat=C2, Mode=OneWay}"/></TextBlock>
                          <TextBlock FontSize="10" Foreground="#16326B"><Run Text="Comision: "/><Run Text="{Binding CommissionDisplay, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pago dejada" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="190">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Margin="2">
                          <Border Background="{Binding PayoutStatus, Converter={StaticResource StatusBackgroundConverter}}"
                                  BorderBrush="{Binding PayoutStatus, Converter={StaticResource StatusBorderConverter}}"
                                  BorderThickness="1" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" Margin="0,0,0,5">
                            <TextBlock Text="{Binding PayoutStatus, Converter={StaticResource UpperCaseConverter}}" FontSize="9" FontWeight="Black"
                                       Foreground="{Binding PayoutStatus, Converter={StaticResource StatusForegroundConverter}}"/>
                          </Border>
                          <TextBlock Text="{Binding PayoutTicket, StringFormat='Ticket: {0}'}" FontSize="9" Foreground="#6A7789" TextWrapping="Wrap"/>
                          <TextBlock Text="{Binding PayoutUser,   StringFormat='Usuario: {0}'}" FontSize="9" Foreground="#6A7789"/>
                          <TextBlock Text="{Binding PayoutDate,   StringFormat='Fecha: {0}'}"   FontSize="9" Foreground="#6A7789"/>
                          <TextBlock FontSize="9" Foreground="#6A7789"><Run Text="Pagado "/><Run Text="{Binding PayoutPaid, StringFormat=C2, Mode=OneWay}"/></TextBlock>
                        </StackPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Forma de pago" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="170">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Margin="2" TextWrapping="Wrap" Text="{Binding PaymentMethod}" Foreground="#16326B"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Moneda" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="90">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Margin="2" TextWrapping="Wrap" Text="{Binding Currency}" Foreground="#16326B"/></DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Comision" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="120">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Margin="2">
                          <Border Background="{Binding CommissionStatus, Converter={StaticResource StatusBackgroundConverter}}"
                                  BorderBrush="{Binding CommissionStatus, Converter={StaticResource StatusBorderConverter}}"
                                  BorderThickness="1" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" Margin="0,0,0,4">
                            <TextBlock Text="{Binding CommissionStatus, Converter={StaticResource UpperCaseConverter}}" FontSize="9" FontWeight="Black"
                                       Foreground="{Binding CommissionStatus, Converter={StaticResource StatusForegroundConverter}}"/>
                          </Border>
                          <TextBlock Text="{Binding Commission, StringFormat=C2}" FontSize="10" FontWeight="Bold" Foreground="#1F5784" Margin="0,0,0,4"/>
                        </StackPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Accion" HeaderTemplate="{StaticResource WhiteGridHeaderTemplate}" Width="230">
                      <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <WrapPanel>
                          <Button Content="VENTA"    Style="{StaticResource RelationGridActionButton}" Click="RelationSale_Click"/>
                          <Button Content="PAGAR"    Style="{StaticResource RelationGridActionButton}" Click="RelationPay_Click"
                                  Visibility="{Binding PayoutStatus, Converter={StaticResource PaidStatusVisibilityConverter}}"/>
                          <Button Content="IMPRIMIR" Style="{StaticResource RelationGridActionButton}" Click="RelationPrint_Click"
                                  Visibility="{Binding PayoutStatus, Converter={StaticResource PaidStatusVisibilityConverter}, ConverterParameter=PaidOnly}"/>
                        </WrapPanel>
                      </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                  </DataGrid>
                </Border>
              </Grid>
            </Border>

          </StackPanel>
            </Viewbox>
          </Grid>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="Reportes">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
