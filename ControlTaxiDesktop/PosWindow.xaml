                  <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                      <TextBlock Text="CIERRES" FontWeight="Black" Foreground="#1F5784"/>
                      <TextBlock Text="Corte del dia" FontSize="10" Foreground="#6A7789"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="ABRIR" VerticalAlignment="Center" Foreground="#B56E1E" FontWeight="Black"/>
                  </DockPanel>
                </Button>
                <Button Width="300" Style="{StaticResource ReportCardButton}" Click="OpenReportPaymentsModule_Click">
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                      <TextBlock Text="PAGOS COMISION" FontWeight="Black" Foreground="#1F5784"/>
                      <TextBlock Text="Pagos generados y descargables" FontSize="10" Foreground="#6A7789"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Right" Text="ABRIR" VerticalAlignment="Center" Foreground="#0B8C74" FontWeight="Black"/>
                  </DockPanel>
                </Button>
              </WrapPanel>
              <Border Grid.Row="2" Style="{StaticResource DashboardPanelCard}" Padding="16">
                <StackPanel>
                  <TextBlock Text="Vista imprimible" FontSize="10" FontWeight="Bold" Foreground="#6A7789" Margin="0,0,0,8"/>
                  <Border BorderBrush="#D8E1EC" BorderThickness="1" Background="#FFFFFF" Padding="14">
                    <TextBox x:Name="ReportPrintPreviewText"
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             MinHeight="220"/>
                  </Border>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>
            </Viewbox>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Auditoria">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10" MinWidth="1320">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Style="{StaticResource FormPanel}">
                <WrapPanel><DatePicker x:Name="AuditStart"/><DatePicker x:Name="AuditEnd"/></WrapPanel>
              </Border>
              <DataGrid x:Name="AuditGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True"/>
            </Grid>
            <StackPanel Grid.Column="1" Style="{StaticResource WebActionSidebar}">
              <Button Content="BUSCAR" Style="{StaticResource WebActionButton}" Click="RefreshAudit_Click"/>
              <Button Content="MENU" Style="{StaticResource WebActionButton}" Click="CloseWindow_Click"/>
              <Button Content="SALIR" Style="{StaticResource WebActionRedButton}" Click="CloseWindow_Click"/>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Grid>
  </Border>
</Window>
