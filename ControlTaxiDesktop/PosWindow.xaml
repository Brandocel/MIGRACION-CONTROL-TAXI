      </TabControl>

      <!-- ===== Cajon lateral de DETALLE (flotante) =====
           Vive aqui, como hijo directo del Grid raiz y con RowSpan="2", para cubrir TAMBIEN la
           barra de titulo de arriba. Antes estaba dentro de la pestaña de Comisiones y por eso
           se cortaba en la parte superior. Va al final del XAML para dibujarse encima de todo.
           Solo se abre con el boton DETALLE de cada fila. -->
      <Border x:Name="CommissionDetailScrim" Grid.RowSpan="2" Background="#33000B1F" Visibility="Collapsed" MouseLeftButtonDown="CommissionDetailScrim_MouseLeftButtonDown"/>

      <!-- Panel del TICKET: se abre AL LADO del cajon de detalle, no debajo de sus campos.
           El Margin derecho de 420 lo recorre justo el ancho del cajon, de modo que los dos
           quedan uno junto al otro como en el admin web. -->
      <Border x:Name="CommissionTicketPanel" Grid.RowSpan="2"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Width="380" Margin="0,0,420,0"
              Background="#F7F9FC" BorderBrush="#D7E2F2" BorderThickness="1,0,1,0"
              Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.16" Color="#0B1F3F"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E3EAF5" BorderThickness="0,0,0,1" Padding="18,14">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="TICKET DE COMISIÓN" FontSize="13" FontWeight="Black" Foreground="#16326B" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="Cerrar" Style="{StaticResource SquareLinkButton}" Click="CloseCommissionTicketPanel_Click"/>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,16">
            <Border Background="#FFFFFF" BorderBrush="#DCE5F2" BorderThickness="1" Padding="14">
              <TextBlock x:Name="CommissionTicketText" FontFamily="Consolas" FontSize="11" Foreground="#16326B" TextWrapping="Wrap"/>
            </Border>
          </ScrollViewer>
          <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E3EAF5" BorderThickness="0,1,0,0" Padding="18,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="GUARDAR TXT" Style="{StaticResource SquareChipButton}" Click="SaveCommissionTicketFromPanel_Click"/>
              <Button Content="IMPRIMIR" Style="{StaticResource SquarePrimaryButton}" Padding="14,8" FontSize="11" Click="PrintCommissionTicketFromPanel_Click"/>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
      <Border x:Name="CommissionDetailPanel" Grid.RowSpan="2"
              HorizontalAlignment="Right" VerticalAlignment="Stretch"
              Width="420" MaxWidth="520"
              Background="#F7F9FC" BorderBrush="#D7E2F2" BorderThickness="1,0,0,0"
              Visibility="Collapsed">
        <Border.Effect>
          <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.22" Color="#0B1F3F"/>
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- Encabezado fijo del cajon: titulo, folio, estatus y acciones. -->
          <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E3EAF5" BorderThickness="0,0,0,0" Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="DETALLE DE COMISIÓN" FontSize="14" FontWeight="Black" Foreground="#16326B"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <TextBlock x:Name="CommissionDetailFolio" FontSize="12" FontWeight="Bold" Foreground="#5A7096" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                  <Border x:Name="CommissionDetailStatusBadge" Background="#E4F6EC" CornerRadius="2" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CommissionDetailStatusText" Text="PAGADA" FontSize="9" FontWeight="Black" Foreground="#0F7A44"/>
                  </Border>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="CommissionShowTicketButton" Content="TICKET" ToolTip="Ver el ticket de esta comision"
                        Style="{StaticResource SquareChipButton}" Margin="0,0,8,0" Click="ShowCommissionTicket_Click"/>
                <Button Content="✕" ToolTip="Cerrar" Width="28" Height="28" Padding="0"
                        Style="{StaticResource SquareChipButton}" Margin="0" FontSize="12"
                        Click="CloseCommissionDetail_Click"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Pestañas: la venta completa ya no es un boton que apila contenido abajo, sino su
               propia pestaña, como en el admin web. Son RadioButton del mismo GroupName, asi
               que la exclusividad la resuelve WPF sin codigo extra. -->
          <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E3EAF5" BorderThickness="0,0,0,1" Padding="18,0">
            <StackPanel Orientation="Horizontal">
              <RadioButton x:Name="CommissionTabGeneralButton" Content="GENERAL" GroupName="CommissionDetailTabs" IsChecked="True"
                           Style="{StaticResource SquareTabRadio}" Checked="CommissionDetailTab_Changed"/>
              <RadioButton x:Name="CommissionTabSaleButton" Content="VENTA COMPLETA" GroupName="CommissionDetailTabs"
                           Style="{StaticResource SquareTabRadio}" Checked="CommissionDetailTab_Changed"/>
            </StackPanel>
          </Border>

          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="18,16">
            <StackPanel>
              <!-- Los campos ya no van sueltos: se agrupan en una tarjeta, como el panel de
                   referencia. El ancho es fluido (sin Width fijo) para que el cajon sea
                   responsivo si cambia su tamaño. -->
              <Border x:Name="CommissionTabGeneralContent" Background="#FFFFFF" BorderBrush="#E3EAF5" BorderThickness="1" Padding="14">
                <StackPanel>
                  <TextBlock Text="INFORMACIÓN DE LA VENTA" FontSize="10" FontWeight="Black" Foreground="#6B7FA6" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="CommissionDetailFields">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="{Binding LineBrush}" BorderThickness="0,0,0,1" Padding="0,7"
                                Background="{Binding RowBackground}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="{Binding LabelMargin}">
                              <TextBlock Text="{Binding Label}" FontSize="{Binding LabelSize}" FontWeight="{Binding LabelWeight}"
                                         Foreground="{Binding LabelBrush}" TextWrapping="Wrap"/>
                              <!-- La explicacion en palabras simples va debajo de la etiqueta: el
                                   panel lo usan capturistas, no contadores. -->
                              <TextBlock Text="{Binding Hint}" Visibility="{Binding HintVisibility}" FontSize="10"
                                         Foreground="#8496B4" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{Binding ValueSize}"
                                       FontWeight="{Binding ValueWeight}" Foreground="{Binding ValueBrush}"
                                       TextAlignment="Right" TextWrapping="Wrap" Margin="10,0,0,0" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border x:Name="CommissionSaleLinesPanel" Visibility="Collapsed" Background="#FFFFFF" BorderBrush="#E3EAF5" BorderThickness="1" Padding="14">
                <StackPanel>
                  <TextBlock Text="RENGLONES DE LA VENTA" FontSize="10" FontWeight="Black" Foreground="#6B7FA6" Margin="0,0,0,8"/>
                  <TextBlock x:Name="CommissionSaleLinesLoading" Text="Cargando venta…" Visibility="Collapsed" FontSize="11" Foreground="#6880A6" TextWrapping="Wrap"/>
                  <TextBlock x:Name="CommissionSaleLinesEmpty" Text="Sin renglones de venta para este ticket." Visibility="Collapsed" FontSize="11" Foreground="#6880A6" TextWrapping="Wrap"/>
                  <ItemsControl x:Name="CommissionSaleLines">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border BorderBrush="#EFF3F9" BorderThickness="0,0,0,1" Padding="0,7">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                              <TextBlock Text="{Binding Producto}" FontSize="11" FontWeight="SemiBold" Foreground="#16326B" TextWrapping="Wrap"/>
                              <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Cantidad}" FontSize="10" Foreground="#6880A6"/>
                                <TextBlock Text=" × " FontSize="10" Foreground="#6880A6"/>
                                <TextBlock Text="{Binding Precio, StringFormat=C2}" FontSize="10" Foreground="#6880A6"/>
                              </StackPanel>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Importe, StringFormat=C2}" FontSize="11" FontWeight="Bold" Foreground="#16326B" VerticalAlignment="Center" Margin="10,0,0,0"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
