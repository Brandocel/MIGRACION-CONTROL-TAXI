<Window x:Class="ControlTaxiDesktop.PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:ControlTaxiDesktop.Behaviors"
        xmlns:conv="clr-namespace:ControlTaxiDesktop.Converters"
        Title="Control Taxi Â· POS local"
        Width="1280"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#DDECF7">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Styles/SharedFilterStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <!-- Mismos converters de color de estatus que usa Relacion Ticket-Taxista, para que un
           "PAGADA" se vea igual en las dos pantallas. -->
      <conv:UpperCaseConverter x:Key="UpperCaseConverter"/>
      <conv:StatusBackgroundConverter x:Key="StatusBackgroundConverter"/>
      <conv:StatusForegroundConverter x:Key="StatusForegroundConverter"/>
      <conv:StatusBorderConverter x:Key="StatusBorderConverter"/>
    <Style x:Key="FormPanel" TargetType="Border">
      <Setter Property="Background" Value="#F8FCFF"/>
      <Setter Property="BorderBrush" Value="#B6C8DA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="#425A73"/>
      <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    <Style x:Key="HiddenWebTabItem" TargetType="{x:Type TabItem}">
      <Setter Property="Height" Value="0"/>
      <Setter Property="Width" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style x:Key="ReportToolbarButton" TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="BorderBrush" Value="#C4D0DE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#4D6074"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ReportToolbarAccentButton" BasedOn="{StaticResource ReportToolbarButton}" TargetType="Button">
      <Setter Property="BorderBrush" Value="#E7C88A"/>
      <Setter Property="Background" Value="#FFF8E8"/>
      <Setter Property="Foreground" Value="#7B5314"/>
    </Style>
    <Style x:Key="ReportTabItemStyle" TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="#31506C"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#B6C8DA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#0F988F"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderBrush" Value="#0F988F"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ReportCardButton" TargetType="Button">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="BorderBrush" Value="#D7E2EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style x:Key="DashboardPanelCard" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7E2F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="DashboardHeroCard" TargetType="Border" BasedOn="{StaticResource DashboardPanelCard}">
      <Setter Property="Padding" Value="16"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="BorderBrush" Value="#0B3D9B"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A3D99" Offset="0"/>
            <GradientStop Color="#1855CB" Offset="0.56"/>
            <GradientStop Color="#0B3C99" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DashboardActionButtonBase" TargetType="Button">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0F3E95"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7E2F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="4,4,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="108"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DashboardPrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#1347B8"/>
      <Setter Property="BorderBrush" Value="#0D368A"/>
    </Style>
    <Style x:Key="DashboardSuccessButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#17A65A"/>
      <Setter Property="BorderBrush" Value="#118349"/>
    </Style>
    <Style x:Key="DashboardGoldButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="#C77C00"/>
      <Setter Property="Background" Value="#FFF8E5"/>
      <Setter Property="BorderBrush" Value="#F2C766"/>
    </Style>
    <Style x:Key="DashboardDangerButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="#D62828"/>
      <Setter Property="Background" Value="#FFF6F6"/>
      <Setter Property="BorderBrush" Value="#F0B5B5"/>
    </Style>
    <Style x:Key="DashboardGridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Background" Value="#0E4DB7"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="12,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#1C63D2"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="White">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DashboardGridCell" TargetType="DataGridCell">
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <!-- Borde derecho + inferior en cada celda: asi se ven las lineas de columna y de fila
           sin usar GridLinesVisibility, que dibuja lineas dobles junto a estos bordes. -->
      <Setter Property="BorderBrush" Value="#DCE5F2"/>
      <Setter Property="BorderThickness" Value="0,0,1,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#16326B"/>
    </Style>
    <Style x:Key="DashboardGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#16326B"/>
      <Setter Property="BorderBrush" Value="#E3ECF8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <!-- Gris alterno visible: el #F9FBFF anterior era casi blanco y no se distinguia. -->
        <Trigger Property="AlternationIndex" Value="1">
          <Setter Property="Background" Value="#EFF4FB"/>
        </Trigger>
        <!-- Mas saturados que antes: con el gris alterno nuevo, los tonos previos
             (#EEF5FF / #E6F0FF) quedaban casi iguales al de la fila par. -->
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#DBE8FA"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#C7DCF7"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <!-- Sin margen ni marco exterior: la ventana aprovecha todo el ancho disponible.
       Antes habia tres marcos anidados (este + el TabControl + el Grid de cada pestaña)
       que sumaban ~38px por lado. -->
  <Border Background="#E6F3FC" BorderThickness="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Background="#FAF8F8" BorderBrush="#B6C8DA" BorderThickness="0,0,0,1">
        <TextBlock x:Name="TitleBarText" Text="VENTAS" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#304A65"/>
      </Border>

      <TabControl x:Name="PosTabs" Grid.Row="1" Margin="0" Padding="0" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource HiddenWebTabItem}">
        <TabItem Header="Ventas">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Style="{StaticResource FormPanel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="BUSCAR PRODUCTO / FOLIO / NOMBRE / HOTEL / GAFETE" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="SaleFolio" Height="34" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="CLIENTE" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="SaleCustomer" Height="34" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="REFERENCIA" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductCode" Height="34" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <Button Grid.Column="3" Content="BUSCAR" Width="110" Height="34" Margin="10,20,8,0" Style="{StaticResource WebActionButton}" Click="RefreshSales_Click"/>
                  <Button Grid.Column="4" Content="LIMPIAR" Width="110" Height="34" Margin="0,20,0,0" Style="{StaticResource WebActionButton}" Click="ClearSalesSearch_Click"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource FormPanel}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="4">
                    <TextBlock Text="CLIENTE / PRODUCTO" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductName" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="SUBTOTAL" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductPrice" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="IVA" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductTax" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="TOTAL" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductStock" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="2" Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="0,0,0,10">
                <UniformGrid Columns="6">
                  <StackPanel Margin="8"><TextBlock Text="FECHA" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleDateText" Text="HOY" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="SUBTOTAL" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleSubtotalText" Text="0.00" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="IVA" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleTaxText" Text="0.00" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="TOTAL" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleTotalText" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#0F8F83"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="DEJADA" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SalePayoutText" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#1F5784"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="COMISION" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleCommissionText" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#B06B00"/></StackPanel>
                </UniformGrid>
              </Border>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.58*"/></Grid.ColumnDefinitions>
                <Border Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="0,0,6,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TICKET ACTUAL / VENTA SELECCIONADA" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="ProductsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="45*" MinWidth="42"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="170*" MinWidth="110"/>
                        <DataGridTextColumn Header="Departamento" Binding="{Binding Departamento}" Width="120*" MinWidth="80"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="75*" MinWidth="65"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" Width="78*" MinWidth="68"/>
                        <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}" Width="100*" MinWidth="70"/>
                        <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" Width="88*" MinWidth="60"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaVenta}" Width="105*" MinWidth="75"/>
                        <DataGridTextColumn Header="Origen" Binding="{Binding OrigenVenta}" Width="65*" MinWidth="55"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="6,0,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RESULTADOS DE CONSULTA / VENTAS" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="SalesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionChanged="SalesGrid_SelectionChanged" MouseDoubleClick="OpenRemissionDetail_Click">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticket" Binding="{Binding Folio}" Width="135"/>
                        <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" Width="95"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="150"/>
                        <DataGridTextColumn Header="Vendedor" Binding="{Binding Vendedor}" Width="170"/>
                        <DataGridTextColumn Header="Taxista" Binding="{Binding Taxista}" Width="170"/>
                        <DataGridTextColumn Header="Folio Reg." Binding="{Binding FolioRegistro}" Width="90"/>
                        <DataGridTextColumn Header="Gafete" Binding="{Binding Gafete}" Width="80"/>
                        <DataGridTextColumn Header="Transporte" Binding="{Binding Transporte}" Width="110"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="95"/>
                        <DataGridTextColumn Header="IVA" Binding="{Binding Iva, StringFormat=C2}" Width="85"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="95"/>
                        <DataGridTextColumn Header="Pagos encontrados" Binding="{Binding TotalPagos, StringFormat=C2}" Width="130"/>
                        <DataGridTextColumn Header="Diferencia pago" Binding="{Binding DiferenciaPago, StringFormat=C2}" Width="120"/>
                        <DataGridTextColumn Header="Forma pago" Binding="{Binding FormaPagoDetalle}" Width="190"/>
                        <DataGridTextColumn Header="Moneda" Binding="{Binding MonedaDetalle}" Width="110"/>
                        <DataGridTextColumn Header="Origen" Binding="{Binding OrigenVenta}" Width="75"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>
            <StackPanel Grid.Column="1" Style="{StaticResource WebActionSidebar}">
              <Button Content="BORRA LINEA" Style="{StaticResource WebActionRedButton}" Click="DeleteLinePending_Click"/>
              <Button Content="NUEVO" Style="{StaticResource WebActionGoldButton}" Click="NewSale_Click"/>
              <Button Content="COBRAR" Style="{StaticResource WebActionGreenButton}" Click="CreateSale_Click"/>
              <Button Content="CONSULTA PRECIOS" Style="{StaticResource WebActionButton}" Click="RefreshSales_Click"/>
              <Button Content="CORTE" Style="{StaticResource WebActionGoldButton}" Click="OpenCuts_Click"/>
              <Button Content="GASTOS" Style="{StaticResource WebActionButton}" Click="OpenExpenses_Click"/>
              <Button Content="TICKETS" Style="{StaticResource WebActionButton}" Click="OpenTickets_Click"/>
              <Button Content="EXCEL" Style="{StaticResource WebActionButton}" Click="ExportSalesExcel_Click"/>
              <Button Content="PDF" Style="{StaticResource WebActionButton}" Click="ExportSalesPdf_Click"/>
              <Button Content="MENU" Style="{StaticResource WebActionButton}" Click="CloseWindow_Click"/>
              <Button Content="SALIR" Style="{StaticResource WebActionRedButton}" Click="CloseWindow_Click"/>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Pagos">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource FormPanel}">
                <WrapPanel>
                  <TextBox x:Name="PaymentSaleFolio" Width="150" ToolTip="Folio venta"/>
                  <TextBox x:Name="PaymentAmount" Width="100" Text="0"/>
                  <ComboBox x:Name="PaymentMethod" Width="120" SelectedIndex="0"><ComboBoxItem Content="Efectivo"/><ComboBoxItem Content="Tarjeta"/></ComboBox>
                  <TextBox x:Name="PaymentNotes" Width="340" ToolTip="Notas"/>
                </WrapPanel>
              </Border>
              <DataGrid x:Name="PaymentsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True"/>
            </Grid>
            <StackPanel Grid.Column="1" Style="{StaticResource WebActionSidebar}">
              <Button Content="REGISTRAR PAGO" Style="{StaticResource WebActionSaveButton}" Click="RegisterPayment_Click"/>
              <Button Content="CSV" Style="{StaticResource WebActionGreenButton}" Click="ExportPaymentsCsv_Click"/>
              <Button Content="PDF" Style="{StaticResource WebActionButton}" Click="ExportPaymentsPdf_Click"/>
              <Button Content="MENU" Style="{StaticResource WebActionButton}" Click="CloseWindow_Click"/>
              <Button Content="SALIR" Style="{StaticResource WebActionRedButton}" Click="CloseWindow_Click"/>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Comisiones">
          <!-- El alto del contenido se ata al viewport del ScrollViewer y ademas tiene un
               MinHeight. En pantalla grande el Grid mide lo mismo que el viewport, no hay
               scroll de pagina y la tabla llena el espacio. En pantalla chica el MinHeight
               manda, el ScrollViewer empieza a scrollear y el encabezado se puede recorrer
               hacia arriba para darle aire a la tabla.

               El Height atado al viewport es lo que evita el problema viejo: dentro de un
               ScrollViewer el hijo recibe alto infinito, la fila Height="*" de la tabla se
               comporta como Auto, la tabla crece hasta mostrar todo y su scroll interno se
               queda sin nada que mover (por eso el arrastre con el mouse no servia). -->
          <ScrollViewer x:Name="CommissionsPageScroll" Margin="14"
                        VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="640" Height="{Binding ViewportHeight, ElementName=CommissionsPageScroll}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <!-- Encabezado compacto: titulo a la izquierda y acciones a la derecha en la
                   misma linea. El WrapPanel deja que los botones bajen de renglon solos si la
                   ventana se angosta, en vez de recortarse. -->
              <Border Style="{StaticResource SquareHeaderCard}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Border Style="{StaticResource SquareHeaderIconTile}">
                      <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconBanknote}" Stroke="White" Width="21" Height="21"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="COMISIONES" FontSize="16" FontWeight="Black" Foreground="White"/>
                      <TextBlock Text="Control de comisiones, pagos y selección de folios" FontSize="11" Foreground="#BBD3F8" Margin="0,3,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="CALCULAR" Style="{StaticResource SquareToolbarGoldButton}" Click="RecalculateCommissions_Click"/>
                    <!-- Oculto por defecto: solo se muestra si el usuario tiene la facultad
                         AutorizarPagoComision. Se activa en el Loaded de la ventana. -->
                    <Button x:Name="AuthorizeSelectedCommissionsButton" Content="AUTORIZAR" Style="{StaticResource SquareToolbarGoldButton}" Click="AuthorizeSelectedCommissions_Click" Visibility="Collapsed"/>
                    <Button Content="PAGAR" Style="{StaticResource SquareToolbarSuccessButton}" Click="PaySelectedCommissions_Click"/>
                    <!-- Aqui habia un boton BUSCAR que llamaba al mismo handler que el boton
                         APLICAR del panel de filtros. Se quito el duplicado: la busqueda vive
                         junto a los campos que la controlan. -->
                    <Button Content="CSV" Style="{StaticResource SquareToolbarGhostButton}" Click="ExportCommissionsCsv_Click"/>
                    <Button Content="PDF" Style="{StaticResource SquareToolbarGhostButton}" Click="ExportCommissionsPdf_Click"/>
                    <Button Content="IMPRIMIR" Style="{StaticResource SquareToolbarGhostButton}" Click="PrintCommissions_Click"/>
                    <Button Content="MENU" Style="{StaticResource SquareToolbarGhostButton}" Click="CloseWindow_Click"/>
                    <Button Content="SALIR" Style="{StaticResource SquareToolbarDangerButton}" Click="CloseWindow_Click"/>
                  </WrapPanel>
                </Grid>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource SquareFilterCard}">
                <StackPanel>
                  <DockPanel Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                      <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconFilter}" Stroke="#0F3E95" Margin="0,0,9,0"/>
                      <TextBlock Text="FILTROS DE BÚSQUEDA" FontSize="12" FontWeight="Black" Foreground="#16326B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CommissionFiltersToggleButton" DockPanel.Dock="Right" Content="Ocultar ▲" HorizontalAlignment="Right" Style="{StaticResource SquareLinkButton}" Click="ToggleCommissionFilters_Click"/>
                  </DockPanel>
                  <StackPanel x:Name="CommissionFiltersFieldsPanel">
                    <!-- Campos y botones en un solo renglon: los botones se alinean abajo para
                         quedar a la altura de las cajas, no de las etiquetas. Antes el boton
                         colgaba en un renglon aparte y dejaba un hueco grande. -->
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="FOLIO COMISIÓN" Style="{StaticResource SquareFieldLabel}"/>
                        <Border Style="{StaticResource SquareFieldBorder}">
                          <TextBox x:Name="CommissionFolio" ToolTip="Buscar por folio, vendedor, hotel o gafete" Style="{StaticResource DashboardTextInput}" KeyDown="CommissionFilter_KeyDown"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="2">
                        <TextBlock Text="FECHA INICIO" Style="{StaticResource SquareFieldLabel}"/>
                        <Border Style="{StaticResource SquareFieldBorder}">
                          <DatePicker x:Name="CommissionStartDate" Style="{StaticResource DashboardDateInput}"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="4">
                        <TextBlock Text="FECHA FIN" Style="{StaticResource SquareFieldLabel}"/>
                        <Border Style="{StaticResource SquareFieldBorder}">
                          <DatePicker x:Name="CommissionEndDate" Style="{StaticResource DashboardDateInput}"/>
                        </Border>
                      </StackPanel>
                      <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Style="{StaticResource SquarePrimaryButton}" Click="SearchCommissions_Click">
                          <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSearch}" Stroke="White" Margin="0,0,9,0"/>
                            <TextBlock Text="APLICAR" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button Content="LIMPIAR" Style="{StaticResource SquareSecondaryButton}" Margin="8,0,0,0" Click="ClearCommissionFilters_Click"/>
                      </StackPanel>
                    </Grid>
                    <!-- Atajos de rango: evitan teclear fechas y empujan a rangos cortos,
                         que es donde la consulta responde rapido. -->
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                      <TextBlock Text="RANGO RÁPIDO" Style="{StaticResource SquareFieldLabel}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                      <Button Content="HOY" Tag="today" Style="{StaticResource SquareChipButton}" Click="CommissionQuickRange_Click"/>
                      <Button Content="AYER" Tag="yesterday" Style="{StaticResource SquareChipButton}" Click="CommissionQuickRange_Click"/>
                      <Button Content="7 DÍAS" Tag="week" Style="{StaticResource SquareChipButton}" Click="CommissionQuickRange_Click"/>
                      <Button Content="ESTE MES" Tag="month" Style="{StaticResource SquareChipButton}" Click="CommissionQuickRange_Click"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <!-- Totales: tarjeta cuadrada con separadores verticales entre metricas y una
                   franja de color arriba de cada una para distinguirlas de un vistazo. -->
              <Border Grid.Row="2" Style="{StaticResource SquareStatCard}">
                <UniformGrid Columns="7">
                  <Border Style="{StaticResource SquareStatCell}" BorderThickness="0">
                    <StackPanel>
                      <Border Style="{StaticResource SquareStatAccent}" Background="#1E5FD0"/>
                      <TextBlock Text="VENTA" Style="{StaticResource SquareStatLabel}"/>
                      <TextBlock x:Name="CommissionTotalSaleText" Text="$0.00" Style="{StaticResource SquareStatValue}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SquareStatCell}">
                    <StackPanel>
                      <Border Style="{StaticResource SquareStatAccent}" Background="#1E5FD0"/>
                      <TextBlock Text="BASE" Style="{StaticResource SquareStatLabel}"/>
                      <TextBlock x:Name="CommissionTotalBaseText" Text="$0.00" Style="{StaticResource SquareStatValue}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SquareStatCell}">
                    <StackPanel>
                      <Border Style="{StaticResource SquareStatAccent}" Background="#0F8F83"/>
                      <TextBlock Text="COMISIÓN" Style="{StaticResource SquareStatLabel}"/>
                      <TextBlock x:Name="CommissionTotalAmountText" Text="$0.00" Style="{StaticResource SquareStatValue}" Foreground="#0F8F83"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SquareStatCell}">
                    <StackPanel>
                      <Border Style="{StaticResource SquareStatAccent}" Background="#17A65A"/>
                      <TextBlock Text="PAGADO" Style="{StaticResource SquareStatLabel}"/>
                      <TextBlock x:Name="CommissionTotalPaidText" Text="$0.00" Style="{StaticResource SquareStatValue}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SquareStatCell}">
                    <StackPanel>
                      <Border Style="{StaticResource SquareStatAccent}" Background="#E0A106"/>
                      <TextBlock Text="PENDIENTES" Style="{StaticResource SquareStatLabel}"/>
                      <TextBlock x:Name="CommissionPendingCountText" Text="0" Style="{StaticResource SquareStatValue}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SquareStatCell}">
                    <StackPanel>
                      <Border Style="{StaticResource SquareStatAccent}" Background="#17A65A"/>
                      <TextBlock Text="PAGADAS" Style="{StaticResource SquareStatLabel}"/>
                      <TextBlock x:Name="CommissionPaidCountText" Text="0" Style="{StaticResource SquareStatValue}"/>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SquareStatCell}">
                    <StackPanel>
                      <Border Style="{StaticResource SquareStatAccent}" Background="#6B7FA6"/>
                      <TextBlock Text="SELECCIONADO" Style="{StaticResource SquareStatLabel}"/>
                      <TextBlock x:Name="CommissionSelectedTotalText" Text="$0.00" Style="{StaticResource SquareStatValue}"/>
                    </StackPanel>
                  </Border>
                </UniformGrid>
              </Border>
              <Grid Grid.Row="3">
              <!-- La tabla ya no cede ancho al detalle: el panel flota encima (ver mas abajo). -->
              <Border Style="{StaticResource SquareStatCard}" Padding="0" Margin="0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <!-- El indicador de pagina se movio al paginador de abajo, que es donde se
                       espera encontrarlo; aqui queda solo el conteo de registros. -->
                  <DockPanel Margin="16,12" LastChildFill="False">
                    <TextBlock x:Name="CommissionRowsText" DockPanel.Dock="Left" Text="REGISTROS 0-0 DE 0" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                  </DockPanel>
                  <!-- behaviors:DataGridDragScroll.Enabled: se puede recorrer la tabla
                       manteniendo presionado el boton izquierdo y arrastrando, hacia abajo o
                       hacia los lados. El clic simple y el doble clic siguen igual. -->
                  <DataGrid x:Name="CommissionsGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="CommissionsGrid_MouseDoubleClick" SelectionChanged="CommissionsGrid_SelectionChanged"
                            behaviors:DataGridDragScroll.Enabled="True"
                            RowHeight="46" ColumnHeaderHeight="46"
                            BorderThickness="0" Background="Transparent" Margin="14,0,14,14"
                            ColumnHeaderStyle="{StaticResource DashboardGridHeader}" CellStyle="{StaticResource DashboardGridCell}" RowStyle="{StaticResource DashboardGridRow}" AlternationCount="2">
                    <DataGrid.Columns>
                      <!-- MinWidth en las columnas de ancho fijo: sin el, cuando la ventana es
                           mas angosta que la suma de columnas, el DataGrid las encoge hasta 20px
                           y los botones salian cortados ("AR" en vez de "PAGAR"). -->
                      <DataGridTemplateColumn Header="Sel." Width="46" MinWidth="46">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Source.PuedePagar}" Click="CommissionCheckBox_Click" HorizontalAlignment="Center" VerticalAlignment="Center" Width="18" Height="18"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <!-- Acciones por fila. Cada boton se oculta cuando no aplica: PAGAR solo
                           en comisiones pendientes (PuedePagar) y REIMPRIMIR solo en las ya
                           pagadas (PuedeImprimirTicket), asi la columna nunca ofrece algo que
                           vaya a fallar. Reemplaza a la antigua columna "Ticket". -->
                      <DataGridTemplateColumn Header="Acciones" Width="164" MinWidth="164">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <!-- Rejilla 2x2 en vez de una fila de tres: ocupa 164px en lugar de
                                 260 y cabe en pantallas angostas como la del servidor.
                                 Cada accion conserva su propio carril, asi que al ocultarse
                                 PAGAR o REIMPRIMIR las demas NO se recorren. -->
                            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                              </Grid.RowDefinitions>
                              <!-- DETALLE siempre disponible: abre el panel lateral de esta fila. -->
                              <Button Grid.Row="0" Grid.Column="0" Content="DETALLE" ToolTip="Ver el detalle de esta comision" Click="ShowCommissionDetail_Click" Style="{StaticResource SquareChipButton}" Margin="2" HorizontalAlignment="Stretch"/>
                              <!-- AUTORIZAR y PAGAR comparten el mismo lugar: nunca aplican a la
                                   vez (PAGAR exige que ya este autorizada). Sin la facultad
                                   AutorizarPagoComision este boton nunca se habilita, aunque el
                                   folio siga sin autorizar. -->
                              <Button Grid.Row="0" Grid.Column="1" Content="AUTORIZAR" ToolTip="Autoriza que esta comision se pueda pagar" Click="AuthorizeSingleCommission_Click" IsEnabled="{Binding CanShowAuthorize}" HorizontalAlignment="Stretch">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource SquareChipButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Background" Value="#B4750F"/>
                                    <Setter Property="BorderBrush" Value="#B4750F"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Style.Triggers>
                                      <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                      </Trigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                              </Button>
                              <Button Grid.Row="0" Grid.Column="1" Content="PAGAR" ToolTip="Pagar esta comision" Click="PaySingleCommission_Click" IsEnabled="{Binding Source.PuedePagar}" HorizontalAlignment="Stretch">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource SquareChipButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Setter Property="Background" Value="#17A65A"/>
                                    <Setter Property="BorderBrush" Value="#17A65A"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Style.Triggers>
                                      <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                      </Trigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                              </Button>
                              <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Content="REIMPRIMIR" ToolTip="Reimprimir el ticket de esta comision pagada" Click="PrintSingleCommissionTicket_Click" IsEnabled="{Binding Source.PuedeImprimirTicket}" HorizontalAlignment="Stretch">
                                <Button.Style>
                                  <Style TargetType="Button" BasedOn="{StaticResource SquareChipButton}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Setter Property="Margin" Value="2"/>
                                    <Style.Triggers>
                                      <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                      </Trigger>
                                    </Style.Triggers>
                                  </Style>
                                </Button.Style>
                              </Button>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <!-- Todas proporcionales (star) con un MinWidth de respaldo: asi la tabla
                           ocupa exactamente el ancho disponible sin hueco muerto a la derecha y
                           se reajusta al cambiar el tamaño de la ventana. Mezclar una sola
                           columna "*" con columnas de pixeles fijos hacia que el DataGrid le
                           diera todo el espacio a esa y encogiera las demas hasta 20px. -->
                      <DataGridTextColumn Header="Folios" Binding="{Binding Source.Folio}" Width="150*" MinWidth="95"/>
                      <DataGridTextColumn Header="Unidad" Binding="{Binding Source.Unidad}" Width="140*" MinWidth="78"/>
                      <DataGridTextColumn Header="Nombre" Binding="{Binding Source.Nombre}" Width="170*" MinWidth="100"/>
                      <DataGridTextColumn Header="Hotel" Binding="{Binding Source.Hotel}" Width="160*" MinWidth="95"/>
                      <DataGridTextColumn Header="Vnt total" Binding="{Binding Source.VentaTotal, StringFormat=C2}" Width="100*" MinWidth="72"/>
                      <DataGridTextColumn Header="F.P" Binding="{Binding Source.FormaPago}" Width="150*" MinWidth="85"/>
                      <DataGridTextColumn Header="Dejada" Binding="{Binding Source.Dejada, StringFormat=C2}" Width="90*" MinWidth="64"/>
                      <DataGridTextColumn Header="% com." Binding="{Binding Source.PorcentajeComision, StringFormat=P0}" Width="80*" MinWidth="58"/>
                      <DataGridTextColumn Header="Pago com." Binding="{Binding Source.PagoComision, StringFormat=C2}" Width="110*" MinWidth="78"/>
                      <!-- Dos estados de pago distintos y con el mismo lenguaje visual:
                           el de la DEJADA (anticipo al taxista, se paga en Relación
                           Ticket-Taxista) y el de la COMISIÓN (se paga aqui). Verde = pagado,
                           ambar = pendiente, gris = no aplica. -->
                      <DataGridTemplateColumn Header="Est. dejada" Width="105*" MinWidth="84">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SquareStatusBadge}" HorizontalAlignment="Center"
                                    Background="{Binding Source.EstatusDejada, Converter={StaticResource StatusBackgroundConverter}}"
                                    BorderBrush="{Binding Source.EstatusDejada, Converter={StaticResource StatusBorderConverter}}">
                              <TextBlock Style="{StaticResource SquareStatusBadgeText}"
                                         Text="{Binding Source.EstatusDejada, Converter={StaticResource UpperCaseConverter}}"
                                         Foreground="{Binding Source.EstatusDejada, Converter={StaticResource StatusForegroundConverter}}"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Est. comisión" Width="105*" MinWidth="84">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource SquareStatusBadge}" HorizontalAlignment="Center"
                                    Background="{Binding Source.Estatus, Converter={StaticResource StatusBackgroundConverter}}"
                                    BorderBrush="{Binding Source.Estatus, Converter={StaticResource StatusBorderConverter}}">
                              <TextBlock Style="{StaticResource SquareStatusBadgeText}"
                                         Text="{Binding Source.Estatus, Converter={StaticResource UpperCaseConverter}}"
                                         Foreground="{Binding Source.Estatus, Converter={StaticResource StatusForegroundConverter}}"/>
                            </Border>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                    </DataGrid.Columns>
                  </DataGrid>
                  <!-- Esqueleto de carga: se muestra mientras BUSCAR esta corriendo, encima
                       de la tabla, respetando los encabezados y anchos reales de columna
                       (ver CommissionsSkeleton en el code-behind). -->
                  <Border x:Name="CommissionsSkeleton" Grid.Row="1" Background="#FFFFFF" Visibility="Collapsed">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,10">
                        <TextBlock Text="Buscando información..." FontSize="12" FontWeight="Bold" Foreground="#425A73" VerticalAlignment="Center"/>
                      </StackPanel>
                      <Grid DockPanel.Dock="Top" Height="46" Background="#F1F5FC">
                        <Grid.ColumnDefinitions>
                          <!-- Proporcionales (no pixeles fijos) para que el esqueleto se
                               adapte al ancho de la ventana igual que la tabla real. Las dos
                               primeras replican las columnas fijas Sel. y Ticket del DataGrid. -->
                          <ColumnDefinition Width="58"/><ColumnDefinition Width="180"/>
                          <ColumnDefinition Width="150*"/><ColumnDefinition Width="140*"/><ColumnDefinition Width="170*"/>
                          <ColumnDefinition Width="160*"/><ColumnDefinition Width="100*"/><ColumnDefinition Width="150*"/>
                          <ColumnDefinition Width="90*"/><ColumnDefinition Width="90*"/><ColumnDefinition Width="110*"/>
                          <ColumnDefinition Width="105*"/><ColumnDefinition Width="105*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="2" Text="FOLIOS" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="3" Text="UNIDAD" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="4" Text="NOMBRE" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="5" Text="HOTEL" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="6" Text="VNT TOTAL" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="7" Text="F.P" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="8" Text="DEJADA" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="9" Text="% COMISION" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="10" Text="PAGO COMISION" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="11" Text="EST. DEJADA" Style="{StaticResource SkeletonHeaderText}"/>
                        <TextBlock Grid.Column="12" Text="EST. COMISIÓN" Style="{StaticResource SkeletonHeaderText}"/>
                      </Grid>
                      <ItemsControl x:Name="CommissionsSkeletonRows" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Height="46">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/><ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150*"/><ColumnDefinition Width="140*"/><ColumnDefinition Width="170*"/>
                                <ColumnDefinition Width="160*"/><ColumnDefinition Width="100*"/><ColumnDefinition Width="150*"/>
                                <ColumnDefinition Width="90*"/><ColumnDefinition Width="90*"/><ColumnDefinition Width="110*"/>
                                <ColumnDefinition Width="105*"/><ColumnDefinition Width="105*"/>
                              </Grid.ColumnDefinitions>
                              <Border Grid.Column="2" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="3" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="4" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="5" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="6" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="7" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="8" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="9" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="10" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="11" Style="{StaticResource SkeletonBar}"/>
                              <Border Grid.Column="12" Style="{StaticResource SkeletonBar}"/>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </DockPanel>
                  </Border>
                  <!-- Estado vacio: se muestra cuando la busqueda ya termino y no hay
                       resultados para el filtro/rango de fechas actual, para no dejar la
                       tabla en blanco sin explicacion (ver ApplyCommissionPage). -->
                  <Border x:Name="CommissionsEmptyState" Grid.Row="1" Background="#FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                      <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSearch}" Stroke="#9DB2D4" StrokeThickness="1.4" Width="38" Height="38" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                      <TextBlock Text="Sin resultados" FontSize="15" FontWeight="Black" Foreground="#16326B" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="CommissionsEmptyStateDetail" Text="No hay comisiones para el folio o rango de fechas seleccionado." FontSize="12" Foreground="#6880A6" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>
                </Grid>
              </Border>
              </Grid>
              <!-- Paginador: resumen a la izquierda, controles de pagina a la derecha. Los
                   botones se deshabilitan solos en la primera y ultima pagina (ver
                   ApplyCommissionPage) y en ese estado se ven atenuados. -->
              <Border Grid.Row="4" Style="{StaticResource SquarePagerBar}">
                <DockPanel LastChildFill="False">
                  <TextBlock x:Name="CommissionSelectionFooterText" DockPanel.Dock="Left" Text="Seleccionado $0.00" Style="{StaticResource SquarePagerSummary}"/>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CommissionPrevPageButton" Style="{StaticResource SquarePagerButton}" Click="CommissionPrevPage_Click">
                      <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconChevronLeft}" Stroke="#41567C" Width="11" Height="11" Margin="0,0,7,0"/>
                        <TextBlock Text="ANTERIOR" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Button>
                    <Border Style="{StaticResource SquarePagerIndicator}">
                      <TextBlock x:Name="CommissionPageText" Text="PAGINA 1 DE 1" Style="{StaticResource SquarePagerIndicatorText}"/>
                    </Border>
                    <Button x:Name="CommissionNextPageButton" Style="{StaticResource SquarePagerButton}" Click="CommissionNextPage_Click">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="SIGUIENTE" VerticalAlignment="Center"/>
                        <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconChevronRight}" Stroke="#41567C" Width="11" Height="11" Margin="7,0,0,0"/>
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </DockPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Cortes">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource FormPanel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="FECHA DE CORTE" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <DatePicker x:Name="CutDate" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="CONTADO" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="CutCounted" Height="34" Margin="0,6,0,0" Text="0"/>
                  </StackPanel>
                  <Button Grid.Column="2" Content="BUSCAR" Width="110" Height="34" Margin="0,18,0,0" Style="{StaticResource WebActionButton}" Click="RefreshCuts_Click"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="0,0,0,10" Padding="12">
                <UniformGrid Columns="4">
                  <StackPanel Margin="6"><TextBlock Text="FECHA DE CORTE" FontSize="10" FontWeight="Black"/><TextBlock x:Name="CutSummaryDateText" Text="-" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="6"><TextBlock Text="MOVIMIENTOS" FontSize="10" FontWeight="Black"/><TextBlock x:Name="CutSummaryMovementsText" Text="0" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="6"><TextBlock Text="ESTATUS" FontSize="10" FontWeight="Black"/><TextBlock x:Name="CutSummaryStatusText" Text="ABIERTO" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="6"><TextBlock Text="TOTAL COBRADO" FontSize="10" FontWeight="Black"/><TextBlock x:Name="CutSummaryCollectedText" Text="$0.00" FontSize="18" FontWeight="Black" Foreground="#0F8F83"/></StackPanel>
                </UniformGrid>
              </Border>
              <Border Grid.Row="2" Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="0,0,0,10" Padding="12">
                <UniformGrid Columns="7">
                  <StackPanel Margin="6"><TextBlock Text="EFECTIVO" FontSize="10" FontWeight="Black"/><TextBlock x:Name="CutCashText" Text="$0.00" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="6"><TextBlock Text="TARJETA" FontSize="10" FontWeight="Black"/><TextBlock x:Name="CutCardText" Text="$0.00" FontSize="18" FontWeight="Black"/></StackPanel>
