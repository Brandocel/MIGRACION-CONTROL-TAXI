                        <DataGridTextColumn Header="Dejada" Binding="{Binding Dejada, StringFormat=C2}" MinWidth="100" Width="100"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" MinWidth="110" Width="110"/>
                        <DataGridTextColumn Header="Comision" Binding="{Binding Comision, StringFormat=C2}" MinWidth="110" Width="110"/>
                        <DataGridTextColumn Header="Pago" Binding="{Binding Pago, StringFormat=C2}" MinWidth="110" Width="110"/>
                        <DataGridTextColumn Header="Estatus" Binding="{Binding Estatus}" MinWidth="120" Width="120"/>
                        <DataGridTextColumn Header="Usuario pago" Binding="{Binding UsuarioPago}" MinWidth="130" Width="140"/>
                        <DataGridTextColumn Header="Ticket pago" Binding="{Binding TicketPago}" MinWidth="160" Width="180"/>
                        <DataGridTextColumn Header="Sitio" Binding="{Binding Sitio}" MinWidth="130" Width="140"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </Grid>
                </Grid>
              </Border>
              <WrapPanel Grid.Row="1" Margin="0,0,0,10">
