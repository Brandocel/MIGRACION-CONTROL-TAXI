<Window x:Class="ControlTaxiDesktop.PosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Taxi Â· POS local"
        Width="1280"
        Height="760"
        MinWidth="920"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="#DDECF7">
  <Window.Resources>
    <Style x:Key="FormPanel" TargetType="Border">
      <Setter Property="Background" Value="#F8FCFF"/>
      <Setter Property="BorderBrush" Value="#B6C8DA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="ExtraBold"/>
      <Setter Property="Foreground" Value="#425A73"/>
      <Setter Property="Margin" Value="0,8,0,8"/>
    </Style>
    <Style x:Key="HiddenWebTabItem" TargetType="{x:Type TabItem}">
      <Setter Property="Height" Value="0"/>
      <Setter Property="Width" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Opacity" Value="0"/>
    </Style>
    <Style x:Key="ReportToolbarButton" TargetType="Button">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="BorderBrush" Value="#C4D0DE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#4D6074"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ReportToolbarAccentButton" BasedOn="{StaticResource ReportToolbarButton}" TargetType="Button">
      <Setter Property="BorderBrush" Value="#E7C88A"/>
      <Setter Property="Background" Value="#FFF8E8"/>
      <Setter Property="Foreground" Value="#7B5314"/>
    </Style>
    <Style x:Key="ReportTabItemStyle" TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="#31506C"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#B6C8DA"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="0,0,8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type TabItem}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" ContentSource="Header" Margin="{TemplateBinding Padding}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#0F988F"/>
          <Setter Property="Foreground" Value="White"/>
          <Setter Property="BorderBrush" Value="#0F988F"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ReportCardButton" TargetType="Button">
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="BorderBrush" Value="#D7E2EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="White"/>
    </Style>
    <Style x:Key="DashboardPanelCard" TargetType="Border">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7E2F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22"/>
      <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>
    <Style x:Key="DashboardHeroCard" TargetType="Border" BasedOn="{StaticResource DashboardPanelCard}">
      <Setter Property="Padding" Value="16"/>
      <Setter Property="CornerRadius" Value="22"/>
      <Setter Property="BorderBrush" Value="#0B3D9B"/>
      <Setter Property="Background">
        <Setter.Value>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0A3D99" Offset="0"/>
            <GradientStop Color="#1855CB" Offset="0.56"/>
            <GradientStop Color="#0B3C99" Offset="1"/>
          </LinearGradientBrush>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DashboardActionButtonBase" TargetType="Button">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="#0F3E95"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#D7E2F2"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="4,4,0,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="108"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14"
                    TextElement.Foreground="{TemplateBinding Foreground}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DashboardPrimaryButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#1347B8"/>
      <Setter Property="BorderBrush" Value="#0D368A"/>
    </Style>
    <Style x:Key="DashboardSuccessButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#17A65A"/>
      <Setter Property="BorderBrush" Value="#118349"/>
    </Style>
    <Style x:Key="DashboardGoldButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="#C77C00"/>
      <Setter Property="Background" Value="#FFF8E5"/>
      <Setter Property="BorderBrush" Value="#F2C766"/>
    </Style>
    <Style x:Key="DashboardDangerButton" TargetType="Button" BasedOn="{StaticResource DashboardActionButtonBase}">
      <Setter Property="Foreground" Value="#D62828"/>
      <Setter Property="Background" Value="#FFF6F6"/>
      <Setter Property="BorderBrush" Value="#F0B5B5"/>
    </Style>
    <Style x:Key="DashboardGridHeader" TargetType="DataGridColumnHeader">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Background" Value="#0E4DB7"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="12,11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#1C63D2"/>
      <Setter Property="BorderThickness" Value="0,0,1,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"
                                TextElement.Foreground="White">
                <ContentPresenter.Resources>
                  <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                  </Style>
                </ContentPresenter.Resources>
              </ContentPresenter>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DashboardGridCell" TargetType="DataGridCell">
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="BorderBrush" Value="#E3ECF8"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#16326B"/>
    </Style>
    <Style x:Key="DashboardGridRow" TargetType="DataGridRow">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#16326B"/>
      <Setter Property="BorderBrush" Value="#E3ECF8"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers>
        <Trigger Property="AlternationIndex" Value="1">
          <Setter Property="Background" Value="#F9FBFF"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EEF5FF"/>
        </Trigger>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#E6F0FF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border Margin="18" Background="#E6F3FC" BorderBrush="#9DB8D3" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Border Background="#FAF8F8" BorderBrush="#B6C8DA" BorderThickness="0,0,0,1">
        <TextBlock x:Name="TitleBarText" Text="VENTAS" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#304A65"/>
      </Border>

      <TabControl x:Name="PosTabs" Grid.Row="1" Margin="10" ItemContainerStyle="{StaticResource HiddenWebTabItem}">
        <TabItem Header="Ventas">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10" MinWidth="1120">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border Style="{StaticResource FormPanel}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="BUSCAR PRODUCTO / FOLIO / NOMBRE / HOTEL / GAFETE" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="SaleFolio" Height="34" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="CLIENTE" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="SaleCustomer" Height="34" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="REFERENCIA" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductCode" Height="34" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <Button Grid.Column="3" Content="BUSCAR" Width="110" Height="34" Margin="10,20,8,0" Style="{StaticResource WebActionButton}" Click="RefreshSales_Click"/>
                  <Button Grid.Column="4" Content="LIMPIAR" Width="110" Height="34" Margin="0,20,0,0" Style="{StaticResource WebActionButton}" Click="ClearSalesSearch_Click"/>
                </Grid>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource FormPanel}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="4">
                    <TextBlock Text="CLIENTE / PRODUCTO" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductName" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="SUBTOTAL" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductPrice" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Margin="4">
                    <TextBlock Text="IVA" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductTax" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Margin="4">
                    <TextBlock Text="TOTAL" FontSize="10" FontWeight="Black" Foreground="#425A73"/>
                    <TextBox x:Name="ProductStock" Height="32" Margin="0,6,0,0" IsReadOnly="True"/>
                  </StackPanel>
                </Grid>
              </Border>
              <Border Grid.Row="2" Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="0,0,0,10">
                <UniformGrid Columns="6">
                  <StackPanel Margin="8"><TextBlock Text="FECHA" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleDateText" Text="HOY" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="SUBTOTAL" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleSubtotalText" Text="0.00" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="IVA" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleTaxText" Text="0.00" FontSize="18" FontWeight="Black"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="TOTAL" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleTotalText" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#0F8F83"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="DEJADA" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SalePayoutText" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#1F5784"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="COMISION" FontSize="10" FontWeight="Black"/><TextBlock x:Name="SaleCommissionText" Text="0.00" FontSize="18" FontWeight="Black" Foreground="#B06B00"/></StackPanel>
                </UniformGrid>
              </Border>
              <Grid Grid.Row="3">
                <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*"/><ColumnDefinition Width="1.58*"/></Grid.ColumnDefinitions>
                <Border Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="0,0,6,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TICKET ACTUAL / VENTA SELECCIONADA" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="ProductsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Cant." Binding="{Binding Cantidad}" Width="58"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Producto}" Width="220"/>
                        <DataGridTextColumn Header="Departamento" Binding="{Binding Departamento}" Width="150"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Precio, StringFormat=C2}" Width="90"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding Importe, StringFormat=C2}" Width="95"/>
                        <DataGridTextColumn Header="Referencia" Binding="{Binding Referencia}" Width="130"/>
                        <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" Width="110"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding FechaVenta}" Width="135"/>
                        <DataGridTextColumn Header="Origen" Binding="{Binding OrigenVenta}" Width="80"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
                <Border Grid.Column="1" Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="6,0,0,0">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="RESULTADOS DE CONSULTA / VENTAS" Style="{StaticResource SectionTitle}"/>
                    <DataGrid x:Name="SalesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionChanged="SalesGrid_SelectionChanged" MouseDoubleClick="OpenRemissionDetail_Click">
                      <DataGrid.Columns>
                        <DataGridTextColumn Header="Ticket" Binding="{Binding Folio}" Width="135"/>
                        <DataGridTextColumn Header="Factura" Binding="{Binding Factura}" Width="95"/>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy HH:mm}" Width="135"/>
                        <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="150"/>
                        <DataGridTextColumn Header="Vendedor" Binding="{Binding Vendedor}" Width="170"/>
                        <DataGridTextColumn Header="Taxista" Binding="{Binding Taxista}" Width="170"/>
                        <DataGridTextColumn Header="Folio Reg." Binding="{Binding FolioRegistro}" Width="90"/>
                        <DataGridTextColumn Header="Gafete" Binding="{Binding Gafete}" Width="80"/>
                        <DataGridTextColumn Header="Transporte" Binding="{Binding Transporte}" Width="110"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="95"/>
                        <DataGridTextColumn Header="IVA" Binding="{Binding Iva, StringFormat=C2}" Width="85"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="95"/>
                        <DataGridTextColumn Header="Pagos encontrados" Binding="{Binding TotalPagos, StringFormat=C2}" Width="130"/>
                        <DataGridTextColumn Header="Diferencia pago" Binding="{Binding DiferenciaPago, StringFormat=C2}" Width="120"/>
                        <DataGridTextColumn Header="Forma pago" Binding="{Binding FormaPagoDetalle}" Width="190"/>
                        <DataGridTextColumn Header="Moneda" Binding="{Binding MonedaDetalle}" Width="110"/>
                        <DataGridTextColumn Header="Origen" Binding="{Binding OrigenVenta}" Width="75"/>
                      </DataGrid.Columns>
                    </DataGrid>
                  </DockPanel>
                </Border>
              </Grid>
            </Grid>
            <StackPanel Grid.Column="1" Style="{StaticResource WebActionSidebar}">
              <Button Content="BORRA LINEA" Style="{StaticResource WebActionRedButton}" Click="DeleteLinePending_Click"/>
              <Button Content="NUEVO" Style="{StaticResource WebActionGoldButton}" Click="NewSale_Click"/>
              <Button Content="COBRAR" Style="{StaticResource WebActionGreenButton}" Click="CreateSale_Click"/>
              <Button Content="CONSULTA PRECIOS" Style="{StaticResource WebActionButton}" Click="RefreshSales_Click"/>
              <Button Content="CORTE" Style="{StaticResource WebActionGoldButton}" Click="OpenCuts_Click"/>
              <Button Content="GASTOS" Style="{StaticResource WebActionButton}" Click="OpenExpenses_Click"/>
              <Button Content="TICKETS" Style="{StaticResource WebActionButton}" Click="OpenTickets_Click"/>
              <Button Content="EXCEL" Style="{StaticResource WebActionButton}" Click="ExportSalesExcel_Click"/>
              <Button Content="PDF" Style="{StaticResource WebActionButton}" Click="ExportSalesPdf_Click"/>
              <Button Content="MENU" Style="{StaticResource WebActionButton}" Click="CloseWindow_Click"/>
              <Button Content="SALIR" Style="{StaticResource WebActionRedButton}" Click="CloseWindow_Click"/>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Pagos">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10" MinWidth="1180">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource FormPanel}">
                <WrapPanel>
                  <TextBox x:Name="PaymentSaleFolio" Width="150" ToolTip="Folio venta"/>
                  <TextBox x:Name="PaymentAmount" Width="100" Text="0"/>
                  <ComboBox x:Name="PaymentMethod" Width="120" SelectedIndex="0"><ComboBoxItem Content="Efectivo"/><ComboBoxItem Content="Tarjeta"/></ComboBox>
                  <TextBox x:Name="PaymentNotes" Width="340" ToolTip="Notas"/>
                </WrapPanel>
              </Border>
              <DataGrid x:Name="PaymentsGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="True"/>
            </Grid>
            <StackPanel Grid.Column="1" Style="{StaticResource WebActionSidebar}">
              <Button Content="REGISTRAR PAGO" Style="{StaticResource WebActionSaveButton}" Click="RegisterPayment_Click"/>
              <Button Content="CSV" Style="{StaticResource WebActionGreenButton}" Click="ExportPaymentsCsv_Click"/>
              <Button Content="PDF" Style="{StaticResource WebActionButton}" Click="ExportPaymentsPdf_Click"/>
              <Button Content="MENU" Style="{StaticResource WebActionButton}" Click="CloseWindow_Click"/>
              <Button Content="SALIR" Style="{StaticResource WebActionRedButton}" Click="CloseWindow_Click"/>
            </StackPanel>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem Header="Comisiones">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
          <Grid Margin="10" MinWidth="1520">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Style="{StaticResource DashboardHeroCard}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,12">
                    <Border Width="62" Height="62" CornerRadius="15" Background="#1747A9" BorderBrush="#81B5FF" BorderThickness="1.2" Margin="0,0,14,0">
                      <Viewbox Margin="12">
                        <TextBlock Text="💰" Foreground="White"/>
                      </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="COMISIONES" FontSize="18" FontWeight="Black" Foreground="White"/>
                      <TextBlock Text="Control de comisiones, pagos y selección de folios con el mismo estilo visual" FontSize="12" Foreground="#D3E2FF" Margin="0,4,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <WrapPanel Grid.Row="1">
                    <Button Content="CALCULAR" Style="{StaticResource DashboardGoldButton}" Click="RecalculateCommissions_Click"/>
                    <Button Content="PAGAR" Style="{StaticResource DashboardSuccessButton}" Click="PaySelectedCommissions_Click"/>
                    <Button Content="BUSCAR" Style="{StaticResource DashboardPrimaryButton}" Click="SearchCommissions_Click"/>
                    <Button Content="CSV" Style="{StaticResource DashboardActionButtonBase}" Click="ExportCommissionsCsv_Click"/>
                    <Button Content="PDF" Style="{StaticResource DashboardActionButtonBase}" Click="ExportCommissionsPdf_Click"/>
                    <Button Content="IMPRIMIR" Style="{StaticResource DashboardActionButtonBase}" Click="PrintCommissions_Click"/>
                    <Button Content="MENU" Style="{StaticResource DashboardActionButtonBase}" Click="CloseWindow_Click"/>
                    <Button Content="SALIR" Style="{StaticResource DashboardDangerButton}" Click="CloseWindow_Click"/>
                  </WrapPanel>
                </Grid>
              </Border>
              <Border Grid.Row="1" Style="{StaticResource DashboardPanelCard}">
                <WrapPanel>
                  <StackPanel Width="260" Margin="0,0,18,0">
                    <TextBlock Text="Folio comision" FontSize="12" FontWeight="Bold" Foreground="#16326B" Margin="0,0,0,8"/>
                    <Border Background="#FFFFFF" BorderBrush="#CAD8EE" BorderThickness="1" CornerRadius="12">
                      <TextBox x:Name="CommissionFolio" Width="160" ToolTip="Folio comision" Background="Transparent" BorderThickness="0" Padding="14,12"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Width="220" Margin="0,0,18,0">
                    <TextBlock Text="Fecha inicio" FontSize="12" FontWeight="Bold" Foreground="#16326B" Margin="0,0,0,8"/>
                    <Border Background="#FFFFFF" BorderBrush="#CAD8EE" BorderThickness="1" CornerRadius="12">
                      <DatePicker x:Name="CommissionStartDate" Width="140" BorderThickness="0" Padding="12,10"/>
                    </Border>
                  </StackPanel>
                  <StackPanel Width="220">
                    <TextBlock Text="Fecha fin" FontSize="12" FontWeight="Bold" Foreground="#16326B" Margin="0,0,0,8"/>
                    <Border Background="#FFFFFF" BorderBrush="#CAD8EE" BorderThickness="1" CornerRadius="12">
                      <DatePicker x:Name="CommissionEndDate" Width="140" BorderThickness="0" Padding="12,10"/>
                    </Border>
                  </StackPanel>
                </WrapPanel>
              </Border>
              <Border Grid.Row="2" Style="{StaticResource DashboardPanelCard}">
                <UniformGrid Columns="7">
                  <StackPanel Margin="8"><TextBlock Text="VENTA" FontSize="10" FontWeight="Black" Foreground="#526A83"/><TextBlock x:Name="CommissionTotalSaleText" Text="$0.00" FontSize="18" FontWeight="Black" Foreground="#123E6E"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="BASE" FontSize="10" FontWeight="Black" Foreground="#526A83"/><TextBlock x:Name="CommissionTotalBaseText" Text="$0.00" FontSize="18" FontWeight="Black" Foreground="#123E6E"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="COMISION" FontSize="10" FontWeight="Black" Foreground="#526A83"/><TextBlock x:Name="CommissionTotalAmountText" Text="$0.00" FontSize="18" FontWeight="Black" Foreground="#0F8F83"/></StackPanel>
                  <StackPanel Margin="8"><TextBlock Text="PAGADO" FontSize="10" FontWeight="Black" Foreground="#526A83"/><TextBlock x:Name="CommissionTotalPaidText" Text="$0.00" FontSize="18" FontWeight="Black" Foreground="#123E6E"/></StackPanel>
