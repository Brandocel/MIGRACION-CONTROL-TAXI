<Window x:Class="ControlTaxiDesktop.RemissionDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DETALLE DE REMISION"
        Width="1120"
        Height="700"
        WindowStartupLocation="CenterOwner"
        Background="#DDECF7">
  <Border Margin="18" Background="#E6F3FC" BorderBrush="#9DB8D3" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Background="#FAF8F8" BorderBrush="#B6C8DA" BorderThickness="0,0,0,1">
        <TextBlock Text="DETALLE DE REMISION" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Foreground="#304A65"/>
      </Border>
      <Grid Grid.Row="1" Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
        <ScrollViewer>
          <StackPanel>
            <Border Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Padding="10" Margin="0,0,0,10">
              <UniformGrid Columns="4">
                <StackPanel Margin="4"><TextBlock Text="REMISION" FontWeight="Black" FontSize="10"/><TextBox x:Name="RemisionText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="FOLIO REGISTRO" FontWeight="Black" FontSize="10"/><TextBox x:Name="RegistroText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="FACTURA" FontWeight="Black" FontSize="10"/><TextBox x:Name="FacturaText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="ORIGEN" FontWeight="Black" FontSize="10"/><TextBox x:Name="OrigenText" Text="SQLite local" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="CLIENTE" FontWeight="Black" FontSize="10"/><TextBox x:Name="ClienteText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="USUARIO" FontWeight="Black" FontSize="10"/><TextBox x:Name="UsuarioText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="TAXISTA" FontWeight="Black" FontSize="10"/><TextBox x:Name="TaxistaText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="TAXISTA ID" FontWeight="Black" FontSize="10"/><TextBox x:Name="TaxistaIdText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="TRANSPORTE" FontWeight="Black" FontSize="10"/><TextBox x:Name="TransporteText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="FOLIO APP" FontWeight="Black" FontSize="10"/><TextBox x:Name="FolioAppText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="FOLIO CONTROL" FontWeight="Black" FontSize="10"/><TextBox x:Name="ControlText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="GAFETES ACTIVOS" FontWeight="Black" FontSize="10"/><TextBox x:Name="GafetesText" Text="SIN GAFETES ACTIVOS" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="HOTEL" FontWeight="Black" FontSize="10"/><TextBox x:Name="HotelText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="FORMA DE PAGO" FontWeight="Black" FontSize="10"/><TextBox x:Name="FormaPagoText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="COMISION" FontWeight="Black" FontSize="10"/><TextBox x:Name="ComisionText" IsReadOnly="True"/></StackPanel>
                <StackPanel Margin="4"><TextBlock Text="VENTA" FontWeight="Black" FontSize="10"/><TextBox x:Name="VentaText" IsReadOnly="True"/></StackPanel>
              </UniformGrid>
            </Border>
            <Border Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1" Margin="0,0,0,10">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="IMPORTES" HorizontalAlignment="Center" FontSize="11" FontWeight="Black" Foreground="#425A73" Margin="0,8,0,8"/>
                <DataGrid x:Name="AmountsGrid" IsReadOnly="True" AutoGenerateColumns="False" Height="90">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="120"/>
                    <DataGridTextColumn Header="IVA" Binding="{Binding Tax, StringFormat=C2}" Width="120"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C2}" Width="120"/>
                    <DataGridTextColumn Header="Efectivo" Binding="{Binding Paid, StringFormat=C2}" Width="120"/>
                    <DataGridTextColumn Header="Tarjeta" Binding="{Binding PaymentStatus}" Width="120"/>
                    <DataGridTextColumn Header="Dolares" Binding="{Binding Status}" Width="120"/>
                    <DataGridTextColumn Header="Tipo cambio" Binding="{Binding User}" Width="120"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
            <Border Background="#F8FCFF" BorderBrush="#B6C8DA" BorderThickness="1">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="VENTAS / REMISIONES RELACIONADAS" HorizontalAlignment="Center" FontSize="11" FontWeight="Black" Foreground="#425A73" Margin="0,8,0,8"/>
                <DataGrid x:Name="LinesGrid" IsReadOnly="True" AutoGenerateColumns="False" Height="250">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Origen" Binding="{Binding ProductCode}" Width="120"/>
                    <DataGridTextColumn Header="Referencia" Binding="{Binding SaleId}" Width="120"/>
                    <DataGridTextColumn Header="Factura" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Fecha" Binding="{Binding ProductId}" Width="100"/>
                    <DataGridTextColumn Header="Venta" Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="Gafetes" Binding="{Binding ProductCode}" Width="120"/>
                    <DataGridTextColumn Header="Importe" Binding="{Binding Total, StringFormat=C2}" Width="120"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Column="1" Style="{StaticResource WebActionSidebar}">
          <Button Content="VOLVER VENTA" Style="{StaticResource WebActionButton}" Click="Close_Click"/>
          <Button Content="VER PRODUCTOS" Style="{StaticResource WebActionButton}" Click="Products_Click"/>
          <Button Content="RELACION" Style="{StaticResource WebActionButton}" Click="Relation_Click"/>
          <Button Content="COMISION" Style="{StaticResource WebActionGoldButton}" Click="Commission_Click"/>
          <Button Content="REGISTRO" Style="{StaticResource WebActionButton}" Click="Register_Click"/>
          <Button Content="MENU" Style="{StaticResource WebActionButton}" Click="Close_Click"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
