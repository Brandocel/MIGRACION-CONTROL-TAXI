<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Estilos compartidos del rediseño "cuadrado" (sin esquinas redondeadas, iconos de
    linea, botones oscuros) que cualquier ventana puede referenciar sin repetir el XAML.
    Se aplico primero en PosWindow (pantalla de Comisiones) el 2026-08-20; el objetivo es
    que las siguientes pantallas que se rediseñen (Relaciones, Configuracion de Comisiones,
    etc.) usen este mismo diccionario en vez de copiar y pegar los estilos otra vez.

    Como usarlo desde otra ventana:
      <Window.Resources>
        <ResourceDictionary>
          <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Styles/SharedFilterStyles.xaml"/>
          </ResourceDictionary.MergedDictionaries>
          ... tus otros estilos locales ...
        </ResourceDictionary>
      </Window.Resources>
  -->

  <!-- ===== Iconos de linea (estilo lucide, como el admin web) =====
       Se dibujan con Path en vez de emoji: se ven iguales en cualquier equipo, toman el
       color que se les de y escalan sin pixelearse. Uso:
         <Path Style="{StaticResource LineIcon}" Data="{StaticResource IconSearch}" Stroke="White"/> -->
  <Geometry x:Key="IconSearch">M19,11 A8,8 0 1 1 3,11 A8,8 0 1 1 19,11 M21,21 L16.65,16.65</Geometry>
  <Geometry x:Key="IconFilter">M21,4 H14 M10,4 H3 M21,12 H12 M8,12 H3 M21,20 H16 M12,20 H3 M14,2 V6 M8,10 V14 M16,18 V22</Geometry>
  <Geometry x:Key="IconBanknote">M2,6 H22 V18 H2 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 M6,12 H6.01 M18,12 H18.01</Geometry>
  <Geometry x:Key="IconChevronLeft">M15,18 L9,12 L15,6</Geometry>
  <Geometry x:Key="IconChevronRight">M9,18 L15,12 L9,6</Geometry>
  <!-- Iconos usados por Relacion Ticket-Taxista. Reemplazan a los emoji (🎫 📱 📄 🧾 🪪 ...)
       que en varios equipos se dibujan como cuadros vacios porque falta la fuente. -->
  <Geometry x:Key="IconCar">M5,17 A2,2 0 1 0 9,17 A2,2 0 1 0 5,17 M15,17 A2,2 0 1 0 19,17 A2,2 0 1 0 15,17 M5,17 H3 V12 L5.5,6 H18.5 L21,12 V17 H19 M9,17 H15 M3,12 H21</Geometry>
  <Geometry x:Key="IconTicket">M3,8 V6 H21 V8 A2,2 0 0 0 21,16 V18 H3 V16 A2,2 0 0 0 3,8 M9,6 V18</Geometry>
  <Geometry x:Key="IconPhone">M7,2 H17 V22 H7 Z M10,18.5 H14</Geometry>
  <Geometry x:Key="IconFile">M6,2 H14 L19,7 V22 H6 Z M14,2 V7 H19 M9,12 H16 M9,16 H16</Geometry>
  <Geometry x:Key="IconReceipt">M5,2 H19 V22 L16.5,20 L14,22 L12,20 L10,22 L7.5,20 L5,22 Z M9,8 H15 M9,12 H15</Geometry>
  <Geometry x:Key="IconBadge">M4,4 H20 V20 H4 Z M12,10 A2,2 0 1 1 12,9.99 M8,16 C8,14 10,13 12,13 C14,13 16,14 16,16</Geometry>
  <Geometry x:Key="IconRefresh">M21,12 A9,9 0 1 1 18,5.3 M21,3 V9 H15</Geometry>
  <Geometry x:Key="IconEraser">M3,17 L9,17 M6,20 L20,6 L17,3 L3,17 L6,20 Z</Geometry>
  <Geometry x:Key="IconFilePlus">M6,2 H14 L19,7 V22 H6 Z M14,2 V7 H19 M12,11 V17 M9,14 H15</Geometry>
  <Geometry x:Key="IconMenu">M3,6 H21 M3,12 H21 M3,18 H21</Geometry>
  <Geometry x:Key="IconPower">M12,3 V12 M18.4,6.6 A9,9 0 1 1 5.6,6.6</Geometry>
  <Geometry x:Key="IconDollar">M12,2 V22 M16.5,6.5 C16.5,5 14.5,4 12,4 C9.5,4 7.5,5.2 7.5,7.4 C7.5,12 16.5,10 16.5,15.4 C16.5,18 14,20 12,20 C9,20 7,18.5 7,17</Geometry>
  <Geometry x:Key="IconUser">M12,11 A4,4 0 1 1 12,10.99 M4,21 C4,17 7.5,15 12,15 C16.5,15 20,17 20,21</Geometry>

  <Style x:Key="LineIcon" TargetType="Path">
    <Setter Property="Fill" Value="Transparent"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Width" Value="15"/>
    <Setter Property="Height" Value="15"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== Encabezado de modulo =====
       Barra cuadrada y compacta: a la izquierda el icono + titulo, a la derecha las acciones.
       Antes era una tarjeta alta con esquinas de radio 22 y botones tipo pildora. -->
  <Style x:Key="SquareHeaderCard" TargetType="Border">
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="18,14"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#0A3D99" Offset="0"/>
          <GradientStop Color="#1855CB" Offset="0.56"/>
          <GradientStop Color="#0B3C99" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SquareHeaderIconTile" TargetType="Border">
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Background" Value="#1D5BD6"/>
    <Setter Property="BorderBrush" Value="#6FA3F5"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Margin" Value="0,0,13,0"/>
  </Style>

  <!-- Botones de la barra de acciones del encabezado: cuadrados y mas bajos que los de antes. -->
  <Style x:Key="SquareToolbarButton" TargetType="Button">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="#0F3E95"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#FFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="6,3,0,3"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinWidth" Value="86"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  TextElement.Foreground="{TemplateBinding Foreground}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.86"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Variante translucida para acciones secundarias sobre el fondo azul del encabezado. -->
  <Style x:Key="SquareToolbarGhostButton" TargetType="Button" BasedOn="{StaticResource SquareToolbarButton}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="#1B57C4"/>
    <Setter Property="BorderBrush" Value="#5C93EE"/>
  </Style>
  <Style x:Key="SquareToolbarSuccessButton" TargetType="Button" BasedOn="{StaticResource SquareToolbarButton}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="#17A65A"/>
    <Setter Property="BorderBrush" Value="#17A65A"/>
  </Style>
  <Style x:Key="SquareToolbarGoldButton" TargetType="Button" BasedOn="{StaticResource SquareToolbarButton}">
    <Setter Property="Foreground" Value="#8A5600"/>
    <Setter Property="Background" Value="#FFC94D"/>
    <Setter Property="BorderBrush" Value="#FFC94D"/>
  </Style>
  <Style x:Key="SquareToolbarDangerButton" TargetType="Button" BasedOn="{StaticResource SquareToolbarButton}">
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="Background" Value="#D64545"/>
    <Setter Property="BorderBrush" Value="#D64545"/>
  </Style>

  <!-- Campo de texto/fecha de un panel de filtros: etiqueta chica en mayusculas arriba,
       borde cuadrado (radio 6) abajo. -->
  <Style x:Key="SquareFieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="#5A7096"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="SquareFieldBorder" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#D3DCEC"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="2"/>
  </Style>

  <!-- ===== Tira de totales / KPIs =====
       Tarjeta cuadrada dividida en celdas con separador vertical. Cada celda lleva una franja
       de color arriba para identificar la metrica sin leer la etiqueta. -->
  <Style x:Key="SquareStatCard" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#D7E2F2"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>
  <Style x:Key="SquareStatCell" TargetType="Border">
    <Setter Property="BorderBrush" Value="#EBF1FA"/>
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
    <Setter Property="Padding" Value="16,13"/>
  </Style>
  <Style x:Key="SquareStatAccent" TargetType="Border">
    <Setter Property="Width" Value="22"/>
    <Setter Property="Height" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="0,0,0,8"/>
  </Style>
  <Style x:Key="SquareStatLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="#6B7FA6"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="SquareStatValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="19"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="#123E6E"/>
    <Setter Property="Margin" Value="0,3,0,0"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>

  <!-- Tarjeta contenedora de un panel de filtros: cuadrada, para que empate con el encabezado. -->
  <Style x:Key="SquareFilterCard" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#D7E2F2"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="18"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
  </Style>

  <!-- TextBox/DatePicker sin marco propio, para meter dentro de SquareFieldBorder. -->
  <Style x:Key="DashboardTextInput" TargetType="TextBox">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="#132C63"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
  </Style>
  <Style x:Key="DashboardDateInput" TargetType="DatePicker">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Foreground" Value="#132C63"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="12,10"/>
    <Setter Property="MinWidth" Value="150"/>
  </Style>

  <!-- Boton primario oscuro y cuadrado, tipo "APLICAR FILTROS". -->
  <Style x:Key="SquarePrimaryButton" TargetType="Button">
    <Setter Property="Background" Value="#0F1B33"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- TextElement.Foreground explicito: sin el, el texto del boton toma el color
               oscuro del estilo global de TextBlock y "GUARDAR CAMBIO" salia gris sobre el
               fondo azul marino. -->
          <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}"
                  TextElement.Foreground="{TemplateBinding Foreground}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}">
              <!-- El estilo global de TextBlock (App.xaml) fija un gris oscuro y gana sobre la
                   herencia, asi que el texto del boton se pinta aqui explicitamente. -->
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#1B2C4F"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Accion secundaria junto al boton primario (p.ej. "LIMPIAR"): mismo alto, sin relleno. -->
  <Style x:Key="SquareSecondaryButton" TargetType="Button">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="Foreground" Value="#41567C"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="18,11"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#D3DCEC"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3" Padding="{TemplateBinding Padding}"
                  TextElement.Foreground="{TemplateBinding Foreground}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}">
              <!-- El estilo global de TextBlock (App.xaml) fija un gris oscuro y gana sobre la
                   herencia, asi que el texto del boton se pinta aqui explicitamente. -->
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#F1F5FC"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Badge de estatus =====
       Chip cuadrado para estados (PAGADO, PENDIENTE, SIN CALCULAR, APP MOVIL...). Los colores
       se siguen resolviendo por binding/converter en cada pantalla; esto homologa solo la
       forma, el tamaño y la tipografia para que todos los estados se vean iguales. -->
  <Style x:Key="SquareStatusBadge" TargetType="Border">
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <!-- Center, no Stretch: un Border crece a lo alto de su celda por defecto y el chip
         terminaba siendo un bloque de color en vez de una etiqueta. -->
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SquareStatusBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>

  <!-- ===== Pestañas de panel =====
       Tabs planos con subrayado, como los del admin web. Son RadioButton para que el propio
       GroupName garantice que solo una quede activa, sin codigo que las sincronice. -->
  <Style x:Key="SquareTabRadio" TargetType="RadioButton">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="#6B7FA6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="2,10"/>
    <Setter Property="Margin" Value="0,0,20,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Underline" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Underline" Property="BorderBrush" Value="#1E5FD0"/>
              <Setter Property="Foreground" Value="#16326B"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsChecked" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="#41567C"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Paginador =====
       Barra inferior de una tabla: resumen a la izquierda, controles de pagina a la derecha. -->
  <Style x:Key="SquarePagerBar" TargetType="Border">
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#D7E2F2"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="16,10"/>
    <Setter Property="Margin" Value="0,14,0,0"/>
  </Style>
  <Style x:Key="SquarePagerButton" TargetType="Button" BasedOn="{StaticResource SquareSecondaryButton}">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Padding" Value="13,8"/>
  </Style>
  <!-- Indicador "PAGINA x DE y" entre los dos botones. -->
  <Style x:Key="SquarePagerIndicator" TargetType="Border">
    <Setter Property="Background" Value="#0F1B33"/>
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="Padding" Value="14,8"/>
    <Setter Property="Margin" Value="7,0"/>
  </Style>
  <Style x:Key="SquarePagerIndicatorText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="#FFFFFF"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SquarePagerSummary" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="#6B7FA6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Chip chico para atajos (rangos de fecha, estatus, etc.). -->
  <Style x:Key="SquareChipButton" TargetType="Button">
    <Setter Property="Background" Value="#F1F5FC"/>
    <Setter Property="Foreground" Value="#41567C"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Margin" Value="0,0,7,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <!-- Alto fijo y centrado vertical: dentro de una celda de tabla el boton se estiraba a
         todo lo alto de la fila y quedaba como un bloque de color, ademas de que unos se
         veian mas altos que otros. -->
    <Setter Property="Height" Value="28"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#DCE6F5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2" Padding="{TemplateBinding Padding}"
                  TextElement.Foreground="{TemplateBinding Foreground}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}">
              <!-- El estilo global de TextBlock (App.xaml) fija un gris oscuro y gana sobre la
                   herencia, asi que el texto del boton se pinta aqui explicitamente. -->
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#0F1B33"/>
              <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Boton tipo enlace, sin fondo, para "Ocultar/Mostrar" y acciones secundarias chicas. -->
  <Style x:Key="SquareLinkButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#0F3E95"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Texto de encabezado de columna dentro del esqueleto de carga. -->
  <Style x:Key="SkeletonHeaderText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="#5A7096"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
  </Style>

  <!-- Barra pulsante del esqueleto de carga (una por celda). Cuadrada (sin CornerRadius)
       y estirada al ancho de su columna para que el layout sea responsivo. -->
  <Style x:Key="SkeletonBar" TargetType="Border">
    <Setter Property="Height" Value="14"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Background" Value="#DCE6F5"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="10,0,10,0"/>
    <Setter Property="Opacity" Value="0.6"/>
    <Style.Triggers>
      <Trigger Property="IsVisible" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.35" To="0.85" Duration="0:0:0.8" AutoReverse="True" RepeatBehavior="Forever"/>
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Tabla del rediseño cuadrado =====
       Se movieron aqui (antes vivian solo dentro de PosWindow) para que Configuracion de
       comisiones use exactamente la misma tabla que Comisiones: encabezado azul, celdas con
       linea de columna y fila, y gris alterno visible. PosWindow conserva su copia local,
       que gana sobre esta por ser recurso propio de la ventana. -->
  <Style x:Key="DashboardGridHeader" TargetType="DataGridColumnHeader">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Background" Value="#0E4DB7"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="12,11"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="#1C63D2"/>
    <Setter Property="BorderThickness" Value="0,0,1,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"
                              TextElement.Foreground="White">
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="White"/>
                  <Setter Property="FontWeight" Value="Bold"/>
                  <Setter Property="FontSize" Value="13"/>
                  <Setter Property="TextWrapping" Value="NoWrap"/>
                </Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DashboardGridCell" TargetType="DataGridCell">
    <Setter Property="Padding" Value="14,10"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="BorderBrush" Value="#DCE5F2"/>
    <Setter Property="BorderThickness" Value="0,0,1,1"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="#16326B"/>
  </Style>
  <Style x:Key="DashboardGridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="White"/>
    <Setter Property="Foreground" Value="#16326B"/>
    <Setter Property="BorderBrush" Value="#E3ECF8"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Style.Triggers>
      <Trigger Property="AlternationIndex" Value="1">
        <Setter Property="Background" Value="#EFF4FB"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="#DBE8FA"/>
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="#C7DCF7"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Entradas de formulario =====
       Caja de texto con su propio marco cuadrado, para formularios donde no conviene envolver
       cada campo en un SquareFieldBorder aparte. -->
  <Style x:Key="SquareInputBox" TargetType="TextBox">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#132C63"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#D3DCEC"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,7"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="#1E5FD0"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Background" Value="#F4F7FC"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Etiqueta chica de un campo de formulario (no de filtros). -->
  <Style x:Key="SquareInputLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="#5A7096"/>
    <Setter Property="Margin" Value="0,0,0,5"/>
  </Style>

  <!-- Titulo de bloque dentro de una tarjeta ("PORCENTAJES", "VIGENCIA"...). -->
  <Style x:Key="SquareSectionHeading" TargetType="TextBlock">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Black"/>
    <Setter Property="Foreground" Value="#16326B"/>
    <Setter Property="Margin" Value="0,14,0,10"/>
  </Style>

  <!-- ComboBox sin el cromo gris de Windows: mismo marco y alto que SquareInputBox, con
       chevron de linea. Sirve igual para combos editables (IsEditable="True"). -->
  <Style x:Key="SquareComboInput" TargetType="ComboBox">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="#132C63"/>
    <Setter Property="Background" Value="#FFFFFF"/>
    <Setter Property="BorderBrush" Value="#D3DCEC"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="9,7"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2"
                  SnapsToDevicePixels="True">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="28"/>
              </Grid.ColumnDefinitions>
              <!-- El ToggleButton invisible cubre toda la caja cuando el combo no es editable;
                   si lo es, se recorta a la columna del chevron para no robarle el clic al
                   cuadro de texto. -->
              <ToggleButton x:Name="OpenButton"
                            Grid.Column="0" Grid.ColumnSpan="2"
                            Focusable="False"
                            ClickMode="Press"
                            Background="Transparent"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" BorderThickness="0"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Selected"
                                Grid.Column="0"
                                Margin="{TemplateBinding Padding}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"/>
              <TextBox x:Name="PART_EditableTextBox"
                       Grid.Column="0"
                       Margin="{TemplateBinding Padding}"
                       Visibility="Collapsed"
                       Background="Transparent"
                       BorderThickness="0"
                       Foreground="{TemplateBinding Foreground}"
                       VerticalContentAlignment="Center"/>
              <Path x:Name="Chevron"
                    Grid.Column="1"
                    Style="{StaticResource LineIcon}"
                    Data="M6,9 L12,15 L18,9"
                    Stroke="#5A7096"
                    Width="12" Height="12"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
              <Popup x:Name="PART_Popup"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="Fade">
                <Border Background="#FFFFFF"
                        BorderBrush="#D3DCEC"
                        BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEditable" Value="True">
              <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="OpenButton" Property="Grid.Column" Value="1"/>
              <Setter TargetName="OpenButton" Property="Grid.ColumnSpan" Value="1"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#1E5FD0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="#F4F7FC"/>
              <Setter Property="Foreground" Value="#8896B0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Pestañas =====
       Mismo lenguaje que SquareTabRadio, pero para un TabControl real: la ventana de
       Configuracion navega por indice desde el codigo, asi que no puede usar RadioButtons. -->
  <Style x:Key="SquareTabItem" TargetType="TabItem">
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="#6B7FA6"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Padding" Value="2,13"/>
    <Setter Property="Margin" Value="0,0,24,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <Border x:Name="Underline"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="0,0,0,2"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Underline" Property="BorderBrush" Value="#1E5FD0"/>
              <Setter Property="Foreground" Value="#16326B"/>
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsMouseOver" Value="True"/>
                <Condition Property="IsSelected" Value="False"/>
              </MultiTrigger.Conditions>
              <Setter Property="Foreground" Value="#41567C"/>
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SquareTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource SquareTabItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- StackPanel y no TabPanel: TabPanel reparte el ancho entre las pestañas y les
                 recortaba el texto ("CATÁL...", "HISTO..."). Con StackPanel cada pestaña mide
                 lo que necesita. -->
            <Border Background="#FFFFFF" BorderBrush="#D7E2F2" BorderThickness="1" Padding="18,0">
              <StackPanel IsItemsHost="True" Orientation="Horizontal" HorizontalAlignment="Left"/>
            </Border>
            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" Margin="0,14,0,0"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
